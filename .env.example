# NoctusAI Platform — root environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Per-product `docker-compose.yml` fragments read this file via
# `env_file: - ../../.env` (see products/<slug>/docker-compose.yml).
# Also consumed by `start.sh` (native mode) and by Vite at build time
# (frontend) for any `VITE_*` variable. Secrets stay in `.env`;
# this template carries placeholders + slot docs.
#
# `.gitignore` excludes `.env` / `.env.local` / `.env.*.local` but keeps
# `.env.example` checked in deliberately — it's the contract, not the data.

# ─── Supabase (default backing store for every product) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT (auth — shared across products) ─────────────────────────────
JWT_SECRET=your-shared-jwt-secret
# SSO_JWT_SECRET — optional, core-only.  When set, SSO bridge tokens are
# signed with this secret instead of JWT_SECRET, decoupling bridge-token
# signing from per-product session signing.  A leaked product JWT_SECRET
# cannot forge SSO identities when this is configured.
# Leave unset (empty) → falls back to JWT_SECRET (zero-config back-compat).
# SSO_JWT_SECRET=

# ─── LLM (seed default-wired via create_product_app lifespan) ────────
# Either ANTHROPIC_API_KEY or OPENAI_API_KEY is enough for the seed's
# default LLM config to come up. Both unset → LLM-dependent endpoints
# surface a clear error at request time; non-LLM endpoints work unaffected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── WAHA (WhatsApp HTTP API) ────────────────────────────────────────
# Leave WAHA_BASE_URL empty for FakeWahaClient fallback (no real WhatsApp
# delivery; safe for dev). Use http://waha:3000 when running the WAHA
# service from this docker-compose stack (`docker compose --profile full up`).
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin

# ─── Frontend (Vite, build-time) ─────────────────────────────────────
# Vite reads .env at build time; any VITE_* referenced in TSX must be
# declared here (the build context excludes .env, so build-args in the
# per-product compose carry these through — see
# KB § PATTERNS/containerization.md §11b VITE_* build-arg contract).
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

# ─── Cross-product navigation URLs (deploy-aware) ────────────────────
# How the Core dashboard's product tiles + the "Voltar ao NoctusAI"
# back-link know where each product lives. TWO layers:
#
# 1) BACKEND (runtime). The Core dashboard launcher resolves each tile's
#    URL per-request via noctusai_lib.api.product_urls.resolve_product_url.
#    Resolution order (first non-empty wins):
#       PRODUCT_URL_<UPPER_SLUG>  →  PRODUCT_URL_PATTERN  →  DB url_base
#    (slug hyphens become underscores: erp-imobiliario → ERP_IMOBILIARIO).
#    By design the DB public.products.url_base column STAYS at its
#    localhost dev default; production overrides live HERE (env), so local
#    dev keeps localhost and prod adapts with no DB rewrite + no rebuild
#    (backend reads env at request time → just restart the core container).
#
#    LOCAL DEV: leave ALL PRODUCT_URL_* UNSET → tiles fall back to the DB
#    localhost defaults (correct for `./start.sh`).
#
#    PRODUCTION (set on the VPS .env only) — the noctusai.com scheme:
#       PRODUCT_URL_PATTERN=https://{slug}.noctusai.com
#       PRODUCT_URL_ERP_IMOBILIARIO=https://erp.noctusai.com   # live short name
#       PRODUCT_URL_SOCIAL_WIRING=https://social.noctusai.com  # live short name
#       PRODUCT_URL_CORE=https://noctusai.com                  # apex front door
#
# 2) FRONTEND (BAKED at build time by Vite — changing these needs a
#    REBUILD of that product's image, not just an env edit; pass as docker
#    build-args, see KB § GUIDES/production-deploy.md §2). core's own FE
#    reads VITE_CORE_API_URL for its API; other products use it to validate
#    the SSO token against core, and VITE_CORE_URL for the back-link.
VITE_CORE_URL=http://localhost:5173
VITE_CORE_API_URL=http://localhost:8000
#    PRODUCTION: VITE_CORE_URL=https://noctusai.com
#                VITE_CORE_API_URL=https://noctusai.com

# ─── Backend base URL (Stripe redirects + transactional email links) ──
APP_BASE_URL=http://localhost:5173
#    PRODUCTION: APP_BASE_URL=https://noctusai.com

# ─── CORS — core's API allowlist (core is the SSO bridge: it accepts XHR
#     from every product FE + the login page) ───────────────────────────
# Core defaults to cors_origins="@registry:all", which resolves via
# noctusai_lib.config.cors_registry.derive_cors_origins → ONLY
# http://localhost:<port> origins. So PRODUCTION MUST set the real origins
# HERE or every cross-origin call to core's API is browser-blocked — incl.
# the apex login (noctusai.com → core.noctusai.com) AND each product's SSO
# token validation ("Servidor indisponível (/api/auth/login)"). Enumerate
# the origins — NEVER "*" (core sends credentials; *+credentials is the
# MDN auth-replay anti-pattern, and the seed forbids it).
#    PRODUCTION (VPS .env):
#    CORS_ORIGINS=https://noctusai.com,https://core.noctusai.com,https://erp.noctusai.com,https://social.noctusai.com,https://personal-finance.noctusai.com,https://therapy-platform.noctusai.com,https://daily-life.noctusai.com,https://adconnect.noctusai.com,https://dev-team.noctusai.com
#
# DEV (the active value below): in the local CONTAINER @registry:all derives
# EMPTY — the runtime-watch image ships NO start.sh, so the registry parse
# finds nothing and core would reject every product origin. So dev needs an
# EXPLICIT allowlist of each product's localhost HOUSE port — the single-
# container port each publishes (the FIRST start.sh port, NOT the vestigial
# 2-container frontend port; bit 2026-05-25, social-wiring 8160 vs 8011). The
# 8000-8015 band covers the current fleet + headroom, so a freshly-scaffolded
# product's /sso can XHR core with NO edit here. core reads this at container-
# CREATE → `docker compose -p noctusai-products up -d --force-recreate core`
# to apply (a plain `docker restart` does NOT re-read env_file).
# NATIVE MODE (`./start.sh native`) serves each SPA from vite on its
# frontend_port, so the browser Origin is the VITE port, not the backend port
# the single-container house model publishes. The vite ports are appended
# below for that reason; in the container/prod shape they are simply unused.
# Derived from the start.sh registry — if you add a product, prefer the
# `@registry:*` sentinel over extending this band by hand.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004,http://localhost:8005,http://localhost:8006,http://localhost:8007,http://localhost:8008,http://localhost:8009,http://localhost:8010,http://localhost:8011,http://localhost:8012,http://localhost:8013,http://localhost:8014,http://localhost:8015,http://localhost:8080,http://localhost:8090,http://localhost:8095,http://localhost:8100,http://localhost:8110,http://localhost:8130,http://localhost:8123,http://localhost:8160,http://localhost:8150,http://localhost:8140,http://localhost:8170,http://localhost:8180

# ─── Local Postgres profile (offline dev — T4 of containerization-backlog-closure) ──
# Uncomment + run `./start.sh local-db` (or `docker compose
# --profile postgres up`) to bring up a local Postgres container
# instead of relying on remote Supabase.
#
# Schema init runs ONCE when the postgres_data volume is empty:
#   scripts/init-local-db/00-extensions.sql      — required extensions
#   scripts/init-local-db/00a-supabase-shims.sql — roles + auth.jwt() stubs
#   scripts/init-local-db/01-schemas.sql         — CREATE SCHEMA per product
#   scripts/init-local-db/02-migrations.sql      — product 001 migrations
# To re-init: `./stop.sh volumes && ./start.sh local-db`.
#
# To point a product at the local DB, override SUPABASE_URL in that
# product's process (env_file / Docker env). The seed's Supabase client
# treats SUPABASE_URL as a PostgREST endpoint — for raw postgres access,
# use psycopg2 / asyncpg pointed at the URL below. Most products will
# need to swap the data-access layer for this mode (tracked separately).
#
# SUPABASE_URL_LOCAL=postgresql://noctus:noctus_local@postgres:5432/noctus
#   (from inside the docker network — service name `postgres`)
# SUPABASE_URL_LOCAL_HOST=postgresql://noctus:noctus_local@localhost:5432/noctus
#   (from host shell — published port 5432)

# ─── Image registry (GHCR — T5 of containerization-backlog-closure) ──
# Local builds work without these set — per-product compose files default
# to `${NOCTUS_IMAGE_TAG:-dev}` so images get tagged
# `ghcr.io/jraphaelsst/noctus-<slug>-<role>:dev` locally.
#
# CI fills these to push images to GHCR. The registry strategy is
# documented at KB § PATTERNS/containerization.md §11a Image registry
# strategy (per-product registries chosen 2026-05-10). Use a fine-scoped
# Personal Access Token with `write:packages` (and `read:packages`).
# Manual push recipe:
#
#     echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin
#     docker push ghcr.io/jraphaelsst/noctus-core-backend:dev
#
# In CI, NOCTUS_IMAGE_TAG is typically set to $(git rev-parse --short HEAD)
# so each commit produces an immutable image; `:latest` moves on every
# main push. See T9 (Wave 3) for the automated workflow.
# GHCR_USERNAME=jraphaelsst
# GHCR_TOKEN=ghp_...

# ─── Add product-specific secrets below this line ────────────────────
# (e.g. SMTP, OAuth client IDs, encryption keys, third-party API keys)

# ─── Website (noctusai.com) — products/core/backend/app/config.py ─────
# See products/core/frontend/src/website/docs/15-api-contract.md. Sane
# defaults ship in code for the first four — only set them to diverge from
# the default host-split. Every fan-out channel below is OPT-IN: leaving
# it empty skips that channel (debug log), never an error.
# WEBSITE_HOSTS=noctusai.com,www.noctusai.com
# CORE_APP_ORIGIN=https://core.noctusai.com
# SERVE_SPA_DIR is already set by the Dockerfile (single-container image);
# leave unset in dev unless testing the prerendered build locally.
WEBSITE_LEADS_NOTIFY_EMAIL=
WEBSITE_SALES_WHATSAPP=
WEBSITE_LEADS_WEBHOOK_URL=
WEBSITE_LEADS_WEBHOOK_SECRET=
# Cloudflare Turnstile secret for the public lead-capture forms. Empty →
# the Fake verifier (still rejects an empty token; see noctusai_lib.
# integrations.turnstile).
WEBSITE_TURNSTILE_SECRET=

# ─── Meta (Facebook / Instagram) — social-wiring ──────────────────────
# Provisioning a fresh environment from this file used to yield a silently
# Meta-less deployment: none of these were documented here, and no compose
# file declares them (every product inherits the root .env via `env_file`).
#
# Dev reads these from the root .env. PROD reads them Fernet-encrypted from
# `social_wiring.app_integration_config` and needs no Meta env vars at all
# — resolution is DB-first with env fallback (`app_config_store.py`).
META_APP_ID=
META_APP_SECRET=              # signs X-Hub-Signature-256 on inbound webhooks
META_OAUTH_SCOPES=auto
META_SYSTEM_USER_TOKEN=       # needs leads_retrieval + pages_manage_metadata
META_AD_ACCOUNT_ID=           # bare id or act_-prefixed; either is normalized
META_ADS_ORG_ID=              # the ONE org the workspace-global ad account writes into
#
# 🔴 The next one is NOT a signing secret. Two different secrets, two jobs:
#   META_APP_SECRET            → every POST, HMAC, proves the call came from Meta
#   META_WEBHOOK_VERIFY_TOKEN  → the one-time GET handshake, proves we own the URL
# Conflating them has already shipped as a bug once (erp-imobiliario).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
META_WEBHOOK_VERIFY_TOKEN=

# ─── academia-de-reciclagem (products/academia-de-reciclagem/backend/app/config.py) ──
# Placeholders only — this repo is PUBLIC. No client, company or knowledge
# content belongs in this file or any fixture (roadmap
# julia-agents-academia-2026-09, anti-goals).
#
# HS256 key(s) academia VERIFIES `X-Approval-Assertion` headers against
# (contract §D). Comma-separated; academia accepts ANY element (rotation =
# prepend the new key, deploy both, then drop the old one). MUST equal (or
# include) `agents`' APPROVAL_ASSERTION_SECRETS[0] below — the two products
# sign/verify with the SAME shared list. Empty → academia refuses to start
# in a deploy context (`required_prod_config`), never a silent
# no-key-configured 500 at the first assertion.
APPROVAL_ASSERTION_SECRETS=
# Comma-separated hostnames academia trusts as primary sources for
# POST /api/sources (contract §B.5). Empty by default: every host gets the
# `aviso` warning until an operator configures the known domains (e.g. the
# relevant .gov.br regulatory sites).
PRIMARY_SOURCE_ALLOWLIST=

# ─── agents (products/agents/backend/app/config.py) ────────────────────
# Placeholders only — same PUBLIC-repo rule as above.
#
# 🔴 CUTOVER FINDING (roadmap D1, surfaced building this file — not yet
# actionable here, see the D1 report): contract §E.5 requires
# ANTHROPIC_API_KEY to be "a dedicated, spend-capped key for Julia's
# workspace, never shared with any other product's LLM calls." But every
# product's compose (dev AND `deploy/fleet/docker-compose.prod.yml`) reads
# this SAME shared root `.env` via `env_file:`, and `ANTHROPIC_API_KEY` is
# also the platform's generic LLM key read by other products/integrations
# — there is no per-product namespacing on `BaseAppSettings`. Setting a
# single ANTHROPIC_API_KEY here would silently hand Julia's dedicated key
# to every other product's LLM calls too (or vice versa), the opposite of
# the contract's isolation requirement. Do NOT "fix" this by just filling
# in the value below and calling it done. The correct fix (mirrors the
# `DEBUG: "false"` override already in `docker-compose.prod.yml`'s
# `x-prod-env` anchor, which proves `environment:` wins over `env_file:`
# per-service): add a distinctly-named var here (e.g.
# JULIA_ANTHROPIC_API_KEY=) and, when agents is added to that prod compose
# at cutover, override it there with
# `environment: {ANTHROPIC_API_KEY: "${JULIA_ANTHROPIC_API_KEY}"}` on the
# agents service ONLY. Tracked for M6 cutover, not fixed in this slice
# (out of D1's scope — that compose file is a later, consent-gated file).
ANTHROPIC_API_KEY=
# Product token `agents` holds to call academia-de-reciclagem's HTTP API
# (contract §C / §E.5). Minted via academia's
# `POST /api/settings/api-tokens` with `principal_agent_id` = the `julia`
# agent row id below; scopes = every `academia:*:write` scope EXCEPT
# `academia:import`. `expires_at` ≤ 90 days — plan rotation before then.
ACADEMIA_API_TOKEN=
# The `agents.agents` row id for the `julia` key (contract §D `sub` claim).
# Must equal ACADEMIA_API_TOKEN's `principal_agent_id` exactly — set at the
# same secret-provisioning step, never guessed at runtime.
JULIA_AGENT_ID=
# Token `agents` holds to call social-wiring's scoped One Chat bridge
# (contract §E.6) — ONLY `social-wiring:one-chat:read` +
# `social-wiring:one-chat:toggle` scopes, `issuer=agents`.
SOCIAL_WIRING_API_TOKEN=
# HS256 key(s) `agents` SIGNS `X-Approval-Assertion` headers with (contract
# §D) — signs with element [0]. Comma-separated; MUST match (or be a
# superset of) academia's APPROVAL_ASSERTION_SECRETS above. Empty → agents
# refuses to start in a deploy context.
# APPROVAL_ASSERTION_SECRETS= — declared once, in the academia block above
# (both products read the SAME env var name/value; do not duplicate here
# with a different value or the two products sign/verify against
# different keys and every assertion fails verification).
#
# Optional — sane defaults, override only if the default is wrong for prod:
# APPROVAL_TIMEOUT_SECONDS=900
# MESSAGES_RATE_LIMIT=20/minute
# JULIA_CLI_PATH=/app/bin/julia-cli-exec   # where bin/julia-cli-exec lands
#   in the image (Dockerfile roadmap D1) — only set this if that layout
#   ever changes without a matching code change.
