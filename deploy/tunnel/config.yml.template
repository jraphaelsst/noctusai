# config.yml.template — TRACKED template for the cloudflared NAMED-tunnel config.
#
# ⚠️ THIS FILE IS THE TEMPLATE (placeholders only — no secrets, safe in git).
# The RENDERED file `config.yml` (this dir, same name minus `.template`) is
# what cloudflared actually reads (mounted at /etc/cloudflared/config.yml) and
# is **gitignored** (`**/tunnel/config.yml`) so it is filled-in-place on the
# VPS and a `git pull` can never clobber the live tunnel config — the
# "nothing-to-clobber" net (deploy-hardening Phase 2 / P4). Render once on the
# VPS:  `cp config.yml.template config.yml` then fill the two <PLACEHOLDERS>
# (or `TUNNEL_ID=… CRED_PATH=… envsubst < config.yml.template > config.yml`).
#
# It is DERIVED from ingress.yml — when you remap a slug there, regenerate
# the `ingress:` block below and re-apply (see README.md).
#
# Replace the two <PLACEHOLDERS> when rendering:
#   <TUNNEL_ID>  — UUID printed by `cloudflared tunnel create <name>`.
#   <PATH>       — path to the tunnel credentials JSON (in-container path).
#
# `protocol: http2` is carried over from the quick-tunnel rule
# (KB § PATTERNS/containerization.md § "The --protocol http2 rule"):
# cloudflared's default `auto` opens QUIC/UDP, which NATs drop in ~5–10min
# and cannot re-register. HTTP2-over-TCP is stable for a long-lived VPS
# tunnel. Keep this pin.

tunnel: <TUNNEL_ID>
credentials-file: <PATH>      # e.g. /etc/cloudflared/<TUNNEL_ID>.json
protocol: http2
no-autoupdate: true

# ── ingress (generated from ingress.yml, snapshot 2026-05-25) ──────────
# Order matters: cloudflared matches top-to-bottom; the final catch-all
# MUST be last. The service target is the in-network name on noctus-net
# (== compose service == noctus-<slug> container), reached by name because
# cloudflared shares the network — never a published host port.

ingress:
  - hostname: noctusai.com
    service: http://core:8000
  - hostname: core.noctusai.com
    service: http://core:8000
  - hostname: seed.noctusai.com
    service: http://seed:8004
  # UN-EXPOSED 2026-08-17 (owner's decision): personal-finance:8002 ·
  # therapy-platform:8003 · daily-life:8005 · adconnect:8007 · dev-team:8009.
  # All ativo=false yet publicly answering 200 on images 27 seed-changes
  # stale. Rationale + the reversal recipe live in ingress.yml — this file is
  # the second derived artifact of the same route table, so the two must move
  # together (check_tunnel_ingress_snapshot_sync).
  - hostname: orbity.noctusai.com
    service: http://orbity:8010
  - hostname: igig.noctusai.com
    service: http://igig:8013
  - hostname: p-studio.noctusai.com
    service: http://p-studio:8014
  - hostname: erp.noctusai.com
    service: http://erp-imobiliario:8001
  - hostname: social.noctusai.com
    service: http://social-wiring:8011
  - hostname: n8n.noctusai.com
    service: http://n8n:5678
  - hostname: waha.noctusai.com
    service: http://waha:3000
  - hostname: legacy.noctusai.com
    service: http://legacy:5000
  - service: http_status:404
