# Secrets for the raw service containers (n8n / waha / postgres).
# Copy to `.env.services` ON THE VPS and fill from the values currently running under Coolify:
#   docker inspect postgres-r8co0gwsw8g4gggcc0sko8ko --format '{{range .Config.Env}}{{println .}}{{end}}' | grep -E 'POSTGRES_PASSWORD'
#   docker inspect waha-r8co0gwsw8g4gggcc0sko8ko     --format '{{range .Config.Env}}{{println .}}{{end}}' | grep -E 'WHATSAPP_API_KEY|WAHA_DASHBOARD'
# NEVER commit .env.services (it is gitignored).

POSTGRES_DB=default
POSTGRES_USER=default
POSTGRES_PASSWORD=

WHATSAPP_API_KEY=
WAHA_DASHBOARD_USERNAME=jraphaelsst
WAHA_DASHBOARD_PASSWORD=
