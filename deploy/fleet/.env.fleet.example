# deploy/fleet/.env.fleet.example
# Environment variables for the production infra fleet (compose.infra.prod.yml).
# Copy to .env.fleet on the VPS and fill in real values.
# NEVER commit .env.fleet — it carries secrets.

# ---------------------------------------------------------------------------
# Redis (always-on, no additional env required beyond image defaults)
# ---------------------------------------------------------------------------
# Legacy noctus-redis needs none. The ACL'd noctus-redis-acl (profile redis-acl) derives EVERY user's password
# from ONE master (KB § PATTERNS/devops/redis-acl-lockdown.md): generate with `openssl rand -hex 32`.
# Exactly 64 lowercase hex chars (openssl rand -hex 32); anything else is refused. Set on the VPS only.
REDIS_ACL_MASTER_SECRET=
# Digits only. Bump to rotate every Redis password; REDIS_ACL_GENERATION_OVERRIDES=core=2 rotates one user.
REDIS_ACL_GENERATION=1

# ---------------------------------------------------------------------------
# WAHA — WhatsApp HTTP API (profile: waha)
# ---------------------------------------------------------------------------
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_PLATFORM=linux/amd64
WAHA_API_KEY=             # generate strong random string
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=  # set a strong password

# ---------------------------------------------------------------------------
# Cache backend (Postgres + pgvector) — prod-only; dev uses local SQLite.
# Set when deploying the cache profile.
# ---------------------------------------------------------------------------
NOCTUS_CACHE_PG_DB=noctus_cache
NOCTUS_CACHE_PG_USER=noctus_cache
NOCTUS_CACHE_PG_PASSWORD=  # generate strong; set on VPS only
NOCTUS_CACHE_PG_HOST=noctus-cache-pg
NOCTUS_CACHE_PG_PORT=5432
# Composed DSN — consumed by PostgresCacheBackend.
# NOCTUS_CACHE_POSTGRES_DSN=postgresql://user:pass@noctus-cache-pg:5432/noctus_cache

# ---------------------------------------------------------------------------
# Transcriber worker (noctus-transcriber) — transcription-contract.md §2.
# TRANSCRIBER_TOKEN: shared secret social-wiring sends as X-Transcriber-Token.
# Empty => the transcriber refuses every request (fail-closed). Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
TRANSCRIBER_TOKEN=  # generate strong; set on VPS only
TRANSCRIBER_IMAGE_TAG=latest
