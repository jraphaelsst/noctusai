# ==============================================================================
# Legacy app env — "Sistema de Permutas Imobiliárias" (legacy.noctusai.com)
# Copy to `.env` and fill with REAL values on the VPS. NEVER commit `.env`.
# Variable NAMES below are DERIVED from the source code (grep os.environ.get +
# backend/backend/settings.py + frontend/src/lib/supabase.ts + services/api.ts).
# No real values are included here.
# ==============================================================================

# --- Database (Supabase Postgres) ---------------------------------------------
# settings.py reads SUPABASE_DB_URL and parses it via dj-database-url. When set,
# Django uses Postgres with sslmode=require + conn_max_age=600. When UNSET it
# silently falls back to local SQLite (db.sqlite3) — DO NOT leave blank in prod.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
SUPABASE_DB_URL=

# Supabase project URL + anon key, also read by the BACKEND (settings.py
# SUPABASE_URL / SUPABASE_ANON_KEY). Set even if currently only the frontend
# uses Supabase directly, so backend reads resolve non-empty.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Redis / Celery (broker is EXTERNAL/shared — no Redis container) ----------
# settings.py reads CELERY_BROKER_URL + CELERY_RESULT_BACKEND directly. The
# brief's "REDIS_URL" maps to BOTH of these (this app does NOT read REDIS_URL).
# Point at the shared fleet Redis on noctus-net, e.g. redis://redis:6379/3.
# Use a dedicated DB index that does not collide with the fleet's usage.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Run Celery tasks synchronously in-process (true/1) instead of dispatching to
# the worker. Defaults to settings.DEBUG. In production with a worker: false.
CELERY_ALWAYS_EAGER=false

# --- Django core --------------------------------------------------------------
# ✅ Now ENV-DRIVEN via deploy/legacy/settings_prod.py (the build sets
# DJANGO_SETTINGS_MODULE=backend.settings_prod, which imports the read-only base
# settings + overrides these from the env). The reference's hardcoded insecure
# key/DEBUG=True/ALLOWED_HOSTS are NOT used. These take effect at runtime.
SECRET_KEY=                         # REQUIRED — generate fresh (`python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"`); NEVER the dev literal
DEBUG=False                         # MUST be False in production
ALLOWED_HOSTS=legacy.noctusai.com   # comma-separated; the tunnel ingress hostname
CSRF_TRUSTED_ORIGINS=https://legacy.noctusai.com  # comma-separated https origins

# --- Frontend BUILD-TIME ONLY (CRA inlines REACT_APP_* at build) --------------
# These are consumed by `docker compose build` (Dockerfile build args), NOT at
# container runtime — an already-built SPA bundle cannot pick them up later.
# frontend/src/lib/supabase.ts reads REACT_APP_SUPABASE_URL / _ANON_KEY.
# services/api.ts optionally reads REACT_APP_API_URL (else same-origin /api).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_API_URL=    # optional; leave blank for same-origin /api via the tunnel
