#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# pre-commit hook
#
# Runs BEFORE every commit. Stages any auto-derived updates so they land
# in the same commit as the human-authored changes — no post-commit amend.
#
# Steps:
#   1. If any staged file is in products/seed/, sync the seed → template
#      mirror (`sync-seed-template.sh`) and stage templates/product-seed/.
#   2. Regenerate auto-derived KB count blocks (`update-kb-counts.py`) and
#      stage any KB docs / CLAUDE.md that changed.
#   3. Verify KB ↔ CLAUDE.md sync (`verify-kb-sync.sh`). ABORT the commit
#      if any pointer is broken.
#
# Bypass (not recommended): git commit --no-verify
# ──────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ─── 1. Seed → template mirror (only if seed/ files are staged) ──
if [[ -x "$REPO_ROOT/scripts/sync-seed-template.sh" && -d "$REPO_ROOT/products/seed" ]]; then
    STAGED_SEED=$(git diff --cached --name-only -- products/seed/ 2>/dev/null || true)
    if [[ -n "$STAGED_SEED" ]]; then
        echo "[pre-commit] Seed product changed — syncing template..."
        bash "$REPO_ROOT/scripts/sync-seed-template.sh" 2>&1 | sed 's/^/[pre-commit] /'

        TEMPLATE_DIFF=$(git status --porcelain -- templates/product-seed/ 2>/dev/null || true)
        if [[ -n "$TEMPLATE_DIFF" ]]; then
            echo "[pre-commit] Staging template changes:"
            git add templates/product-seed/
            git status --porcelain -- templates/product-seed/ | sed 's/^/[pre-commit]   /'
        else
            echo "[pre-commit] Template already matches seed — no changes needed."
        fi
    fi
fi

# ─── 2. KB auto-derived counts ──────────────────────────────────
if [[ -x "$REPO_ROOT/scripts/update-kb-counts.py" ]]; then
    # Same venv-discovery shape as block 5 (worktree-aware).
    if [[ -x "$REPO_ROOT/venv/bin/python" ]]; then
        PY="$REPO_ROOT/venv/bin/python"
    else
        MAIN_REPO_GITDIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
        if [[ -n "$MAIN_REPO_GITDIR" ]]; then
            MAIN_REPO_ROOT=$(dirname "$MAIN_REPO_GITDIR")
            if [[ -x "$MAIN_REPO_ROOT/venv/bin/python" ]]; then
                PY="$MAIN_REPO_ROOT/venv/bin/python"
            fi
        fi
        PY="${PY:-${PYTHON:-python3}}"
    fi
    if command -v "$PY" >/dev/null 2>&1 || [[ -x "$PY" ]]; then
        echo "[pre-commit] Updating KB auto-derived counts..."
        "$PY" "$REPO_ROOT/scripts/update-kb-counts.py" 2>&1 | sed 's/^/[pre-commit] /'

        CHANGED_DOCS=$(git diff --name-only -- KNOWLEDGE-BASE/ CLAUDE.md 2>/dev/null || true)
        if [[ -n "$CHANGED_DOCS" ]]; then
            echo "[pre-commit] Staging updated KB docs:"
            echo "$CHANGED_DOCS" | sed 's/^/[pre-commit]   /'
            echo "$CHANGED_DOCS" | xargs -r git add
        fi
    else
        echo "[pre-commit] Skipping count refresh — python3 not found"
    fi
fi

# ─── 3. Seed version stamp (matches _version_static.py to current HEAD) ──
# Keeps the keeper drift-detector honest. Idempotent; gitignored output.
if [[ -x "$REPO_ROOT/scripts/stamp-seed-version.sh" ]]; then
    bash "$REPO_ROOT/scripts/stamp-seed-version.sh" 2>&1 | sed 's/^/[pre-commit] /' || true
fi

# ─── 3b. Project-history ledger → PROJECT-HISTORY.md render ─────
# Per `projects/project-history-ledger/PROJECT.md § 6 Phase 3`.
# Re-render the human view when the ledger is staged OR when the
# ledger has been modified by an earlier step in this hook chain
# (e.g. an archive-step that stamped a new record before commit).
# Output auto-stages so the human view never drifts from the
# structured source — matches the §2 KB-counts pattern.
if [[ -x "$REPO_ROOT/scripts/render-project-history.py" ]]; then
    STAGED_LEDGER=$(git diff --cached --name-only -- project-history/ledger.ndjson 2>/dev/null || true)
    UNSTAGED_LEDGER=$(git status --porcelain -- project-history/ledger.ndjson 2>/dev/null || true)
    if [[ -n "$STAGED_LEDGER" || -n "$UNSTAGED_LEDGER" ]]; then
        # Reuse the `$PY` discovered in §2 (worktree-aware). Falls back
        # to python3 if §2 didn't run for some reason.
        PY="${PY:-${PYTHON:-python3}}"
        if command -v "$PY" >/dev/null 2>&1 || [[ -x "$PY" ]]; then
            echo "[pre-commit] Rendering project-history/PROJECT-HISTORY.md..."
            "$PY" "$REPO_ROOT/scripts/render-project-history.py" 2>&1 \
                | sed 's/^/[pre-commit] /'
            CHANGED_HISTORY=$(git status --porcelain -- project-history/PROJECT-HISTORY.md 2>/dev/null || true)
            if [[ -n "$CHANGED_HISTORY" ]]; then
                echo "[pre-commit] Staging updated project-history/PROJECT-HISTORY.md"
                git add project-history/PROJECT-HISTORY.md
            fi
        else
            echo "[pre-commit] Skipping history render — python3 not found"
        fi
    fi
fi

# ─── 4. KB ↔ CLAUDE.md sync verification (blocking) ─────────────
if [[ -x "$REPO_ROOT/scripts/verify-kb-sync.sh" ]]; then
    echo "[pre-commit] Verifying KB sync..."
    if ! bash "$REPO_ROOT/scripts/verify-kb-sync.sh"; then
        echo "[pre-commit] KB sync check FAILED. Commit aborted." >&2
        echo "[pre-commit] Fix the broken pointers in CLAUDE.md or update KNOWLEDGE-BASE/INDEX.md." >&2
        exit 1
    fi
fi

# ─── 4b. Containerization propagation drift (blocking, when seed staged) ─
# Project: containerization-single-container. The seed at products/seed/
# is canonical; the 10 per-product backend Dockerfiles + composes +
# overrides are GENERATED. If the canonical seed (or a propagate script)
# is staged but the generated files weren't re-propagated, they drift
# silently. Each propagate-*.sh --check exits non-zero on drift.
if git diff --cached --name-only | grep -qE '^products/seed/(backend/Dockerfile|docker-compose\.(yml|override\.yml))$|^scripts/propagate-.*\.sh$|^seed/docker/Dockerfile\.'; then
    for chk in propagate-dockerfiles propagate-composes; do
        if [[ -x "$REPO_ROOT/scripts/$chk.sh" ]]; then
            if ! bash "$REPO_ROOT/scripts/$chk.sh" --check >/dev/null 2>&1; then
                echo "[pre-commit] $chk drift — per-product files stale vs products/seed/." >&2
                echo "[pre-commit] Run: bash scripts/$chk.sh   then re-stage. Commit aborted." >&2
                exit 1
            fi
        fi
    done
    echo "[pre-commit] containerization propagation: in sync."
fi

# ─── 5. Phase-state consistency (blocking, only when PROJECT.md staged) ──
# Per `keeper-phase-state-consistency-detector` (shipped 2026-04-28) +
# `KB § PATTERNS/project-execution.md § 2 Self-check before claiming a
# phase is done`. Catches §6 ↔ §11 drift before it commits — closes the
# slip pattern that documentation alone wasn't sufficient to prevent.
#
# Only runs when a file whose BASENAME is exactly `PROJECT.md` is staged
# (perf — no overhead on commits that don't touch project docs, per
# project §7.3 default). The basename match avoids false-firing on
# legacy files like `AI-EXPANSION-PROJECT.md` whose name happens to
# end in `PROJECT.md`.
STAGED_PROJECT_MD=$(git diff --cached --name-only 2>/dev/null | grep -E '(^|/)PROJECT\.md$' || true)
if [[ -n "$STAGED_PROJECT_MD" ]]; then
    # Prefer the repo's venv Python (codebase uses Python 3.10+ syntax;
    # system `python3` may be older on some hosts). When running inside a
    # `git worktree add`-created worktree, `$REPO_ROOT` is the worktree's
    # path (no venv), so fall back to the MAIN repo's venv resolved via
    # `--git-common-dir` (which returns the shared `.git/` of the source
    # checkout). Final fallback: `${PYTHON:-python3}`.
    if [[ -x "$REPO_ROOT/venv/bin/python" ]]; then
        PY="$REPO_ROOT/venv/bin/python"
    else
        MAIN_REPO_GITDIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
        if [[ -n "$MAIN_REPO_GITDIR" ]]; then
            MAIN_REPO_ROOT=$(dirname "$MAIN_REPO_GITDIR")
            if [[ -x "$MAIN_REPO_ROOT/venv/bin/python" ]]; then
                PY="$MAIN_REPO_ROOT/venv/bin/python"
            fi
        fi
        PY="${PY:-${PYTHON:-python3}}"
    fi
    if command -v "$PY" >/dev/null 2>&1 || [[ -x "$PY" ]]; then
        echo "[pre-commit] Checking §6 ↔ §11 phase-state consistency..."
        if ! "$PY" "$REPO_ROOT/mcp/noctusai/cli.py" --check-phase-state; then
            echo "[pre-commit] Phase-state check FAILED. Commit aborted." >&2
            echo "[pre-commit] Fix the §6 live state (tick checkboxes / flip header / add Improvements block) before committing." >&2
            exit 1
        fi
    fi
fi

echo "[pre-commit] OK"
exit 0
