#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# pre-push — client-side branch protection + CHANGE-GATED cache refresh.
#
# `main` is PRODUCTION (what the VPS deploys). `dev` is the everyday
# integration branch — all routine work + pushes go there. This hook is
# the deterministic Stage-4 backstop for "main is sacred" (the dev-layer
# branch model, KB § PATTERNS/branching-and-merging.md § 0):
#
#   1. ANY push to a protected branch (main, prod) is REFUSED unless the
#      sanctioned-deploy override `NOCTUS_ALLOW_MAIN_PUSH=1` is set.
#   2. DELETION of a protected branch is ALWAYS refused.
#   3. NON-FAST-FORWARD (force) push to a protected branch is ALWAYS refused.
#
# It ALSO change-gates the embedding-cache refresh (below). Those refreshes log
# cost rows to an UNTRACKED spool, so this hook dirties nothing tracked and makes
# NO commit of its own — a commit created here cannot join the push that created
# it, so it would ride the next push and cancel that push's CI run. The tracked
# ledger is written only by pre-commit leg 10c.
# (KB § PATTERNS/common/vector-cost-tracking.md § Fold-into-commit.)
#
# Sanctioned deploy:  NOCTUS_ALLOW_MAIN_PUSH=1 git push origin dev:main
# Hard bypass (rare): git push --no-verify
# Carve-out: [carve:hook] — git-hook entry; logic is git-native + thin.
# See KB § PATTERNS/branching-and-merging.md § 0.2 and § PATTERNS/branching-dispatch.md.
# ──────────────────────────────────────────────────────────────
set -euo pipefail

PROTECTED_RE='^refs/heads/(main|prod)$'
ZERO_RE='^0+$'   # all-zero OID = a delete (SHA-1 or SHA-256)
ALLOW="${NOCTUS_ALLOW_MAIN_PUSH:-}"
blocked=0

# stdin: <local_ref> <local_oid> <remote_ref> <remote_oid>  (one line per ref).
# Capture upfront — the refresh-gate needs the pushed range; the protection
# loop reuses the captured lines (git provides stdin exactly once).
PUSH_LINES="$(cat)"

# ─── Change-GATED cache refresh (v4.1 2026-05-30) ───────────────────────
# Pre-commit no longer refreshes kb/code embeddings; the push boundary is the
# batching unit. v4.0 refreshed ALL 8 caches on EVERY push ("belt-and-suspenders")
# — paying a 30-60s OpenAI-round-trip + noc-graph-rebuild tax even on delete-only
# or no-source pushes. v4.1 GATES each refresh on whether the pushed range actually
# changed that cache's source files:
#   • delete-only / no-content push  → skip everything (instant)
#   • kb-embeddings / corpus          → only if *.md changed
#   • code-embeddings                 → only if *.py changed
#   • keeper / agent-context / auto-improvement / noc-graph → only if their input changed
# Under-refresh is self-healing: the source_sha invariant makes every refresh
# idempotent, and check_all_cache_freshness (8-way-sync, pre-commit) surfaces any
# residual staleness on the next commit. Correctness preserved; the waste is cut.
# Overrides: NOCTUS_SKIP_EMBED_REFRESH=1 (skip entirely — CI smoke pushes) ·
#            NOCTUS_FORCE_EMBED_REFRESH=1 (force the full v4.0 belt-and-suspenders pass).
# KB § PATTERNS/common/push-time-embedding-gate.md.
REPO_ROOT_PP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
PY_PP="$REPO_ROOT_PP/mcp/noctusai/.venv/bin/python"
CLI_PP="$REPO_ROOT_PP/mcp/noctusai/cli.py"
if [[ -z "${NOCTUS_SKIP_EMBED_REFRESH:-}" && -x "$PY_PP" && -f "$CLI_PP" ]]; then
    # Collect changed files across every NON-delete ref in this push.
    changed=""
    any_content=0
    while read -r l_ref l_oid r_ref r_oid; do
        [[ -z "${l_ref:-}" ]] && continue
        [[ "$l_oid" =~ $ZERO_RE ]] && continue   # delete — no content
        any_content=1
        if [[ "$r_oid" =~ $ZERO_RE ]]; then
            # new branch on remote — diff vs origin/dev when we have a base,
            # else fall back to the files in the new commits themselves.
            base="$(git merge-base "$l_oid" origin/dev 2>/dev/null || true)"
            if [[ -n "$base" ]]; then
                changed+=$'\n'"$(git diff --name-only "$base" "$l_oid" 2>/dev/null || true)"
            else
                changed+=$'\n'"$(git show --name-only --format= "$l_oid" 2>/dev/null || true)"
            fi
        else
            changed+=$'\n'"$(git diff --name-only "$r_oid" "$l_oid" 2>/dev/null || true)"
        fi
    done <<< "$PUSH_LINES"

    force="${NOCTUS_FORCE_EMBED_REFRESH:-}"
    if [[ "$any_content" -eq 0 && -z "$force" ]]; then
        echo "[pre-push] delete-only / no-content push — skipping all cache refresh."
    else
        # set -e safe flag tests (grep -q exits 1 on no-match).
        kb=0; code=0; md=0; comp=0; agents=0; ndjson=0; graph=0
        if [[ -n "$force" ]]; then kb=1; code=1; md=1; comp=1; agents=1; ndjson=1; graph=1; fi
        if grep -qE '^KNOWLEDGE-BASE/.*\.md$'   <<<"$changed"; then kb=1;     fi
        if grep -qE '\.py$'                      <<<"$changed"; then code=1;   fi
        if grep -qE '\.md$'                      <<<"$changed"; then md=1;     fi
        if grep -qE 'compliance\.py$'            <<<"$changed"; then comp=1;   fi
        if grep -qE '^\.claude/agents/'          <<<"$changed"; then agents=1; fi
        if grep -qE 'auto-improvement\.ndjson$'  <<<"$changed"; then ndjson=1; fi
        # graph inputs: code, KB, harness surfaces (agents/skills/commands).
        if grep -qE '\.(py|md)$|^\.claude/'      <<<"$changed"; then graph=1;  fi

        # CACHE-TIMING RELOCATION (2026-06-01): the EXPENSIVE refreshes (kb/code/
        # corpus OpenAI embeddings + noc-graph rebuild) fire ONLY when DELIVERING to
        # a shared branch (dev/main/prod) — the "final push" boundary. An
        # intermediate push (a feat/* branch) defers them (they self-heal lazily on
        # read + at the eventual dev delivery). The CHEAP zero-OpenAI structural
        # settles (keeper / agent-context / auto-improvement) still run on any push
        # so keeper gates stay fresh. KB § branch-tree-tracking §3 (cache-refresh-timing rule).
        delivering=0
        while read -r _lr _lo r_ref _ro; do
            [[ "$r_ref" =~ ^refs/heads/(dev|main|prod)$ ]] && delivering=1
        done <<< "$PUSH_LINES"
        if [[ -z "$force" && "$delivering" -eq 0 ]]; then
            echo "[pre-push] intermediate push (not dev/main/prod) — deferring expensive cache refresh (embeddings + noc-graph)."
            kb=0; code=0; md=0; graph=0
        fi

        # Branch-tree pointer pushes are cache-EXEMPT (tracking metadata, not
        # graph-input) — KB § branch-tree-tracking §3 "Cache-sync discipline".
        # If the push touches ONLY cache-exempt paths, force every flag off so a
        # constant pointer update never pays the noc-graph/embedding refresh tax.
        # (Defensive belt: ndjson already matches no pattern above; this makes
        # the exemption explicit + robust against future pattern drift.)
        if [[ -z "$force" ]] && "$PY_PP" "$CLI_PP" --branch-pointer-cache-exempt --bp-paths "$changed" >/dev/null 2>&1; then
            echo "[pre-push] metadata-only branch-tree pointer push — cache refresh exempt."
            kb=0; code=0; md=0; comp=0; agents=0; ndjson=0; graph=0
        fi

        ran=0
        if [[ $kb     -eq 1 ]]; then echo "[pre-push] kb sources changed → refreshing kb-embeddings";   "$PY_PP" "$CLI_PP" --refresh-kb-embeddings     2>&1 | tail -1 | sed 's/^/[pre-push] kb-embed: /'   || true; ran=1; fi
        if [[ $code   -eq 1 ]]; then echo "[pre-push] py changed → refreshing code-embeddings";          "$PY_PP" "$CLI_PP" --refresh-code-embeddings   2>&1 | tail -1 | sed 's/^/[pre-push] code-embed: /' || true; ran=1; fi
        if [[ $md     -eq 1 ]]; then echo "[pre-push] markdown changed → refreshing corpus-embeddings";  "$PY_PP" "$CLI_PP" --refresh-corpus-embeddings 2>&1 | tail -1 | sed 's/^/[pre-push] corpus-embed: /' || true; ran=1; fi
        if [[ $comp   -eq 1 ]]; then "$PY_PP" "$CLI_PP" --refresh-keeper-cache           2>&1 | tail -1 | sed 's/^/[pre-push] keeper: /'           || true; ran=1; fi
        if [[ $agents -eq 1 ]]; then "$PY_PP" "$CLI_PP" --refresh-agent-context-cache    2>&1 | tail -1 | sed 's/^/[pre-push] agent-context: /'    || true; ran=1; fi
        if [[ $ndjson -eq 1 ]]; then "$PY_PP" "$CLI_PP" --refresh-auto-improvement-cache 2>&1 | tail -1 | sed 's/^/[pre-push] auto-improvement: /' || true; ran=1; fi
        if [[ $graph  -eq 1 ]]; then "$PY_PP" "$CLI_PP" --refresh-noc-graph              2>&1 | tail -1 | sed 's/^/[pre-push] noc-graph: /'        || true; ran=1; fi
        # memory-embeddings is OUT-OF-REPO (the ~/.claude memory dir), so git CANNOT
        # gate it on changed files the way the others are gated — and an agent that
        # edits memory mid-session must never have to refresh it by hand (the
        # manual-refresh anti-pattern). So run it EVERY push: the refresh is
        # source_sha-guarded (re-embeds ONLY memory files whose sha changed → a cheap
        # near-no-op dir-walk when nothing changed, self-healing when it did). This is
        # memory's gate — its own content sha, since git can't be. No manual work.
        echo "[pre-push] memory dir is out-of-repo → refreshing memory-embeddings (source_sha-guarded)"
        "$PY_PP" "$CLI_PP" --refresh-memory-embeddings 2>&1 | tail -1 | sed 's/^/[pre-push] memory-embed: /' || true; ran=1
        [[ $ran -eq 0 ]] && echo "[pre-push] no embeddable/graph sources changed in this push — skipped all refreshes."
    fi
fi

# ─── Cost-ledger churn: NOTHING TO DO HERE (2026-08-11) ─────────────────────
# 🔴 DO NOT RE-ADD A COMMIT HERE. This block used to sweep the push-time cost
# rows into a path-limited `chore(cost-log)` commit, because the refreshes above
# append AFTER the last commit and left the tracked ledger dirty.
#
# That fixed "dirty tree" and bought a worse bug. A commit created in pre-push
# CANNOT join the push that created it (the refs are already negotiated), so it
# sat local, "ahead by 1", and rode the NEXT push — moving the branch tip and
# cancelling the in-flight CI run for the sha we actually cared about
# (`test.yml` has `concurrency: cancel-in-progress`). Five CI runs died that way
# in a single session, and the ledger accreted 20+ commits of pure churn.
#
# The real fix is upstream, not here: cost rows now land in an UNTRACKED spool
# (`project-history/.vector-costs-spool.ndjson`), so the refreshes above dirty
# nothing tracked, and pre-commit leg 10c folds the spool into the ledger inside
# a real commit. Push time no longer has a ledger problem to solve.
#
# Regression-pinned by `test_pre_push_makes_no_cost_log_commit` in
# mcp/noctusai/tests/test_vector_cost_spool.py.
# KB § PATTERNS/common/vector-cost-tracking.md § Fold-into-commit.

# ─── branch-tree mirror keeper (§5, hard-block on dev push) ────────────────
# For every non-delete branch being pushed TO dev, check that a valid branch-pointer
# exists in project-history/branch-tree.ndjson.  We skip this on protected-branch
# (main/prod) pushes (those are sanctioned deploys, not everyday-work pushes) and
# when the Python environment isn't available.
# branch-tree.ndjson itself is EXCLUDED from all cache-refresh triggers (§3
# cache-sync discipline); a push touching ONLY that file is fast-path here.
if [[ -z "${NOCTUS_SKIP_BRANCH_TREE_CHECK:-}" && -x "$PY_PP" && -f "$CLI_PP" ]]; then
    while read -r l_ref l_oid r_ref r_oid; do
        [[ -z "${l_ref:-}" ]] && continue
        # Skip deletes.
        [[ "$l_oid" =~ $ZERO_RE ]] && continue
        # Skip pushes to protected branches (main/prod) — sanctioned deploy, not everyday work.
        [[ "${r_ref:-}" =~ $PROTECTED_RE ]] && continue
        # Only check pushes whose remote target is refs/heads/dev (the integration branch)
        # OR whose local branch is a feat/* / fix/* / chore/* work branch.
        # Derive the branch name from the local ref. A `git push origin HEAD:dev`
        # sends l_ref="HEAD" (not a refs/heads/ ref) — resolve it to the real
        # current branch so the dev-skip below catches it (else the keeper checks
        # a phantom branch "HEAD" with no pointer and blocks the push).
        _bt_branch="${l_ref#refs/heads/}"
        [[ "$_bt_branch" == "HEAD" ]] && _bt_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)"
        # Skip dev (the integration branch has no pointer) + release-managed refs:
        # prod-backup is force-snapshotted by noctus.dev.release and has no
        # branch-tree pointer (main/prod are already skipped via PROTECTED_RE
        # above). Without this the release promote's prod-backup snapshot push is
        # blocked by the mirror keeper. KB § branch-tree-tracking §5.
        [[ "$_bt_branch" == "dev" ]] && continue
        [[ "${r_ref:-}" == "refs/heads/prod-backup" || "$_bt_branch" == "prod-backup" ]] && continue
        # Run the keeper for this branch — any high finding = block.
        echo "[pre-push] branch-tree mirror check for '$_bt_branch'..."
        _bt_out="$("$PY_PP" "$CLI_PP" --check-branch-tree-mirror "$_bt_branch" 2>&1)"
        _bt_rc=$?
        if [[ $_bt_rc -ne 0 ]]; then
            echo "" >&2
            echo "🔴 pre-push: branch-tree mirror keeper BLOCKED push of '$_bt_branch'." >&2
            echo "$_bt_out" >&2
            echo "" >&2
            echo "   Fix by running the branch_pointer call named above, then re-push." >&2
            echo "   KB § CONTEXT/PATTERNS/architect/branch-tree-tracking.md §5." >&2
            blocked=1
        else
            echo "[pre-push] branch-tree mirror: $( echo "$_bt_out" | tail -1 | sed 's/^[[:space:]]*//' )"
        fi
    done <<< "$PUSH_LINES"
fi

# ─── branch protection (reads the captured push lines) ──────────────────
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ -z "${remote_ref:-}" ]] && continue
    [[ "$remote_ref" =~ $PROTECTED_RE ]] || continue
    branch="${remote_ref#refs/heads/}"

    # 1) deletion — local side is the zero OID. Always refused.
    if [[ "$local_oid" =~ $ZERO_RE ]]; then
        echo "🔴 pre-push: refusing to DELETE protected branch '$branch'." >&2
        echo "   Production history is preserved by design." >&2
        blocked=1
        continue
    fi

    # 2) force-push — remote tip exists but is NOT an ancestor of the new tip.
    if [[ ! "$remote_oid" =~ $ZERO_RE ]]; then
        if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
            echo "🔴 pre-push: refusing NON-FAST-FORWARD (force) push to '$branch'." >&2
            echo "   This would rewrite/rewind production history." >&2
            echo "   If truly intended, re-run with: git push --no-verify" >&2
            blocked=1
            continue
        fi
    fi

    # 3) ordinary push to a protected branch — gated (main is deploy-only, §0.2).
    if [[ "$ALLOW" != "1" ]]; then
        echo "🔒 pre-push: BLOCKED — '$branch' is production; pushes are gated." >&2
        echo "   Land everyday work on 'dev' (the integration branch)." >&2
        echo "   For a sanctioned deploy: NOCTUS_ALLOW_MAIN_PUSH=1 git push origin dev:$branch" >&2
        blocked=1
        continue
    fi

    echo "✅ pre-push: NOCTUS_ALLOW_MAIN_PUSH=1 — allowing fast-forward deploy push to '$branch'." >&2
done <<< "$PUSH_LINES"

if [[ "$blocked" -ne 0 ]]; then
    echo "" >&2
    echo "pre-push BLOCKED (client-side branch protection — main is sacred, § 0)." >&2
    exit 1
fi
exit 0
