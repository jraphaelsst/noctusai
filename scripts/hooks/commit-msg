#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# commit-msg — ship-consent ATTRIBUTION trailer (2026-09-22).
#
# Appends `Noc-Branch: <current branch>` to every commit message that does not
# already carry one, so `noctus.dev.release stage=manifest` can group the
# commits `origin/main..origin/dev` would ship by the branch → project that
# authored them, and bless can refuse to carry another agent's unapproved work
# to prod. KB § PATTERNS/devops/ship-consent-riders.md.
#
# Skips (by design, never an error):
#   • merge commits (MERGE_HEAD present) — a merge carries no authored diff;
#   • detached HEAD — rebase / cherry-pick replays run detached, and the
#     ORIGINAL trailer already rides in the replayed message, which is how
#     the attribution survives `task_branch integrate`'s rebase onto dev.
# An existing `Noc-Branch:` trailer is NEVER rewritten (first author wins —
# a cherry-pick onto a release branch keeps the originating branch).
# (The attribution step never blocks; only the guide + LGPD gates above do.) Attribution failure degrades to "unattributed",
# which the manifest already treats as UNAPPROVED (refuse-not-null there).
# ──────────────────────────────────────────────────────────────
msg_file="$1"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# ─── Product-guide co-change gate (BLOCKING — the one thing this hook blocks) ─
# Keeper `check_product_guide_cochange` (`KB § PATTERNS/common/live-state-
# alignment.md`): a staged behaviour change of a product with a help-chat
# knowledge guide must stage the guide too, unless the message carries a
# `Guide-Unaffected: <reason>` trailer. Lives HERE (not pre-commit) because
# only this hook can read the message. Skips merges and detached HEAD (rebase /
# cherry-pick replays) like the attribution step below; skips when no python.
_gd="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$_gd" ] && [ ! -f "$_gd/MERGE_HEAD" ] && git symbolic-ref -q HEAD >/dev/null 2>&1; then
    _root="$(git rev-parse --show-toplevel)"
    if [ -x "$_root/venv/bin/python" ]; then _py="$_root/venv/bin/python"
    else
        _common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        _py="python3"
        [ -n "$_common" ] && [ -x "$(dirname "$_common")/venv/bin/python" ] && _py="$(dirname "$_common")/venv/bin/python"
    fi
    if [ ! -f "$_root/mcp/noctusai/cli.py" ]; then
        # Not a noctus checkout (e.g. a throwaway repo a test runs this hook
        # in): there is no product guide to guard. Say so, never fail on it.
        echo "commit-msg: product-guide co-change check skipped — no mcp/noctusai/cli.py in $_root." >&2
    elif command -v "$_py" >/dev/null 2>&1 || [ -x "$_py" ]; then
        if ! "$_py" "$_root/mcp/noctusai/cli.py" --check-product-guide-cochange \
                --commit-msg-file "$msg_file" --worktree-path "$_root"; then
            echo "commit-msg: PRODUCT-GUIDE-COCHANGE check FAILED. Commit aborted." >&2
            exit 1
        fi
    fi
fi

# ─── LGPD entry-removal gate (BLOCKING) ─────────────────────────────────────
# Keeper `check_lgpd_entry_removal` (`KB § PATTERNS/common/lgpd-entry-keeper.md`):
# a commit must not REMOVE an unresolved `- [ ]` entry from LGPD-WARNINGS.md
# (2026-10-10 incident: a conflict resolution replaced one). Override: a
# `LGPD-Entry-Removed: <concern or path prefix> — <reason>` trailer. Unlike the
# guide gate above this also runs on detached HEAD (a rebase conflict resolution
# is exactly where an entry gets lost) and mid-merge (merge-aware). Only fires
# when LGPD-WARNINGS.md is staged-different from HEAD; skips when no python.
_gd2="$(git rev-parse --git-dir 2>/dev/null || true)"
if [ -n "$_gd2" ]; then
    _root2="$(git rev-parse --show-toplevel)"
    if [ -f "$_root2/mcp/noctusai/cli.py" ] && ! git diff --cached --quiet -- LGPD-WARNINGS.md 2>/dev/null; then
        if [ -x "$_root2/venv/bin/python" ]; then _py2="$_root2/venv/bin/python"
        else
            _common2="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
            _py2="python3"
            [ -n "$_common2" ] && [ -x "$(dirname "$_common2")/venv/bin/python" ] && _py2="$(dirname "$_common2")/venv/bin/python"
        fi
        if command -v "$_py2" >/dev/null 2>&1 || [ -x "$_py2" ]; then
            if ! "$_py2" "$_root2/mcp/noctusai/cli.py" --check-lgpd-entry-removal \
                    --commit-msg-file "$msg_file" --worktree-path "$_root2"; then
                echo "commit-msg: LGPD-ENTRY-REMOVAL check FAILED. Commit aborted." >&2
                exit 1
            fi
        fi
    fi
fi

# ─── Doc-staleness COMMIT leg (BLOCKING — docs follow code in the same commit) ──
# Owner order 2026-11-04: the agent updates every doc covering the code it changes IN THE
# SAME COMMIT, unprompted. Keeper `check_doc_staleness` over the STAGED diff
# (`--doc-staged`): code a doc covers staged materially without that doc staged blocks
# with the exact fix-list; a `Docs-Reviewed: <doc> — <reason>` trailer in this message
# satisfies it (only this hook can read the message). Pre-push/CI re-check the range
# (backstop). Skips merges + detached HEAD (rebase/cherry-pick replays) and non-noctus
# checkouts. KB § PATTERNS/common/doc-staleness-gate.md.
if [ -z "${NOCTUS_SKIP_DOC_STALENESS:-}" ]; then
    _gd3="$(git rev-parse --git-dir 2>/dev/null || true)"
    if [ -n "$_gd3" ] && [ ! -f "$_gd3/MERGE_HEAD" ] && git symbolic-ref -q HEAD >/dev/null 2>&1; then
        _root3="$(git rev-parse --show-toplevel)"
        if [ -x "$_root3/venv/bin/python" ]; then _py3="$_root3/venv/bin/python"
        else
            _common3="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
            _py3="python3"
            [ -n "$_common3" ] && [ -x "$(dirname "$_common3")/venv/bin/python" ] && _py3="$(dirname "$_common3")/venv/bin/python"
        fi
        # The hook file is the PRIMARY checkout's (symlinked .git/hooks), but a worktree based before the
        # commit leg landed (fb5b288de) ships a cli.py without --doc-staged: calling it aborted EVERY commit
        # there (noctusai-59, 2026-11-04). Use the worktree's CLI when it knows the flag; otherwise the
        # primary checkout's CLI against this worktree (the rule that is live today), and say so.
        _cli3="$_root3/mcp/noctusai/cli.py"
        if [ -f "$_cli3" ] && ! grep -q -- "--doc-staged" "$_cli3" 2>/dev/null; then
            _common3b="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
            _pcli3="${_common3b:+$(dirname "$_common3b")/mcp/noctusai/cli.py}"
            if [ -n "$_pcli3" ] && grep -q -- "--doc-staged" "$_pcli3" 2>/dev/null; then
                echo "commit-msg: this worktree's cli.py predates the doc-staleness commit leg — checking with" \
                     "the primary checkout's CLI ($_pcli3). Rebase onto origin/dev to use your own." >&2
                _cli3="$_pcli3"
            else
                echo "commit-msg: doc-staleness commit leg unavailable (no cli.py here or in the primary checkout" \
                     "knows --doc-staged); pre-push and CI still check the range. Rebase onto origin/dev." >&2
                _cli3=""
            fi
        fi
        if [ -n "$_cli3" ] && [ -f "$_cli3" ] && { command -v "$_py3" >/dev/null 2>&1 || [ -x "$_py3" ]; }; then
            if ! "$_py3" "$_cli3" --check-doc-staleness --doc-staged \
                    --commit-msg-file "$msg_file" --worktree-path "$_root3"; then
                echo "commit-msg: DOC-STALENESS check FAILED — update + stage the listed docs, or add the" \
                     "'Docs-Reviewed: <doc> — <why still accurate>' trailer. Commit aborted." >&2
                exit 1
            fi
        fi
    fi
fi

# An empty message aborts the commit — never turn it into a trailer-only one.
grep -qvE '^[[:space:]]*(#.*)?$' "$msg_file" || exit 0

git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
[ -f "$git_dir/MERGE_HEAD" ] && exit 0

branch="$(git symbolic-ref -q --short HEAD 2>/dev/null)" || exit 0
[ -n "$branch" ] || exit 0

if git interpret-trailers --parse < "$msg_file" 2>/dev/null | grep -qi '^Noc-Branch:'; then
    exit 0
fi

if ! git interpret-trailers --in-place --if-exists doNothing \
        --trailer "Noc-Branch: $branch" "$msg_file" 2>/dev/null; then
    echo "commit-msg: WARNING — could not append Noc-Branch trailer; this commit will read as" \
         "'unattributed' (= unapproved) in noctus.dev.release stage=manifest." >&2
fi
exit 0
