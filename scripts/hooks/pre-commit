#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# pre-commit hook — [carve:hook] thin dispatcher
#
# Per `KB § PATTERNS/mcp-first-scripts.md`: git invokes this as a shell
# process directly (it cannot call MCP), so the ENTRY stays shell — but
# every step's LOGIC lives in the `noctus.dev.*` MCP toolkit, reached via
# `mcp/noctusai/cli.py --<flag>`. This file is a thin dispatcher, not a
# logic container. The former scripts/{sync-seed-template,update-kb-counts,
# stamp-seed-version,render-project-history,verify-kb-sync,propagate-*}
# were absorbed (scripts-mcp-absorption project).
#
# Steps (all pre-commit, no amend; auto-derived updates staged in-commit):
#   1. seed → template mirror            (cli --sync-seed-template)
#   2. KB auto-derived count blocks      (cli --update-kb-counts)
#   3. seed version stamp                (cli --stamp-seed-version)
#   3b. ledger → PROJECT-HISTORY.md      (cli --render-project-history)
#   4. KB ↔ CLAUDE.md sync (blocking)    (cli --verify-kb-sync)
#   4b. containerization propagation     (cli --propagate both --check)
#   5. §6↔§11 phase-state (blocking)     (cli --check-phase-state)
#   6. AST-outline-ability (blocking)    (cli --check-outlined)
#
# Bypass (not recommended): git commit --no-verify
# ──────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ─── venv-aware Python resolution (worktree-safe) ───────────────
# A `git worktree add` worktree has no venv of its own → fall back to
# the MAIN repo's venv via --git-common-dir. Final fallback: python3.
if [[ -x "$REPO_ROOT/venv/bin/python" ]]; then
    PY="$REPO_ROOT/venv/bin/python"
else
    MAIN_REPO_GITDIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    if [[ -n "$MAIN_REPO_GITDIR" ]]; then
        MAIN_REPO_ROOT=$(dirname "$MAIN_REPO_GITDIR")
        if [[ -x "$MAIN_REPO_ROOT/venv/bin/python" ]]; then
            PY="$MAIN_REPO_ROOT/venv/bin/python"
        fi
    fi
    PY="${PY:-${PYTHON:-python3}}"
fi
CLI="$REPO_ROOT/mcp/noctusai/cli.py"
have_py() { command -v "$PY" >/dev/null 2>&1 || [[ -x "$PY" ]]; }

# ─── 0-pre. Self-branching gate (BLOCKING, runs FIRST) ───────────
# Keeper `check_primary_checkout_commit`. `CLAUDE.md` §1 has said "🔴 ABSOLUTE:
# never work on dev" since self-branching mode existed, and it was violated in
# essentially every session anyway — because NOTHING FAILS AT COMMIT TIME. The
# commit succeeds, hooks pass, tests pass; local `dev` silently diverges from
# origin and the bill arrives much later as "Diverging branches can't be
# fast-forwarded" at integrate or deploy, where it reads as a git problem
# rather than the process slip it is.
#
# Deliberately the FIRST step: it costs ~50ms and its failure invalidates every
# check after it, so spending two minutes on gates before telling the committer
# they are on the wrong branch would be its own small cruelty.
#
# Ledger-only commits (project-history/*) are the sanctioned exception — the
# MCP tools push those to dev by design. Escape hatch, used loudly and rarely:
#   NOCTUS_ALLOW_PRIMARY_COMMIT=1 git commit ...
if have_py; then
    if ! "$PY" "$CLI" --check-primary-checkout-commit --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] self-branching gate FAILED. Commit aborted." >&2
        echo "[pre-commit]" >&2
        echo "[pre-commit] You are committing WORK on a shared branch in the PRIMARY checkout." >&2
        echo "[pre-commit] Move it to an isolated worktree:" >&2
        echo "[pre-commit]" >&2
        echo "[pre-commit]   noctus.dev.task_branch action=start slug=<kebab-task> confirm=true" >&2
        echo "[pre-commit]   # then commit inside .claude/worktrees/<slug>/ and integrate" >&2
        echo "[pre-commit]" >&2
        echo "[pre-commit] Already committed here by mistake? Nothing is lost:" >&2
        echo "[pre-commit]   git branch feat/<slug> && git reset --hard origin/<branch>" >&2
        echo "[pre-commit]   # your commits now live on feat/<slug>" >&2
        echo "[pre-commit]" >&2
        echo "[pre-commit] KB § PATTERNS/common/self-branching-mode.md" >&2
        exit 1
    fi
fi

# ─── 0. Version stamp echo (informational) ──────────────────────
# Surfaces the current VERSION file content at every commit so the
# committer (human or agent) sees which methodology version they're
# adding to. KB § PATTERNS/common/versioning.md.
if [[ -f "$REPO_ROOT/VERSION" ]]; then
    VERSION_STAMP=$(head -n1 "$REPO_ROOT/VERSION" | tr -d '[:space:]')
    if [[ -n "$VERSION_STAMP" ]]; then
        echo "[pre-commit] noc version: $VERSION_STAMP"
    fi
fi

# ─── 1. Seed → template mirror (only if seed/ files are staged) ──
if [[ -d "$REPO_ROOT/products/seed" ]] && have_py; then
    STAGED_SEED=$(git diff --cached --name-only -- products/seed/ 2>/dev/null || true)
    if [[ -n "$STAGED_SEED" ]]; then
        echo "[pre-commit] Seed product changed — syncing template..."
        "$PY" "$CLI" --sync-seed-template --worktree-path "$REPO_ROOT" 2>&1 | sed 's/^/[pre-commit] /'

        TEMPLATE_DIFF=$(git status --porcelain -- templates/product-seed/ 2>/dev/null || true)
        if [[ -n "$TEMPLATE_DIFF" ]]; then
            echo "[pre-commit] Staging template changes:"
            git add templates/product-seed/
            git status --porcelain -- templates/product-seed/ | sed 's/^/[pre-commit]   /'
        else
            echo "[pre-commit] Template already matches seed — no changes needed."
        fi
    fi
fi

# ─── 2. KB auto-derived counts ──────────────────────────────────
if have_py; then
    echo "[pre-commit] Updating KB auto-derived counts..."
    # Snapshot which KB docs are ALREADY dirty BEFORE the count refresh. This
    # lets us tell a MACHINE-generated count-block regen (a file that was clean
    # → dirtied solely by --update-kb-counts) apart from a CONCURRENT/human edit
    # (a file already dirty before we touched anything).
    DIRTY_BEFORE=$(git diff --name-only -- KNOWLEDGE-BASE/ CLAUDE.md 2>/dev/null || true)
    "$PY" "$CLI" --update-kb-counts --worktree-path "$REPO_ROOT" 2>&1 | sed 's/^/[pre-commit] /'

    # Restage count-refreshed docs. THREE cases per changed doc:
    #   (a) already staged in THIS commit → restage (count-refresh rides along).
    #   (b) NOT staged AND was CLEAN before --update-kb-counts → the change is
    #       100% the machine-generated count block (the hook itself just made
    #       it from a clean file) → SAFE to auto-stage. Fixes the "auto-derived
    #       count regen left dirty → blocks task_branch integrate/cleanup"
    #       recurrence (N=3, 2026-06-01) WITHOUT re-opening the 2026-05-19 bug.
    #   (c) NOT staged AND was ALREADY dirty before → a CONCURRENT/human edit
    #       (observed 4× 2026-05-19: a parallel session's KB doc swept into an
    #       unrelated commit). NOT ours to absorb — loudly SKIP (the committer
    #       stages it explicitly if intended).
    # A pre-commit hook must only ever stage what's in the commit OR what IT
    # itself derived from a clean file — never sweep a peer's in-progress edit.
    # KB § PATTERNS/project-execution.md (hook-scope rule).
    CHANGED_DOCS=$(git diff --name-only -- KNOWLEDGE-BASE/ CLAUDE.md 2>/dev/null || true)
    if [[ -n "$CHANGED_DOCS" ]]; then
        while IFS= read -r _doc; do
            [[ -z "$_doc" ]] && continue
            if git diff --cached --name-only -- "$_doc" 2>/dev/null | grep -qxF "$_doc"; then
                git add -- "$_doc" && echo "[pre-commit]   restaged (count-refresh, already in commit): $_doc"
            elif ! grep -qxF "$_doc" <<< "$DIRTY_BEFORE"; then
                git add -- "$_doc" && echo "[pre-commit]   auto-staged (machine count-refresh of a clean file): $_doc"
            else
                echo "[pre-commit]   SKIP $_doc — modified BEFORE this commit (concurrent/human edit; not ours to absorb; stage it explicitly if intended)" >&2
            fi
        done <<< "$CHANGED_DOCS"
    fi
else
    echo "[pre-commit] Skipping count refresh — python not found"
fi

# ─── 3. Seed version stamp (matches _version_static.py to current HEAD) ──
# Keeps the keeper drift-detector honest. Idempotent; gitignored output.
if have_py; then
    "$PY" "$CLI" --stamp-seed-version --worktree-path "$REPO_ROOT" 2>&1 | sed 's/^/[pre-commit] /' || true
fi

# ─── 3a. MAJOR-bump authorization gate ──────────────────────────────────
# Runs ONLY when VERSION is staged. Refuses MAJOR bumps without an explicit
# `.major-bump-authorized` marker. PATCH/MINOR within current MAJOR pass.
# KB § PATTERNS/common/versioning.md.
if have_py; then
    STAGED_VERSION=$(git diff --cached --name-only -- VERSION 2>/dev/null || true)
    if [[ -n "$STAGED_VERSION" ]]; then
        if ! "$PY" "$CLI" --check-version-bump --worktree-path "$REPO_ROOT" 2>&1 | sed 's/^/[pre-commit] /'; then
            echo "[pre-commit] VERSION bump REFUSED — see above." >&2
            exit 1
        fi
    fi
fi

# ─── 3b. Project-history ledger → PROJECT-HISTORY.md render ─────
# Re-render the human view when the ledger is staged OR modified by an
# earlier step in this hook chain. Output auto-stages so the human view
# never drifts from the structured source.
if have_py; then
    STAGED_LEDGER=$(git diff --cached --name-only -- project-history/ledger.ndjson 2>/dev/null || true)
    UNSTAGED_LEDGER=$(git status --porcelain -- project-history/ledger.ndjson 2>/dev/null || true)
    if [[ -n "$STAGED_LEDGER" || -n "$UNSTAGED_LEDGER" ]]; then
        echo "[pre-commit] Rendering project-history/PROJECT-HISTORY.md..."
        "$PY" "$CLI" --render-project-history --worktree-path "$REPO_ROOT" 2>&1 | sed 's/^/[pre-commit] /'
        CHANGED_HISTORY=$(git status --porcelain -- project-history/PROJECT-HISTORY.md 2>/dev/null || true)
        if [[ -n "$CHANGED_HISTORY" ]]; then
            echo "[pre-commit] Staging updated project-history/PROJECT-HISTORY.md"
            git add project-history/PROJECT-HISTORY.md
        fi
    fi
fi

# ─── 4. KB ↔ CLAUDE.md sync verification (blocking) ─────────────
if have_py; then
    echo "[pre-commit] Verifying KB sync..."
    if ! "$PY" "$CLI" --verify-kb-sync --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] KB sync check FAILED. Commit aborted." >&2
        echo "[pre-commit] Fix the broken pointers in CLAUDE.md or update KNOWLEDGE-BASE/INDEX.md." >&2
        exit 1
    fi
fi

# ─── 4a. Skills ↔ CLAUDE.md §2 sync (blocking, when skills OR router staged) ─
# When .claude/skills/* OR CLAUDE.md is staged, verify every on-disk skill
# is referenced in CLAUDE.md §2 'Procedure skills' line. Sibling of kb_sync
# applied to the procedural-skill surface (8-way sync #6). Severity high.
# KB § PATTERNS/common/eight-way-sync.md.
if have_py; then
    STAGED_SKILLS_OR_ROUTER=$(git diff --cached --name-only 2>/dev/null | grep -E '^(\.claude/skills/|CLAUDE\.md$)' || true)
    if [[ -n "$STAGED_SKILLS_OR_ROUTER" ]]; then
        echo "[pre-commit] Skills or CLAUDE.md staged — verifying skills↔router sync..."
        if ! "$PY" "$CLI" --check-skills-listed-in-router --worktree-path "$REPO_ROOT"; then
            echo "[pre-commit] Skills↔router sync FAILED. Commit aborted." >&2
            exit 1
        fi
    fi
fi

# ─── 4b. Containerization propagation drift (blocking, when seed staged) ─
# The seed at products/seed/ is canonical; per-product Dockerfiles +
# composes + overrides are GENERATED. If the canonical seed is staged
# but the generated files weren't re-propagated, they drift silently.
# `cli --propagate both --check` exits non-zero on drift.
if git diff --cached --name-only | grep -qE '^products/seed/(backend/Dockerfile|docker-compose\.(yml|override\.yml))$|^seed/docker/Dockerfile\.'; then
    if have_py && ! "$PY" "$CLI" --propagate both --check --worktree-path "$REPO_ROOT" >/dev/null 2>&1; then
        echo "[pre-commit] propagation drift — per-product files stale vs products/seed/." >&2
        echo "[pre-commit] Run: python mcp/noctusai/cli.py --propagate both   then re-stage. Commit aborted." >&2
        exit 1
    fi
    echo "[pre-commit] containerization propagation: in sync."
fi

# ─── 5. Phase-state consistency (blocking, only when PROJECT.md staged) ──
# Keeper `check_phase_state_consistency` + `KB § PATTERNS/project-
# execution.md § 2`. Catches §6 ↔ §11 drift before it commits. Basename
# match avoids false-firing on legacy `*-PROJECT.md` files.
STAGED_PROJECT_MD=$(git diff --cached --name-only 2>/dev/null | grep -E '(^|/)PROJECT\.md$' || true)
if [[ -n "$STAGED_PROJECT_MD" ]] && have_py; then
    echo "[pre-commit] Checking §6 ↔ §11 phase-state consistency..."
    if ! "$PY" "$CLI" --check-phase-state --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] Phase-state check FAILED. Commit aborted." >&2
        echo "[pre-commit] Fix the §6 live state (tick checkboxes / flip header / add Improvements block) before committing." >&2
        exit 1
    fi
fi

# ─── 6. Outline-ability (blocking, only when source files staged) ───────
# Keeper `check_files_outlined` + `KB § PATTERNS/ast.md § Always-outline-
# able platform`. Every staged .py/.ts/.tsx MUST be AST-outline-able.
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.(py|pyi|ts|tsx|js|jsx|mjs|cjs)$' || true)
if [[ -n "$STAGED_SRC" ]] && have_py; then
    echo "[pre-commit] Checking staged files are AST-outline-able..."
    if ! "$PY" "$CLI" --check-outlined --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] Outline-ability check FAILED. Commit aborted." >&2
        echo "[pre-commit] A staged source file can't be AST-read (SyntaxError/parse). Fix it; run: python mcp/noctusai/cli.py --scan-outlined" >&2
        exit 1
    fi
fi

# ─── 6b. hashlib usedforsecurity (blocking, only when backend-app/seed-lib .py staged) ──
# Keeper `check_hashlib_usedforsecurity` + `KB § PATTERNS/backend/backend.md
# § Recurring CI-hygiene standards`. A weak-hash call (hashlib.md5/sha1/new)
# for a non-security use MUST pass usedforsecurity=False, or Bandit B324 (High)
# hard-fails CI. Catch it at authoring time instead of reactively in CI (N=4).
STAGED_BANDIT_PY=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(products/[^/]+/backend/app/.*\.py|seed/lib/backend/noctusai_lib/.*\.py)$' || true)
if [[ -n "$STAGED_BANDIT_PY" ]] && have_py; then
    echo "[pre-commit] Checking weak-hash usedforsecurity= (Bandit B324)..."
    if ! "$PY" "$CLI" --check-hashlib-usedforsecurity --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] hashlib-usedforsecurity check FAILED. Commit aborted." >&2
        echo "[pre-commit] Add usedforsecurity=False to the flagged hashlib.md5/sha1 call (non-security use), or use sha256+ for real security." >&2
        exit 1
    fi
fi

# ─── 6b-ter. Unresolved merge-conflict markers (blocking, staged files) ───
# Keeper `check_conflict_markers`. A file committed mid-conflict is a syntax
# error in every language we ship, and it is NOT reliably caught by eye: git
# uses an eight-character marker variant with a `path:` suffix when the
# conflict is in a RENAMED file, which is what put five marker lines into
# migration 042 on `dev` during the 040→042 renumber on 2026-08-03. The header
# sat in a comment block, so the test suite (which asserts on the SQL body)
# and the live schema (applied earlier from a clean blob) both stayed green —
# it would only have surfaced when a fresh environment replayed the migrations.
# Scoped to the STAGED set so the hook stays fast; CI sweeps the whole tree.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | paste -sd, - || true)
if [[ -n "$STAGED_ALL" ]] && have_py; then
    if ! "$PY" "$CLI" --check-conflict-markers --paths "$STAGED_ALL" --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] conflict-markers check FAILED. Commit aborted." >&2
        echo "[pre-commit] A staged file still carries unresolved merge-conflict markers." >&2
        echo "[pre-commit] Open the file, keep the side you intended, delete the marker lines." >&2
        exit 1
    fi
fi

# ─── 6b-bis. Migration-number collision (blocking, only when a migration ──
# is staged) ──────────────────────────────────────────────────────────────
# Keeper `check_migration_number_collision`. Two migrations sharing a numeric
# prefix have undefined apply-order. The number cannot be picked safely from
# the working tree alone: `ls migrations/` and `git log origin/dev` are both
# blind to an UNPUSHED sibling branch, so three concurrent sessions on
# 2026-08-03 each reserved a number correctly by local evidence and still
# collided (two claimed 040; a third shipped a duplicate 041 to dev). A
# second, DIFFERENT blind spot bit again on 2026-08-13: a migration merged by
# a parallel worktree BEFORE this worktree rebased was invisible to disk AND
# to Leg B alike (`origin/dev`'s own advance isn't captured by either).
# Leg A (duplicate on disk) blocks; Leg B (cross-branch claim) warns — this
# is the LAST-RESORT backstop; the PICK-CORRECTLY-UP-FRONT half of the fix is
# `noctus.dev.next_migration_number` / `noctus.dev.scaffold_migration`
# (unions disk + origin/dev + every local branch) and a SECOND backstop at
# `noctus.dev.task_branch(action='integrate')` that BLOCKS (not warns) on
# what this pre-commit gate only catches if the engineer ever commits.
STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^products/[^/]+/backend/migrations/.*\.sql$' || true)
if [[ -n "$STAGED_MIGRATIONS" ]] && have_py; then
    echo "[pre-commit] Migration staged — checking for a number collision..."
    if ! "$PY" "$CLI" --check-migration-number-collision --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] migration-number-collision check FAILED. Commit aborted." >&2
        echo "[pre-commit] Two migrations share a numeric prefix — apply-order is undefined." >&2
        echo "[pre-commit] Renumber yours to the next free number via the MCP tool" >&2
        echo "[pre-commit] noctus.dev.next_migration_number (product_slug=<product>) — it" >&2
        echo "[pre-commit] unions this worktree's disk, freshly-fetched origin/dev (catches a" >&2
        echo "[pre-commit] parallel worktree's migration that already merged, 2026-08-13), AND" >&2
        echo "[pre-commit] every local branch (catches an unpushed sibling's commit, 2026-08-03)" >&2
        echo "[pre-commit] — this is the ONLY check that sees unpushed sibling branches, the same" >&2
        echo "[pre-commit] reason this pre-commit gate exists. noctus.dev.scaffold_migration calls" >&2
        echo "[pre-commit] it internally, so a freshly-scaffolded migration is never wrong here." >&2
        exit 1
    fi
fi

# ─── 6c. Prod-exposure consent gate (blocking, only when a prod-exposure ──
# surface OR a consent record is staged) ─────────────────────────────────
# Keeper `check_prod_exposure_consent` + `KB § PATTERNS/devops/prod-
# exposure-consent.md`. A product's FIRST arrival on deploy/fleet/docker-
# compose.prod.yml, deploy/tunnel/ingress.yml, or ALL_SLUGS in scripts/
# infra/build-and-push.sh IS the production-promotion decision (the fleet
# runs :latest built from main — no later gate reviews this again). Also
# refuses a deploy/consent/*.prod.yml staged alongside any other path
# ── tunnel ingress is the SINGLE SOURCE OF TRUTH ─────────────────────────────
# deploy/tunnel/ingress.yml says so in its first line; this makes it true for
# the derived artifact that lives in the repo. 2026-08-10: the committed
# template was 2 routes stale AND the live VPS config was a gitignored
# deploy-local copy nothing derived from, so editing the "canonical" file
# changed nothing live, silently.
STAGED_TUNNEL=$(git diff --cached --name-only 2>/dev/null | grep -E '^deploy/tunnel/(ingress\.yml|config\.yml\.template)$' || true)
if [[ -n "$STAGED_TUNNEL" ]] && have_py; then
    echo "[pre-commit] tunnel ingress staged — verifying the snapshot is derived..."
    if ! "$PY" "$CLI" --check-tunnel-ingress-snapshot-sync --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] TUNNEL-INGRESS drift. Regenerate the template from ingress.yml (noctus.dev.tunnel_config action='render'), then apply to the live VPS with action='apply' confirm=True. A canonical file nothing derives from is a comment, not a contract. See KB § PATTERNS/devops/tunnel-ingress-source-of-truth.md." >&2
        exit 1
    fi
fi

# (consent commits must be isolated).
STAGED_PROD_EXPOSURE=$(git diff --cached --name-only 2>/dev/null | grep -E '^(deploy/fleet/docker-compose\.prod\.yml|deploy/tunnel/ingress\.yml|scripts/infra/build-and-push\.sh|deploy/consent/.*\.prod\.yml)$' || true)
if [[ -n "$STAGED_PROD_EXPOSURE" ]] && have_py; then
    echo "[pre-commit] prod-exposure surface staged — verifying consent gate..."
    if ! "$PY" "$CLI" --check-prod-exposure-consent --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] PROD-EXPOSURE-CONSENT check FAILED. Commit aborted." >&2
        echo "[pre-commit] Registering a product on a prod-exposure surface IS the promotion decision. deploy/consent/<slug>.prod.yml must land first, in its own commit. The decision is the USER's: either they hand-author the record, or they type the canonical phrase in-session ('noctus.dev.prod_consent action=challenge slug=<slug>') and an agent transcribes it via action=author — which REFUSES unless that phrase is found in the harness-written session transcript. See KB § PATTERNS/devops/prod-exposure-consent.md." >&2
        exit 1
    fi
fi

# ─── 6d. Hardcoded product-slug-set gate (blocking-on-high, only when a ──
# build/CI script or a seed test is staged) ──────────────────────────────
# Keeper `check_hardcoded_product_slug_set` + `KB § PATTERNS/devops/product-
# lockfile-and-slug-drift.md`. A hand-copied product-slug literal (a bash
# `ALL_SLUGS=(...)` array in scripts/infra/*.sh, or a frozen Python
# tuple/set/list in seed/lib/backend/tests/) drifts from the live fleet the
# moment a product is added/removed/never-deployed — the 2026-07-22
# knowledge-extractor fleet-build outage. Catch it locally, before CI.
STAGED_SLUG_SET=$(git diff --cached --name-only 2>/dev/null | grep -E '^(scripts/infra/.*\.sh|seed/lib/backend/tests/.*\.py|start\.sh)$' || true)
if [[ -n "$STAGED_SLUG_SET" ]] && have_py; then
    echo "[pre-commit] build script / seed test staged — checking for a hardcoded product-slug set..."
    if ! "$PY" "$CLI" --check-hardcoded-product-slug-set --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] HARDCODED-PRODUCT-SLUG-SET check FAILED. Commit aborted." >&2
        echo "[pre-commit] Derive the product/slug set from the live fleet (deploy/fleet/docker-compose.prod.yml or parse_products_registry()) instead of a hand-copied literal — it WILL drift. See KB § PATTERNS/devops/product-lockfile-and-slug-drift.md." >&2
        exit 1
    fi
fi

# ─── 6e. Product lockfile ↔ seed dep sync gate (blocking, only when a ────
# product package.json/lockfile or a seed frontend package changed) ──────
# Keeper `check_product_lockfile_dep_sync` + `KB § PATTERNS/devops/product-
# lockfile-and-slug-drift.md`. A product's package-lock.json can go stale
# relative to its OWN package.json (or the seed-organ imports it transitively
# needs) — `npm ci` in CI/a clean container then fails to resolve the import.
# N=3 in one session (2026-07-22): @dnd-kit, recharts/@radix-ui-react-tabs,
# and the sibling ALL_SLUGS class above. Catch it before it ships.
STAGED_LOCKFILE_DEPS=$(git diff --cached --name-only 2>/dev/null | grep -E '^(products/[^/]+/frontend/package(-lock)?\.json|seed/lib/frontend/(package\.json|src/.*\.tsx?)|seed/framework/frontend/package\.json)$' || true)
if [[ -n "$STAGED_LOCKFILE_DEPS" ]] && have_py; then
    echo "[pre-commit] product/seed frontend package changed — checking lockfile ↔ package.json dep sync..."
    if ! "$PY" "$CLI" --check-product-lockfile-dep-sync --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] PRODUCT-LOCKFILE-DEP-SYNC check FAILED. Commit aborted." >&2
        echo "[pre-commit] A required dep is declared in package.json but missing from package-lock.json's resolved snapshot — npm ci will not install it. Run 'npm install <dep>' SCOPED to the missing dep(s) in the affected product's frontend/ (a bare 'npm install' re-resolves the whole tree — hundreds of unrelated version bumps). See KB § PATTERNS/devops/product-lockfile-and-slug-drift.md." >&2
        exit 1
    fi
fi

# ─── 6e-bis. Exact-override freeze gate (blocking, only when an npm ──────
# manifest is staged) ────────────────────────────────────────────────────
# Keeper `check_override_is_range` + `KB § PATTERNS/devops/product-lockfile-
# and-slug-drift.md § Fourth axis`. An EXACT version in npm `overrides` wins
# over every peer range and direct dep, can never be moved by `npm install`,
# and is invisible in the dependency list — while adding NO reproducibility,
# because package-lock.json already pins the resolution for `npm ci`. The seed
# copies overrides into 12 products, so one pin freezes the fleet. N=3 on
# 2026-08-11 (postcss, ws, react-router), each introduced by a *security*
# cleanup: the CVE fix created the freeze. Catch the 4th at commit time.
STAGED_NPM_MANIFEST=$(git diff --cached --name-only 2>/dev/null | grep -E '^(products/[^/]+/frontend/package\.json|seed/(lib|framework)/frontend/package\.json|templates/product-seed/frontend/package\.json|mcp/noctusai/node/package\.json)$' || true)
if [[ -n "$STAGED_NPM_MANIFEST" ]] && have_py; then
    echo "[pre-commit] npm manifest staged — checking overrides are ranges, not exact pins..."
    if ! "$PY" "$CLI" --check-override-is-range --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] OVERRIDE-IS-RANGE check FAILED. Commit aborted." >&2
        echo "[pre-commit] Use a RANGE (e.g. \"^8.5.18\" instead of \"8.5.18\") — same CVE floor, same major, still upgradeable. package-lock.json is already the freeze; an exact override only removes your ability to patch. If the freeze is deliberate, add a 'pin-ok' rationale comment. See KB § PATTERNS/devops/product-lockfile-and-slug-drift.md § Fourth axis." >&2
        exit 1
    fi
fi

# ─── 6e-ter. Dependabot per-product coverage gate (blocking, only when ────
# dependabot.yml OR a product frontend package.json changed) ─────────────
# Keeper `check_dependabot_product_coverage` + `KB § PATTERNS/devops/product-
# lockfile-and-slug-drift.md`. `.github/dependabot.yml` is a hand-maintained
# per-product list — same class as 6d/6e above. `igig` (live since
# 2026-08-09), `orbity`, and `products/seed` had NO npm block at all (zero
# Dependabot coverage, silently) until 2026-08-13. A NEW PRODUCT is the
# trigger that matters most here, and that's the case where dependabot.yml
# itself is NOT staged — so this also fires on any products/*/frontend/
# package.json (a brand-new product's manifest).
STAGED_DEPENDABOT=$(git diff --cached --name-only 2>/dev/null | grep -E '^(\.github/dependabot\.yml|products/[^/]+/frontend/package\.json)$' || true)
if [[ -n "$STAGED_DEPENDABOT" ]] && have_py; then
    echo "[pre-commit] dependabot.yml / product frontend manifest staged — checking dependabot per-product coverage..."
    if ! "$PY" "$CLI" --check-dependabot-product-coverage --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] DEPENDABOT-PRODUCT-COVERAGE check FAILED. Commit aborted." >&2
        echo "[pre-commit] Run 'python mcp/noctusai/cli.py --refresh-dependabot-coverage' — it adds the missing npm block(s)/guard entries and preserves every existing comment. See KB § PATTERNS/devops/product-lockfile-and-slug-drift.md." >&2
        exit 1
    fi
fi

# ─── 6e-quater. CI test-matrix coverage gate (blocking, only when ─────────
# test.yml OR product test files changed) ─────────────────────────────────
# Keeper `check_ci_test_matrix_coverage` + `KB § PATTERNS/devops/product-
# lockfile-and-slug-drift.md`. `.github/workflows/test.yml`'s per-product
# `matrix: product:` lists are the SIBLING hand-maintained list found while
# building the dependabot gate — igig/orbity/seed backend suites and
# orbity's frontend suite were never collected by CI (2026-08-13). Fires on
# a NEW backend test file too (a product's first test is exactly the commit
# that should join the matrix).
STAGED_CI_MATRIX=$(git diff --cached --name-only 2>/dev/null | grep -E '^(\.github/workflows/test\.yml|products/[^/]+/backend/tests/.*\.py|products/[^/]+/frontend/src/.*\.test\.tsx?)$' || true)
if [[ -n "$STAGED_CI_MATRIX" ]] && have_py; then
    echo "[pre-commit] test.yml / product test file staged — checking CI matrix coverage..."
    if ! "$PY" "$CLI" --check-ci-test-matrix-coverage --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] CI-TEST-MATRIX-COVERAGE check FAILED. Commit aborted." >&2
        echo "[pre-commit] Run 'python mcp/noctusai/cli.py --refresh-ci-matrix-coverage' — it appends the missing product(s) to the matrix and preserves every existing line/comment. See KB § PATTERNS/devops/product-lockfile-and-slug-drift.md." >&2
        exit 1
    fi
fi

# ─── 6f. Lying-loading-state gate (advisory, only when a product frontend ──
# .tsx changed) ──────────────────────────────────────────────────────────
# Keeper `check_lying_loading_state` + `KB § PATTERNS/frontend/lying-
# loading-state.md`. TanStack Query v5 `isLoading` is FALSE during a
# background refetch (`isLoading === isPending && isFetching`); a `loading=`/
# `isLoading=` JSX prop or a hand-rolled `!X.isLoading && ... .length === 0`
# guard falls through to its EMPTY branch mid-refetch — "no data" over live
# data. Live incident 2026-07-21/22 (social-wiring Leads, 12,177 leads / 28
# brokers, fixed b0cb47b1 + ae9087ce). Severity warning — observe-first
# cadence on a brand-new detector (never blocks a commit); scoped to staged
# .tsx under products/*/frontend/src so backend-only commits pay nothing.
STAGED_LOADING_TSX=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^products/[^/]+/frontend/src/.*\.tsx$' || true)
if [[ -n "$STAGED_LOADING_TSX" ]] && have_py; then
    echo "[pre-commit] product frontend .tsx staged — checking for lying-loading-state (TanStack v5 isLoading)..."
    "$PY" "$CLI" --check-lying-loading-state --worktree-path "$REPO_ROOT" || true
    # advisory only (severity warning) — the CLI itself always exits 0 for
    # this gate; never block the commit on a brand-new detector's findings.
fi

# ─── 6g. PostgREST schema-qualified table gate (blocking, only when backend ──
# Python changed) ────────────────────────────────────────────────────────
# Keeper `check_postgrest_schema_qualified_table` +
# `KB § PATTERNS/backend/postgrest-schema-targeting.md`. A Supabase client is
# ALREADY schema-bound, so `.table(name)` resolves RELATIVE to that schema and
# never reads a dot as a separator. `f"{deps._db.schema}.invitations"` therefore
# asks for `<schema>.<schema>.<table>` → 500 "Could not find the table ... in
# the schema cache" on EVERY call, phrased so it reads as a missing migration.
# Live incident 2026-08-06: every team invite across the 9 products mounting
# the seed team router, green in CI ~3 months (MockSupabaseClient keys tables
# by whatever string it is handed, so the qualified fixtures agreed with the
# qualified caller). BLOCKING, severity high — a qualified name never works.
STAGED_BACKEND_PY=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(seed/.*|products/[^/]+/backend/.*)\.py$' || true)
if [[ -n "$STAGED_BACKEND_PY" ]] && have_py; then
    echo "[pre-commit] backend .py staged — checking for schema-qualified PostgREST table names..."
    if ! "$PY" "$CLI" --check-postgrest-schema-qualified-table --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] POSTGREST-SCHEMA-QUALIFIED-TABLE check FAILED. Commit aborted." >&2
        echo "[pre-commit] The Supabase client already carries its schema — pass the BARE table name ('invitations', not f\"{schema}.invitations\"). See KB § PATTERNS/backend/postgrest-schema-targeting.md." >&2
        exit 1
    fi
fi

# ─── 6h. PostgREST unbounded-query gate (advisory, only when backend Python ──
# changed) ──────────────────────────────────────────────────────────────
# Keeper `check_postgrest_unbounded_query` + `KB § PATTERNS/backend/
# postgrest-row-cap.md`. PostgREST silently caps ANY select at `db-max-rows`
# (Supabase default 1 000) — no error, no warning. SEVEN instances of this
# shipped to production in one session (2026-08-13/14: portal-roi reported
# 1 000 leads instead of 13 255; a backfill silently repointed 1 000 of
# 1 365 negociações; a review queue dropped 177 of 1 177 rows), plus an
# `.in_()` fed an unbatched ~1 000-item collection ("JSON could not be
# generated", a bare 400) — that shape is severity `warning` (structurally
# risky regardless of table cardinality); the select-shape above is severity
# `info` (risk is a function of a row count this keeper cannot see, so it
# does not dilute the warning tier). Deliberately heuristic — observe-first
# cadence on a brand-new detector at EITHER tier (never blocks a commit,
# matches `check_lying_loading_state`'s cadence); scoped to staged backend
# .py so frontend-only commits pay nothing. Reuses `$STAGED_BACKEND_PY`
# computed for the schema-qualified gate above.
if [[ -n "$STAGED_BACKEND_PY" ]] && have_py; then
    echo "[pre-commit] backend .py staged — checking for unbounded PostgREST queries..."
    "$PY" "$CLI" --check-postgrest-unbounded-query --worktree-path "$REPO_ROOT" || true
    # advisory only (both severity tiers) — the CLI itself always exits 0
    # for this gate; never block the commit on a brand-new heuristic detector's
    # findings.
fi

# ─── 7. CLAUDE.md router discipline (blocking, only when CLAUDE.md staged) ──
# Keeper `check_claude_md_router` + `KB § PATTERNS/claude-md-router-discipline.md`.
# CLAUDE.md is the always-on router: §1 rules stay one-line (rule + `→` pointer),
# no inlined bodies, whole file under the word budget. Re-bloat is gated.
STAGED_CLAUDE_MD=$(git diff --cached --name-only 2>/dev/null | grep -E '^CLAUDE\.md$' || true)
if [[ -n "$STAGED_CLAUDE_MD" ]] && have_py; then
    echo "[pre-commit] Checking CLAUDE.md router discipline..."
    if ! "$PY" "$CLI" --check-claude-md-router --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] CLAUDE.md router check FAILED. Commit aborted." >&2
        echo "[pre-commit] Keep §1 rules one-line (rule + → pointer); move bodies to the KB pointer / a skill." >&2
        exit 1
    fi
fi

# ─── 8. Keeper-pattern cache auto-refresh (the mirror contract) ──
# User mandate 2026-05-26 — "the memory should always be the keeper mirror."
# When compliance.py is modified, the local cache MUST refresh so doc-authoring
# agents query the live patterns, not yesterday's. The lazy query-time leg +
# `check_keeper_cache_freshness` keeper are the safety nets; THIS hook is the
# eager refresh. KB § PATTERNS/keeper-pattern-cache.md.
STAGED_COMPLIANCE=$(git diff --cached --name-only 2>/dev/null | grep -E '^mcp/noctusai/tools/noctus/dev/compliance\.py$' || true)
if [[ -n "$STAGED_COMPLIANCE" ]] && have_py; then
    echo "[pre-commit] compliance.py staged — refreshing keeper-pattern cache (mirror contract)..."
    if ! "$PY" "$CLI" --refresh-keeper-cache --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] keeper-cache refresh FAILED — investigate before committing." >&2
        exit 1
    fi
fi

# ─── 9. Agent-context cache auto-refresh (Phase B 2026-05-26) ──
# Sibling of the keeper-pattern cache. When an agent file OR any KB doc is
# staged, the local agent-context cache MUST refresh so the cached bundles
# mirror live agent.md + owned_kb files. Lazy query-time rebuild +
# check_agent_context_cache_freshness keeper are the safety nets.
# KB § PATTERNS/agent-context-architecture.md § Keeper enforcement.
STAGED_AGENT_OR_KB=$(git diff --cached --name-only 2>/dev/null | grep -E '^(\.claude/agents/.+\.md|KNOWLEDGE-BASE/.+\.md)$' || true)
if [[ -n "$STAGED_AGENT_OR_KB" ]] && have_py; then
    echo "[pre-commit] agent.md or KB doc staged — refreshing agent-context cache (mirror contract)..."
    if ! "$PY" "$CLI" --refresh-agent-context-cache --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] agent-context-cache refresh FAILED — investigate before committing." >&2
        exit 1
    fi
fi

# ─── Embedding caches (kb / code / corpus / memory) — NOT refreshed on commit ──
# These four are OpenAI-backed (slow, network round-trips). They refresh at
# PRE-PUSH + POST-MERGE + POST-CHECKOUT only — never on commit. Rationale: an
# embedding refresh on every commit taxes the inner loop for caches that are
# advisory (semantic-search enrichment) and self-heal at the next push/merge
# boundary; the correctness gates (kb_sync, router, 8-way-sync) stay synchronous
# regardless. Pre-commit keeps only the FAST structural mirrors — keeper-pattern
# (leg 8), agent-context (leg 9), auto-improvement (leg 10), and noc-graph
# (leg 9f below) — so methodology-surface changes stay fix-on-contact.
# (Supersedes the 2026-05-27 "every cache every boundary" rule for the embedding
# caches per user mandate 2026-05-29.) KB § PATTERNS/common/cache-auto-freshness.md.

# ─── 9f. noc-graph cache auto-refresh (8th keeper-mirror; structured graph) ──
# Parity with post-merge/post-checkout/pre-push: when ANY graph-input surface
# is staged (code / KB / harness / landscape / cli / auto-improvement /
# project-history) the graph nodes+edges MUST regenerate so orientation reads
# never serve a stale structure. `--refresh-noc-graph` is only-stale
# (per-aggregate-source-sha skip) so this is a no-op when nothing graph-shaped
# changed. The graph BUILDER code itself lives under seed/ + mcp/ and is part
# of that source corpus, so an extractor change busts the sha and rebuilds too.
# Belt-and-suspenders with the lazy-on-read `_ensure_fresh_on_read` gate.
# KB § PATTERNS/architect/noc-graph.md · KB § PATTERNS/common/cache-auto-freshness.md.
# CACHE-TIMING RELOCATION (2026-06-01): the noc-graph rebuild is DEFERRED out of
# intermediate commits — it was the multi-minute per-commit lag. The graph now
# rebuilds ONLY at the dev-delivery push (pre-push, gated on dev destination) and
# lazily on read (`noctus.graph.* _ensure_fresh_on_read`). Intermediate worktree
# commits never pay it; check_noc_graph_cache_freshness is advisory so a stale
# graph never blocks. KB § PATTERNS/architect/branch-tree-tracking.md §3 (cache-refresh-timing rule).
:  # noc-graph refresh intentionally NOT run on intermediate commits

# ─── 10. Auto-improvement cache auto-refresh (Phase B 2026-05-26) ──
# Third in the keeper-mirror family. When the auto-improvement ndjson is
# staged, the cache MUST refresh so consult-before-editing returns live
# observations. KB § PATTERNS/scoped-auto-improvement.md.
STAGED_AUTO_IMPROVEMENT=$(git diff --cached --name-only 2>/dev/null | grep -E '^project-history/auto-improvement\.ndjson$' || true)
if [[ -n "$STAGED_AUTO_IMPROVEMENT" ]] && have_py; then
    echo "[pre-commit] auto-improvement.ndjson staged — refreshing auto-improvement cache (mirror contract)..."
    if ! "$PY" "$CLI" --refresh-auto-improvement-cache --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] auto-improvement-cache refresh FAILED — investigate before committing." >&2
        exit 1
    fi
fi

# ─── 10c. Vector-costs: DRAIN the spool, then auto-stage the ledger ───────────
# `project-history/vector-costs.ndjson` is an APPEND-ONLY machine-generated
# telemetry ledger — embed/cost-log tools append to it; it is NEVER hand-
# authored. UNLIKE CLAUDE.md/KB docs, the concurrent-writer guard of leg 2 does
# NOT apply: appended cost lines are independent + ownership-free, so folding
# another worktree's appended line into THIS commit is harmless and desired.
#
# 2026-08-11 — THIS IS THE ONLY PLACE THE TRACKED LEDGER IS EVER WRITTEN.
# Cost rows now land in an untracked write-ahead spool
# (`project-history/.vector-costs-spool.ndjson`, gitignored) whenever they are
# produced. Here — the one moment a real commit is being built — we fold them
# into the ledger and stage it, so they ride along with whatever is being
# committed. The pre-push sweep that used to make a separate `chore(cost-log)`
# commit is GONE: that commit could not join the push that created it, so it rode
# the NEXT push, moved the branch tip, and cancelled the in-flight CI run for the
# sha that mattered. Drain-then-stage removes the ledger-only commit entirely.
# Best-effort throughout — telemetry must never block a commit.
# KB § PATTERNS/common/vector-cost-tracking.md § Fold-into-commit.
if have_py; then
    "$PY" "$CLI" --vector-costs-drain-spool 2>&1 | sed 's/^/[pre-commit] cost-log: /' || true
fi
if have_py && git status --porcelain -- project-history/vector-costs.ndjson 2>/dev/null | grep -q .; then
    git add -- project-history/vector-costs.ndjson \
      && echo "[pre-commit] auto-staged vector-costs.ndjson (append-only ledger — rides along by construction)"
fi

# ─── 11. Vector-costs ledger sanity (2026-05-26, post-verify-pass) ──
# The vector-costs.ndjson append-only ledger MUST stay parseable. If a
# concurrent writer races and produces a malformed line, downstream
# consumers (cost-report, calibration) silently degrade. Light sanity:
# every non-empty line must be valid JSON with the expected keys.
# Severity warning — surface, don't block, since the ledger is advisory.
STAGED_VECTOR_COSTS=$(git diff --cached --name-only 2>/dev/null | grep -E '^project-history/vector-costs\.ndjson$' || true)
if [[ -n "$STAGED_VECTOR_COSTS" ]] && have_py; then
    if ! "$PY" -c "
import json, pathlib, sys
p = pathlib.Path('project-history/vector-costs.ndjson')
bad = 0
for i, line in enumerate(p.read_text().splitlines(), 1):
    if not line.strip(): continue
    try:
        e = json.loads(line)
        for k in ('ts', 'namespace', 'estimated_cost_usd'):
            if k not in e:
                print(f'  line {i}: missing key {k!r}', file=sys.stderr); bad += 1
    except json.JSONDecodeError as ex:
        print(f'  line {i}: not JSON ({ex})', file=sys.stderr); bad += 1
sys.exit(0 if bad == 0 else 1)
"; then
        echo "[pre-commit] ⚠ vector-costs.ndjson has malformed line(s) — surface, not blocking." >&2
    fi
fi

# ─── 12. Eight-way sync gate when ANY methodology surface is staged ──
# CLAUDE.md / MEMORY.md / .claude/agents/ / KNOWLEDGE-BASE/ / CONTEXTUALIZE.md
# / .claude/skills/ / .claude/commands/ — if any are staged, the 8-way sync
# must hold. Calls the composition keeper (now 8 surfaces after the
# 2026-05-28 7→8 promotion: .claude/cache/ added per cache-as-agent-tool).
# Severity high (the keeper itself dispatches sub-keepers with their own
# severities). KB § PATTERNS/common/eight-way-sync.md.
STAGED_EIGHT_WAY=$(git diff --cached --name-only 2>/dev/null | grep -E '^(CLAUDE\.md$|\.claude/agents/|\.claude/skills/|\.claude/commands/|KNOWLEDGE-BASE/|CONTEXTUALIZE\.md$)' || true)
if [[ -n "$STAGED_EIGHT_WAY" ]] && have_py; then
    echo "[pre-commit] Methodology surface staged — verifying 8-way sync..."
    if ! "$PY" "$CLI" --check-eight-way-sync --worktree-path "$REPO_ROOT"; then
        echo "[pre-commit] 8-way sync FAILED. Commit aborted." >&2
        echo "[pre-commit] See KB § PATTERNS/common/eight-way-sync.md for what must move together." >&2
        exit 1
    fi
fi

# ─── 13. KB-baselines staleness check (advisory, when KB changes) ──
# When KB markdown changes, the kb_validate_owns_kb findings may shift
# (vector centroids move). If a baseline exists AND the change is large,
# we surface "consider re-ratifying" — but never block. Severity warning.
# KB § PATTERNS/common/vector-baseline.md.
# `grep -c` is the single source of truth for the count; `|| true` swallows
# grep's exit-1 when no matches (under set -o pipefail the prior pipeline
# `grep -E … | wc -l | tr -d ' ' || echo 0` produced "0\n0" which broke
# `[[ -gt 5 ]]` with "syntax error in expression"). One number out, period.
STAGED_KB_FOR_BASELINE=$(git diff --cached --name-only 2>/dev/null | grep -cE '^KNOWLEDGE-BASE/.+\.md$' || true)
: "${STAGED_KB_FOR_BASELINE:=0}"
if [[ "$STAGED_KB_FOR_BASELINE" -gt 5 ]] && have_py; then
    # Heuristic: 5+ KB docs staged in one commit = large KB change.
    # Suggest the user check baselines (no exit code).
    "$PY" "$CLI" --check-kb-semantic-drift 2>&1 | sed 's/^/[pre-commit] /' || true
fi

echo "[pre-commit] OK"
exit 0
