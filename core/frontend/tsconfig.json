{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitAny": false,
        "noFallthroughCasesInSwitch": false,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@noctusai/shared/*": [
                "../../seed/frontend/lib/src/*"
            ],
            "@noctusai/shared": [
                "../../seed/frontend/lib/src/index.ts"
            ],
            "@noctusai/seed/*": [
                "../../seed/frontend/framework/src/*"
            ],
            "@noctusai/seed": [
                "../../seed/frontend/framework/src/index.ts"
            ]
        },
        "baseUrl": "."
    },
    "include": [
        "src",
        "../../seed/frontend/lib/src",
        "../../seed/frontend/framework/src"
    ]
}
