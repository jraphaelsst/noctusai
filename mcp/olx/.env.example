# mcp/olx/.env — connector-owned secrets (gitignored; copy to .env)
#
# Two independent capabilities. Either half works without the other.

# --- INBOUND: the lead webhook OLX POSTs to us -----------------------------
# The per-CRM secret OLX issues at homologation. It is the second half of
# `Basic base64("vivareal:<SECRET_KEY>")`. ONE key per CRM, not per
# advertiser — the same value the product receiver validates against.
OLX_WEBHOOK_SECRET=
# Our own receiver, the URL registered with OLX. olx.webhook.simulate
# POSTs here. Point it at localhost while developing.
OLX_RECEIVER_URL=http://localhost:8000/api/portals/olx/leads

# --- OUTBOUND: Gestor de Leads (POST /v1/addLeads) -------------------------
# Issued during the Gestor de Leads setup — request at
# integracaoleads@grupozap.com.
OLX_API_KEY=
OLX_AGENT_NAME=
