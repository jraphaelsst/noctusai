# n8n connector MCP — per-tenant config (co-located, NOT the product .env).
# Copy to `mcp/n8n/.env` (gitignored) and fill in real values.
#
# N8N_BASE_URL — instance root OR an already-/api/v1-suffixed URL; both
#                normalize identically (the client appends /api/v1).
# N8N_API_KEY  — n8n public-API key: n8n UI → Settings → n8n API →
#                Create an API key. SECRET — never commit the filled .env.

N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=replace-with-your-n8n-public-api-key
