# Trello connector MCP — per-account config (co-located, NOT the product .env).
# Copy to `mcp/trello/.env` (gitignored) and fill in real values.
#
# TRELLO_API_KEY — get one at https://trello.com/app-key (log in first).
# TRELLO_TOKEN   — generate from the "Token" link on that same page (grants
#                  the key access to your account's boards). SECRET — never
#                  commit the filled .env.
#
# Neither is required to use the trello.contract.* tools — those read only
# the vendored OpenAPI spec (contract/swagger.v3.json) and work with zero
# credentials, forever.

TRELLO_API_KEY=replace-with-your-trello-api-key
TRELLO_TOKEN=replace-with-your-trello-token
