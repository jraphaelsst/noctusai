# mcp/omie — Omie ERP connector credentials.
# Copy to `.env` (gitignored) or set these in the process environment.
# Env wins over this file. Full docs: mcp/omie/README.md § 2.

# --- Option A: a single Omie company (registered as environment `default`) ---
# Generate the pair in Omie: Configurações → Aplicativos → your app.
OMIE_APP_KEY=
OMIE_APP_SECRET=
# OMIE_LABEL=Acme Ltda
# OMIE_CNPJ=12.345.678/0001-90
# Pin it readonly to refuse every mutating call outright:
# OMIE_READONLY=false

# --- Option B: several companies (recommended when you operate more than one) -
# An Omie "environment" IS a company — each has its own app_key/app_secret.
# There is no Omie sandbox, so mark the live ones readonly unless you mean it.
# OMIE_ENVIRONMENTS={"acme-prod":{"app_key":"…","app_secret":"…","label":"Acme Ltda","cnpj":"12.345.678/0001-90","readonly":true},"acme-lab":{"app_key":"…","app_secret":"…","label":"Acme lab co."}}
# OMIE_DEFAULT_ENVIRONMENT=acme-lab

# --- Option C: flat per-environment vars (for secret stores without JSON) -----
# OMIE_ENV__ACME_PROD__APP_KEY=
# OMIE_ENV__ACME_PROD__APP_SECRET=
# OMIE_ENV__ACME_PROD__LABEL=Acme Ltda
# OMIE_ENV__ACME_PROD__READONLY=true

# --- Transport / surface -----------------------------------------------------
# `full` (default) advertises the curated per-resource CRUD tools too;
# `core` advertises only environments+catalog+call+diagnostics. Capability is
# identical either way — omie.call.invoke reaches all 461 methods.
# OMIE_TOOL_PROFILE=full
# OMIE_TIMEOUT_SECONDS=45
# OMIE_BASE_URL=https://app.omie.com.br/api/v1
