# Google connector MCP — per-tenant credentials.
# Copy to `mcp/google/.env` (gitignored) OR set as real env vars.
# Env wins over this file. The server starts cleanly with NONE of these
# set — read tools then run against the seed-lib Fakes; OAuth-only write
# tools return a typed error.

# Drive (public/anyone-with-link files) + YouTube read-only data.
GOOGLE_API_KEY=

# Google Maps Routes API v2 (google.maps.travel_estimate). Without it
# the tool falls back to a deterministic flat estimate.
GOOGLE_MAPS_API_KEY=

# OAuth user-delegated trio — required for Calendar writes and YouTube
# upload. ALL THREE must be present for `oauth_configured` to be true.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
