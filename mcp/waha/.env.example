# WAHA connector MCP — per-tenant config (co-located, NOT the product .env).
# Copy to `mcp/waha/.env` (gitignored) and fill in the real API key.
#
# WAHA_BASE_URL — WAHA instance root (no /api/v1 prefix; paths are absolute).
# WAHA_API_KEY  — the WAHA `X-Api-Key` (the value of the server's
#                 WHATSAPP_API_KEY env). SECRET — never commit the filled .env.

WAHA_BASE_URL=https://waha.example.com
WAHA_API_KEY=replace-with-your-waha-x-api-key
