# mcp/imovelweb/.env — connector-owned secrets (gitignored; copy to .env)
#
# Two INDEPENDENT capabilities. Either half works without the other, and
# `imovelweb.diagnostics.connection_status` names whichever is missing
# rather than reporting the whole connector dead.
#
# The contract tools (imovelweb.contract.*, .diagnostics.list_known_endpoints,
# .diagnostics.fetch_swagger) need NONE of this — they work the moment the
# connector is installed, which is what makes them usable during an outage.

# --- OUTBOUND: the OpenNavent API ------------------------------------------
# Issued by integracao@imovelweb.com.br. Two separate requests: one for the
# sandbox, a second for production after testing.
IMOVELWEB_CLIENT_ID=
IMOVELWEB_CLIENT_SECRET=

# br (default) | ar | rela. Only `br` has a sandbox host.
IMOVELWEB_REGION=br

# true while testing. Governs which host is used AND whether
# imovelweb.sandbox.emit_event is allowed to run at all — it refuses on a
# non-sandbox host, because it fabricates leads and those would be
# indistinguishable from real customers inside a client's CRM.
# Anything other than 1/true/yes/on is read as false, so a typo fails safe.
IMOVELWEB_SANDBOX=true

# Escape hatch for a host we have not catalogued. Leave unset normally —
# region + sandbox resolve it, and an explicit override bypasses that.
# IMOVELWEB_BASE_URL=

# --- INBOUND: the callback the vendor POSTs to us --------------------------
# WE choose this secret; the vendor never issues one. It is registered as
# `authorizationHeaderValue = "Basic " + base64("noctusai-imovelweb:<secret>")`
# and must match what the product receiver validates — otherwise a
# simulation proves nothing and real deliveries 401.
IMOVELWEB_WEBHOOK_SECRET=

# Our own receiver, the URL registered with the vendor.
# imovelweb.webhook.simulate POSTs here. Point it at localhost while
# developing — but note that REGISTERING a localhost URL with the vendor is
# refused, because the callback config is integrator-wide and an
# unreachable one blackholes every agency's leads with no error anywhere.
IMOVELWEB_RECEIVER_URL=http://localhost:8000/api/portals/imovelweb/leads
