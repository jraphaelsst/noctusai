# Hostinger connector MCP — API token (co-located, NOT the product .env).
# Copy to `mcp/hostinger/.env` (gitignored) and fill in the real token.
#
# HOSTINGER_API_TOKEN — Hostinger Developers API token, sent as
#                       `Authorization: Bearer <token>`. Issue/rotate it in
#                       hPanel → API. SECRET — never commit the filled .env.
#
# The base URL is fixed (https://developers.hostinger.com) — no per-tenant
# host. The host sits behind Cloudflare; the connector sends a browser-style
# User-Agent automatically (the default urllib UA is 403-banned).

HOSTINGER_API_TOKEN=replace-with-your-hostinger-api-token
