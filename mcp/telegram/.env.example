# Telegram connector MCP — per-account config (co-located, NOT the product .env).
# Copy to `mcp/telegram/.env` (gitignored, chmod 600) and fill in real values.
#
# Get both from https://my.telegram.org -> API development tools.
# TELEGRAM_API_HASH is SECRET — never commit the filled .env.
# The login session itself is created by `mcp/telegram/login.py` (interactive).
TELEGRAM_API_ID=replace-with-numeric-api-id
TELEGRAM_API_HASH=replace-with-api-hash
