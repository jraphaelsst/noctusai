+"""Tests for MockSupabaseClient cross-schema table seeding.
+
+Closes the gap filed by Engineer SSS (2026-05-11) during the webhook-
+compliance audit: ERP's assinaturas webhook resolves its secret via
+`db.schema("core").table("org_settings")`, but `MockSupabaseClient.schema(name)`
+previously created a scoped instance with a fresh `_tables` dict — so
+`parent.set_table_data("core.org_settings", [...])` was invisible
+to the scoped lookup.
+
+Design (Option B + shared `_tables` for symmetry, see PROJECT.md §3a):
+  - `_tables` is keyed by schema-qualified `<schema>.<table>` names.
+  - `_qualify(name)` normalizes bare names with the bound schema.
+  - `schema(name)` returns a scoped view that SHARES `_tables` + `_rpcs`
+    with the parent — `set_table_data` on either side is mutually visible.
+  - Backward-compat: a default-schema (`public`) client storing
+    `"foo"` and reading `db.table("foo")` continue to round-trip through
+    the same qualified key `"public.foo"`.
+"""
+from __future__ import annotations
+
+import pytest
+
+from noctusai_lib.testing import MockSupabaseClient
+
+
+# ---------------------------------------------------------------------------
+# Backward-compat — bare-name set + bare-name lookup (the existing pattern)
+# ---------------------------------------------------------------------------
+
+
+def test_bare_name_round_trip_default_schema():
+    """`set_table_data("foo", [...])` on a default-schema client is
+    readable via `client.table("foo")`. Closes the round-trip the
+    78-test legacy suite already exercises — re-stated here as a
+    regression anchor for the qualified-key refactor."""
+    db = MockSupabaseClient(validate_schema=False)
+    db.set_table_data("foo", [{"id": "x1"}])
+    res = db.table("foo").select("*").execute()
+    assert res.data == [{"id": "x1"}]
+
+
+def test_bare_name_round_trip_bound_schema():
+    """`set_table_data("foo", ...)` on a `schema="erp"` client (the ERP
+    test-fixture shape) stores under `"erp.foo"` and is readable via
+    `client.table("foo")` — same equivalence the bare-key model
+    produced, but now expressed through the bound schema."""
+    db = MockSupabaseClient(validate_schema=False, schema="erp")
+    db.set_table_data("assinaturas", [{"id": "a1", "documento_nome": "C"}])
+    res = db.table("assinaturas").select("*").execute()
+    assert len(res.data) == 1
+    assert res.data[0]["id"] == "a1"
+
+
+# ---------------------------------------------------------------------------
+# Cross-schema — the new capability
+# ---------------------------------------------------------------------------
+
+
+def test_qualified_set_visible_via_scoped_schema_chain():
+    """The headline fix. `set_table_data("core.org_settings", [...])` on
+    the parent is readable via `parent.schema("core").table("org_settings")`.
+    Mirrors ERP `_resolve_assinatura_secret`'s real lookup shape."""
+    db = MockSupabaseClient(validate_schema=False, schema="erp")
+    db.set_table_data(
+        "core.org_settings",
+        [
+            {
+                "org_id": "org-1",
+                "key": "assinatura_webhook_secret",
+                "value": "shh-secret",
+            }
+        ],
+    )
+    res = (
+        db.schema("core")
+        .table("org_settings")
+        .select("value")
+        .eq("org_id", "org-1")
+        .eq("key", "assinatura_webhook_secret")
+        .execute()
+    )
+    assert len(res.data) == 1
+    assert res.data[0]["value"] == "shh-secret"
+
+
+def test_scoped_set_visible_from_parent():
+    """Symmetric direction. Setting via the scoped client is also
+    visible via parent's qualified-key seeding view."""
+    db = MockSupabaseClient(validate_schema=False, schema="erp")
+    db.schema("core").set_table_data(
+        "org_settings",
+        [{"org_id": "org-1", "key": "k", "value": "v"}],
+    )
+    # And reachable from parent's parent-side scoped chain.
+    res = (
+        db.schema("core")
+        .table("org_settings")
+        .select("*")
+        .execute()
+    )
+    assert len(res.data) == 1
+    assert res.data[0]["value"] == "v"
+
+
+def test_different_schemas_isolated():
+    """`erp.foo` and `core.foo` are independent storage slots — seeding
+    one must not bleed into the other."""
+    db = MockSupabaseClient(validate_schema=False, schema="erp")
+    db.set_table_data("foo", [{"id": "erp-1"}])
+    db.set_table_data("core.foo", [{"id": "core-1"}])
+
+    erp_rows = db.table("foo").select("*").execute().data
+    core_rows = db.schema("core").table("foo").select("*").execute().data
+
+    assert erp_rows == [{"id": "erp-1"}]
+    assert core_rows == [{"id": "core-1"}]
+
+
+def test_explicit_public_qualifier_equals_default_schema():
+    """`set_table_data("public.foo", ...)` and `set_table_data("foo", ...)`
+    on a default-schema client target the same slot."""
+    db = MockSupabaseClient(validate_schema=False)
+    db.set_table_data("public.foo", [{"id": "v1"}])
+    # Lookup via bare name (qualifies to public.foo) hits the same slot.
+    res = db.table("foo").select("*").execute()
+    assert res.data == [{"id": "v1"}]
+
+
+def test_qualified_lookup_via_dot_in_table_name():
+    """`db.table("core.org_settings")` is itself a legitimate access
+    path (the pre-existing `_builder_for` split handled this on the
+    builder side). Confirm it now routes through the qualified storage
+    key without re-creating a fresh slot."""
+    db = MockSupabaseClient(validate_schema=False)
+    db.set_table_data("core.org_settings", [{"org_id": "org-1", "value": "v"}])
+    res = db.table("core.org_settings").select("*").execute()
+    assert res.data == [{"org_id": "org-1", "value": "v"}]
+
+
+# ---------------------------------------------------------------------------
+# Pin 5 invalid-sig integration shape — exercise the exact ERP webhook flow
+# at the seed-lib level so we don't need product-side fixtures to prove the
+# unblock. This is the "Pin 5 invalid-sig" mock contract.
+# ---------------------------------------------------------------------------
+
+
+def test_webhook_secret_resolver_pattern():
+    """Models the exact two-step lookup ERP's `_resolve_assinatura_secret`
+    runs against the admin client: bound-schema row fetch followed by a
+    `schema("core")` chain. Before the fix the second step always saw
+    an empty `_tables` dict and the resolver returned `None`, blocking
+    Pin 5 invalid-sig tests."""
+    db = MockSupabaseClient(validate_schema=False, schema="erp")
+
+    # Step 1 — assinatura row (lives in erp.assinaturas via bound schema).
+    db.set_table_data(
+        "assinaturas",
+        [{"id": "a-1", "org_id": "org-1", "provedor": "clicksign"}],
+    )
+
+    # Step 2 — core.org_settings (cross-schema secret store).
+    db.set_table_data(
+        "core.org_settings",
+        [
+            {
+                "org_id": "org-1",
+                "key": "assinatura_webhook_secret",
+                "value": "the-real-secret",
+            }
+        ],
+    )
+
+    # Replay the resolver shape.
+    row = (
+        db.table("assinaturas")
+        .select("org_id, provedor")
+        .eq("id", "a-1")
+        .execute()
+    )
+    assert row.data[0]["org_id"] == "org-1"
+
+    secret_res = (
+        db.schema("core")
+        .table("org_settings")
+        .select("value")
+        .eq("org_id", "org-1")
+        .eq("key", "assinatura_webhook_secret")
+        .execute()
+    )
+    assert secret_res.data[0]["value"] == "the-real-secret"
+
+
+# ---------------------------------------------------------------------------
+# Scoped-client carries over auth/storage/rpcs by reference
+# ---------------------------------------------------------------------------
+
+
+def test_schema_scoped_shares_auth_and_rpcs():
+    """The scoped instance must NOT re-instantiate `auth` / `storage`
+    or strand RPC seed data — the pre-existing `schema()` impl already
+    forwarded these; the refactor preserves it."""
+    db = MockSupabaseClient(validate_schema=False)
+    db.set_rpc_data("get_data_sp", ["2026-05-11"])
+    scoped = db.schema("core")
+    # auth + storage are mock objects that must be the same instances.
+    assert scoped.auth is db.auth
+    assert scoped.storage is db.storage
+    # RPC seed data flows through.
+    assert scoped.rpc("get_data_sp").execute().data == ["2026-05-11"]
+
+
+def test_schema_repeated_scoping_round_trip():
+    """`db.schema("core").schema("erp")` returns an erp-bound view; the
+    storage backing remains shared so `set_table_data` from any hop
+    is visible from the others."""
+    db = MockSupabaseClient(validate_schema=False, schema="public")
+    db.schema("core").set_table_data(
+        "org_settings", [{"key": "k", "value": "v"}]
+    )
+    via_double_hop = (
+        db.schema("public").schema("core").table("org_settings").select("*").execute()
+    )
+    assert via_double_hop.data == [{"key": "k", "value": "v"}]
-- 
