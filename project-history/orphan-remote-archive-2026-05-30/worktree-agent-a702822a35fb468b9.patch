+        side are mutually visible. Storage is keyed by
+        `<schema>.<table>`, so `parent.set_table_data("core.org_settings", ...)`
+        is reachable via `parent.schema("core").table("org_settings")`
+        and vice-versa.
+        """
+        scoped = MockSupabaseClient.__new__(MockSupabaseClient)
+        scoped._data = self._data
         scoped.auth = self.auth
         scoped.storage = self.storage
+        scoped._tables = self._tables
         scoped._rpcs = self._rpcs
+        scoped._validate_schema = self._validate_schema
+        scoped._schema = name
+        scoped._strict_unknown_tables = self._strict_unknown_tables
         return scoped
 
