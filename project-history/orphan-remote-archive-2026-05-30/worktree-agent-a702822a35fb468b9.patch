+    def _qualify(self, name: str) -> str:
+        """Normalize bare table names to `<schema>.<table>` keys.
+
+        Names containing a `.` are treated as already-qualified
+        and returned as-is — that's the seam tests use to seed
+        foreign-schema tables (`"core.org_settings"`) while a
+        bound-schema lookup (`db.table("foo")` under
+        `MockSupabaseClient(schema="erp")`) resolves to `"erp.foo"`.
+        """
+        if name and "." in name:
+            return name
+        return f"{self._schema or 'public'}.{name}"
+
