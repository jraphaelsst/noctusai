+    def test_lists_each_dispatch_line(self, tmp_path):
+        # Multi-dispatch file gets ONE finding listing every call line.
+        content = (
+            "from noctusai_lib.integrations.llm import chat_completion\n\n"
+            "async def a():\n"
+            "    return await chat_completion(model='x', prompt='1')\n"
+            "async def b():\n"
+            "    return await chat_completion(model='x', prompt='2')\n"
+            "async def c():\n"
+            "    return await chat_completion(model='x', prompt='3')\n"
+        )
+        product_path = self._mk_service(tmp_path, content)
+        issues = check_llm_audit_wired(product_path)
