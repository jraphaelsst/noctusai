+# ---------------------------------------------------------------------------
+# check_llm_audit_wired
+# ---------------------------------------------------------------------------
+
+
+class TestCheckLlmAuditWired:
+    """LLM-dispatch call in services/workers/routers without colocated
+    `audit_hook`/`AuditRecord` reference → warning. Per
+    `KB § PATTERNS/llm-tool-audit.md` (llm-tool-audit-rollout Phase 5)."""
+
+    def _mk_service(
+        self,
+        tmp_path: Path,
+        py_content: str,
+        *,
+        product: str = "p1",
+        subdir: str = "services",
+        filename: str = "ai_service.py",
+    ) -> Path:
+        target = tmp_path / "products" / product / "backend" / "app" / subdir
+        target.mkdir(parents=True, exist_ok=True)
+        (target / filename).write_text(py_content)
+        return tmp_path / "products" / product
+
+    def test_flags_chat_completion_without_audit_reference(self, tmp_path):
+        content = (
+            "from noctusai_lib.integrations.llm import chat_completion\n\n"
+            "async def call_llm(prompt: str) -> str:\n"
+            "    raw = await chat_completion(model='gpt-4', prompt=prompt)\n"
+            "    return raw\n"
+        )
+        product_path = self._mk_service(tmp_path, content)
+        issues = check_llm_audit_wired(product_path)
+        assert len(issues) == 1, issues
+        assert issues[0]["severity"] == "warning"
+        assert "chat_completion" in issues[0]["issue"] or "LLM call" in issues[0]["issue"]
+        assert issues[0]["product"] == "p1"
+
+    def test_flags_generate_embedding_without_audit(self, tmp_path):
+        content = (
+            "from noctusai_lib.integrations.llm import generate_embedding\n\n"
+            "async def embed(text: str):\n"
+            "    return await generate_embedding(text)\n"
+        )
+        product_path = self._mk_service(
+            tmp_path, content, filename="segmentation_service.py",
+        )
+        issues = check_llm_audit_wired(product_path)
+        assert len(issues) == 1, issues
+        # Each dispatch call line number is listed in the message.
+        assert "generate_embedding" not in issues[0]["issue"] or "line" in issues[0]["issue"]
+
+    def test_flags_transcribe_audio_without_audit(self, tmp_path):
+        content = (
+            "from noctusai_lib.integrations.llm import transcribe_audio\n\n"
+            "async def stt(audio_bytes: bytes):\n"
+            "    return await transcribe_audio(audio_bytes)\n"
+        )
+        product_path = self._mk_service(
+            tmp_path, content, filename="attachment_service.py",
+        )
+        issues = check_llm_audit_wired(product_path)
+        assert len(issues) == 1, issues
+
+    def test_flags_analyze_image_without_audit(self, tmp_path):
+        content = (
+            "from noctusai_lib.integrations.llm import analyze_image\n\n"
+            "async def vision(image_bytes: bytes):\n"
+            "    return await analyze_image(image_bytes)\n"
+        )
+        product_path = self._mk_service(
+            tmp_path, content, filename="attachment_service.py",
+        )
+        issues = check_llm_audit_wired(product_path)
+        assert len(issues) == 1, issues
+
