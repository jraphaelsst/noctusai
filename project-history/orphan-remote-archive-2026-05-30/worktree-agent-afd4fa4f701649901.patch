+# ---------------------------------------------------------------------------
+# `check_llm_audit_wired` — flag product files dispatching LLM calls
+# (`chat_completion` / `generate_embedding` / `transcribe_audio` /
+# `analyze_image`) without a colocated reference to the seed audit primitive
+# (`audit_hook` import / `AuditRecord`). Per `KB § PATTERNS/llm-tool-audit.md`
+# every LLM-dispatch site MUST route through `make_audit_writer(...)` so the
+# call lands a row in `<product_schema>.tool_call_audits`. Missing wiring is
+# a silent observability hole (no LGPD-queryable trail).
+#
+# Scope: `products/*/backend/app/{services,workers,routers}/*.py`.
+# Carve-out: adconnect + dev-team are not LLM dispatchers (confirmed by
+# Phase 0 audit — no `chat_completion`/`OpenAI()` imports). The detector
+# fires on grep hits only; carve-out products naturally never trigger.
+# Severity: warning.
+#
+# N=7 recurrence formalization, 2026-05-11 (`llm-tool-audit-rollout`
+# Phase 5). Per CLAUDE.md "DRY — the recurrence rule" +
+# KB § PATTERNS/methodology-codification-pipeline.md.
+# ---------------------------------------------------------------------------
+
+
+# LLM-dispatch call surfaces the detector tracks. Any of these tokens appearing
+# as a CALL (not just an import or a docstring word) flags the file as an
+# LLM-dispatch site. The audit primitive is supposed to ring-fence every one
+# of these.
+_LLM_DISPATCH_CALL_NAMES: frozenset[str] = frozenset({
+    "chat_completion",
+    "generate_embedding",
+    "transcribe_audio",
+    "analyze_image",
+})
+
+# Tokens whose presence in the same file (as either an import or a name
+# reference) marks the file as audit-wired. We accept either token because
+# the canonical pattern (`audit_hook.py` provides `build_audit_record` +
+# `get_audit_writer`; module-level imports `AuditRecord`) shows up via at
+# least one. The check is intentionally permissive: a single `audit_hook`
+# import counts as wired even before the row-write line is added — the
+# follow-up wiring is a different concern.
+_LLM_AUDIT_REFERENCE_TOKENS: frozenset[str] = frozenset({
+    "audit_hook",
+    "AuditRecord",
+})
+
+
+def _llm_dispatch_call_lines(tree: ast.AST) -> list[int]:
+    """Return the line numbers of every LLM-dispatch CALL in the AST.
+
+    Matches both bare-name calls (`chat_completion(...)`) and attribute
+    calls (`integrations.chat_completion(...)`). Docstrings and import
+    statements are ignored — only `ast.Call` nodes whose function name
+    matches one of `_LLM_DISPATCH_CALL_NAMES`.
+    """
+    lines: list[int] = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        func = node.func
+        name = None
+        if isinstance(func, ast.Name):
+            name = func.id
+        elif isinstance(func, ast.Attribute):
+            name = func.attr
+        if name in _LLM_DISPATCH_CALL_NAMES:
+            lines.append(node.lineno)
+    return lines
+
+
+def _file_has_audit_reference(tree: ast.AST) -> bool:
+    """True if the file imports OR references any of the audit tokens.
+
+    We accept three shapes:
+      - `from app.services.audit_hook import ...` (ImportFrom)
+      - `import app.services.audit_hook` (Import)
+      - bare `audit_hook` / `AuditRecord` name reference anywhere
+      - attribute reference (`x.AuditRecord`, `audit_hook.write`)
+    """
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom):
+            module = node.module or ""
+            if any(tok in module for tok in _LLM_AUDIT_REFERENCE_TOKENS):
+                return True
+            for alias in node.names:
+                if alias.name in _LLM_AUDIT_REFERENCE_TOKENS:
+                    return True
+        elif isinstance(node, ast.Import):
+            for alias in node.names:
+                if any(tok in alias.name for tok in _LLM_AUDIT_REFERENCE_TOKENS):
+                    return True
+        elif isinstance(node, ast.Name):
+            if node.id in _LLM_AUDIT_REFERENCE_TOKENS:
+                return True
+        elif isinstance(node, ast.Attribute):
+            if node.attr in _LLM_AUDIT_REFERENCE_TOKENS:
+                return True
+    return False
+
+
+def check_llm_audit_wired(product_path: Path) -> list[dict]:
+    """Detect product files that dispatch an LLM call without colocated
+    audit-primitive wiring.
+
+    A file in `app/services/` / `app/workers/` / `app/routers/` that calls
+    `chat_completion(...)` / `generate_embedding(...)` / `transcribe_audio(...)`
+    / `analyze_image(...)` MUST also reference the audit primitive
+    (`audit_hook` import or `AuditRecord` name) in the same file. Otherwise
+    the LLM call's prompt + response flow through the system without a
+    queryable row in `<product>.tool_call_audits`.
+
+    Per `KB § PATTERNS/llm-tool-audit.md` — best-effort writer composed via
+    `make_audit_writer(...)`; per-feature redaction via `redact_arguments` +
+    `redact_result` kwargs on each `register_feature(...)`.
+
+    Scope: per-product, services/workers/routers only. adconnect + dev-team
+    are carved out by absence (no LLM dispatch in their backends).
+
+    Severity: warning.
+    """
+    issues: list[dict] = []
+    if not product_path.exists():
+        return issues
+
+    product_slug = product_path.name
+    candidate_dirs = [
+        product_path / "backend" / "app" / "services",
+        product_path / "backend" / "app" / "workers",
+        product_path / "backend" / "app" / "routers",
+    ]
+
+    for base in candidate_dirs:
+        if not base.exists():
+            continue
+        for path in base.glob("*.py"):
+            if path.name == "__init__.py":
+                continue
+            try:
+                content = path.read_text(encoding="utf-8")
+            except (UnicodeDecodeError, OSError) as exc:
+                logger.warning(
+                    "compliance: cannot read %s (%s), skipping", path, exc,
+                )
+                continue
+            try:
+                tree = ast.parse(content, filename=str(path))
+            except SyntaxError as exc:
+                logger.warning(
+                    "compliance: cannot parse %s (%s), skipping", path, exc,
+                )
+                continue
+
+            dispatch_lines = _llm_dispatch_call_lines(tree)
+            if not dispatch_lines:
+                continue
+            if _file_has_audit_reference(tree):
+                continue
+
+            try:
+                relative = str(path.relative_to(product_path.parent.parent))
+            except ValueError:
+                relative = str(path)
+
+            first_line = dispatch_lines[0]
+            issues.append({
+                "product": product_slug,
+                "file": relative,
+                "issue": (
+                    f"`{relative}` dispatches LLM call(s) at line(s) "
+                    f"{', '.join(str(n) for n in dispatch_lines)} "
+                    f"(`chat_completion` / `generate_embedding` / "
+                    f"`transcribe_audio` / `analyze_image`) but has no "
+                    f"colocated `audit_hook` import or `AuditRecord` "
+                    f"reference. Per `KB § PATTERNS/llm-tool-audit.md`, "
+                    f"every LLM-dispatch site MUST route through "
+                    f"`make_audit_writer(...)` so the call lands a row in "
+                    f"`<product>.tool_call_audits`. Missing wiring = silent "
+                    f"observability hole (no LGPD-queryable trail). FIX: "
+                    f"import `build_audit_record` + `get_audit_writer` from "
+                    f"`app.services.audit_hook` and wrap the dispatch — see "
+                    f"media-scheduling's `app/workers/conversation_worker.py` "
+                    f"or any Phase 2-4 adopter (mailing / erp-imobiliario / "
+                    f"daily-life / personal-finance / therapy-platform / "
+                    f"core) for the canonical shape. First dispatch at "
+                    f"line {first_line}."
+                ),
+                "severity": "warning",
+            })
+
+    return issues
+
+
+# ---------------------------------------------------------------------------
+# `check_register_feature_has_redaction` — flag `register_feature(...)`
+# calls in `app/services/ai_consent_features.py` that omit the LGPD
+# redaction kwargs (`redact_arguments=` AND `redact_result=`). Without both,
+# raw prompt + completion text lands in `tool_call_audits.arguments` /
+# `tool_call_audits.result`, which is an LGPD leak the audit primitive
+# explicitly defends against.
+#
+# Phase 0 audit (2026-05-11) surfaced N=35 register_feature calls across 6
+# products with zero redaction wiring — the highest-impact LGPD gap. Phases
+# 2-4 wired the redaction in every product; this detector closes the drift
+# loop so a future feature author can't silently ship without redaction.
+#
+# Severity: warning.
+# ---------------------------------------------------------------------------
+
+
+def _is_register_feature_call(node: ast.AST) -> bool:
+    """True iff the node is a `register_feature(...)` call (bare-name or
+    attribute form; we accept both)."""
+    if not isinstance(node, ast.Call):
+        return False
+    func = node.func
+    if isinstance(func, ast.Name) and func.id == "register_feature":
+        return True
+    if isinstance(func, ast.Attribute) and func.attr == "register_feature":
+        return True
+    return False
+
+
+def _register_feature_first_arg_key(call: ast.Call) -> str:
+    """Return the feature key string (first positional arg) or `<unknown>`.
+
+    `register_feature("daily_life.daily_brief", title=..., ...)` → "daily_life.daily_brief".
+    Returns "<unknown>" when the first arg is not a string literal (rare).
+    """
+    if call.args:
+        first = call.args[0]
+        if isinstance(first, ast.Constant) and isinstance(first.value, str):
+            return first.value
+    # Some adopters might wire feature_key= as a keyword; surface that too.
+    for kw in call.keywords:
+        if kw.arg in ("key", "feature_key") and isinstance(kw.value, ast.Constant):
+            value = kw.value.value
+            if isinstance(value, str):
+                return value
+    return "<unknown>"
+
+
+def check_register_feature_has_redaction(product_path: Path) -> list[dict]:
+    """Detect `register_feature(...)` calls missing LGPD redaction kwargs.
+
+    Scans `<product>/backend/app/services/ai_consent_features.py` (the
+    single canonical location for consent registrations). Every
+    `register_feature(...)` call MUST pass BOTH:
+
+      - `redact_arguments=<callable>` — scrubs PII from input args before
+        the AuditRecord is built.
+      - `redact_result=<callable>` — scrubs PII from the LLM completion
+        before the row is written.
+
+    The seed-lib `_safe_jsonable` fallback is a defensive coercion shim,
+    NOT a redaction strategy. Without explicit `redact_*` callables,
+    personal data (note bodies / clinic notes / mailing-list emails /
+    therapy transcripts) flows raw into `tool_call_audits.arguments` and
+    `tool_call_audits.result` — exactly what the audit primitive defends
+    against.
+
+    Surfaced by Phase 0 audit (2026-05-11): N=35 register_feature calls
+    across 6 products had zero redaction wiring before Phase 2-4 rollout.
+    Detector closes the drift loop so a future feature author cannot
+    silently re-introduce the gap.
+
+    Scope: per-product, `ai_consent_features.py` only — that's where
+    `register_feature(...)` legitimately lives. Other files calling
+    `register_feature` from outside the consent file are out of contract
+    and would surface separately.
+
+    Severity: warning.
+    """
+    issues: list[dict] = []
+    if not product_path.exists():
+        return issues
+
+    product_slug = product_path.name
+    consent_file = (
+        product_path / "backend" / "app" / "services" / "ai_consent_features.py"
+    )
+    if not consent_file.exists():
+        return issues
+
+    try:
+        content = consent_file.read_text(encoding="utf-8")
+    except (UnicodeDecodeError, OSError) as exc:
+        logger.warning(
+            "compliance: cannot read %s (%s), skipping", consent_file, exc,
+        )
+        return issues
+    try:
+        tree = ast.parse(content, filename=str(consent_file))
+    except SyntaxError as exc:
+        logger.warning(
+            "compliance: cannot parse %s (%s), skipping", consent_file, exc,
+        )
+        return issues
+
+    try:
+        relative = str(consent_file.relative_to(product_path.parent.parent))
+    except ValueError:
+        relative = str(consent_file)
+
+    for node in ast.walk(tree):
+        if not _is_register_feature_call(node):
+            continue
+        kwarg_names: set[str] = {kw.arg for kw in node.keywords if kw.arg}
+        has_args_redact = "redact_arguments" in kwarg_names
+        has_result_redact = "redact_result" in kwarg_names
+        if has_args_redact and has_result_redact:
+            continue
+        missing = []
+        if not has_args_redact:
+            missing.append("redact_arguments=")
+        if not has_result_redact:
+            missing.append("redact_result=")
+        feature_key = _register_feature_first_arg_key(node)
+        issues.append({
+            "product": product_slug,
+            "file": relative,
+            "issue": (
+                f"`{relative}:{node.lineno}` — `register_feature("
+                f"'{feature_key}', ...)` is missing required LGPD "
+                f"redaction kwarg(s): {' + '.join(missing)}. Per "
+                f"`KB § PATTERNS/llm-tool-audit.md`, every feature MUST "
+                f"declare per-feature `redact_arguments=<callable>` AND "
+                f"`redact_result=<callable>` so PII (note bodies / clinic "
+                f"notes / emails / transcripts) is scrubbed BEFORE the "
+                f"AuditRecord lands in `<product>.tool_call_audits`. The "
+                f"seed `_safe_jsonable` fallback is a coercion shim, NOT "
+                f"a redaction strategy. FIX: define a `_scrub_<feature>_*` "
+                f"helper that returns only structural fields (counters / "
+                f"status / prompt-version) and pass it as both kwargs — "
+                f"see mailing's `app/services/ai_consent_features.py` for "
+                f"the canonical lambdas, or daily-life's `_scrub_*` named "
+                f"helpers for the named-function shape."
+            ),
+            "severity": "warning",
+        })
+
+    return issues
+
