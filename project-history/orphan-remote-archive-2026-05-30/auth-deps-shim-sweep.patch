@@ -0,0 +1,155 @@
+"""Direct unit tests for AdConnect's custom-JWT auth shim
+(``products/adconnect/backend/app/auth_deps.py``).
+
+Coverage rationale (per ``auth-deps-shim-sweep`` Phase 2):
+
+The custom-JWT auth realm previously had only INDIRECT coverage via
+domain-router tests and the seed framework's standard-router AuthBoundary
+suite (which covers the *Supabase* realm, not custom-JWT). The 401/403 paths
+of ``get_current_user`` + ``require_role`` were untested. This file closes the
+gap.
+
+Status-code-assertion rule applies (every body-asserting test ALSO asserts
+``.status_code`` — see ``KB § PATTERNS/testing.md``).
+"""
+from __future__ import annotations
+
+import pytest
+from fastapi import Depends, FastAPI
+from fastapi.testclient import TestClient
+
+from app.auth_deps import get_current_user, require_role
+from app.security import create_token
+
+
+def _build_app() -> FastAPI:
+    """Minimal app exposing both auth-shim deps for direct exercise.
+
+    We don't import AdConnect's full `app.main` here because that mounts the
+    seed framework + standard routers + every domain router — too much
+    machinery for a unit test of the shim itself. A fresh `FastAPI()` with
+    just the two probe endpoints is the right blast-radius.
+    """
+    app = FastAPI()
+
+    @app.get("/probe/current")
+    def probe_current(user: dict = Depends(get_current_user)) -> dict:
+        return {"sub": user.get("sub"), "role": user.get("role")}
+
+    @app.get("/probe/admin")
+    def probe_admin(user: dict = Depends(require_role("admin"))) -> dict:
+        return {"sub": user.get("sub"), "role": user.get("role")}
+
+    @app.get("/probe/multi")
+    def probe_multi(user: dict = Depends(require_role("admin", "customer"))) -> dict:
+        return {"sub": user.get("sub"), "role": user.get("role")}
+
+    return app
+
+
+@pytest.fixture
+def shim_client() -> TestClient:
+    return TestClient(_build_app())
+
+
+# ---------------------------------------------------------------------------
+# get_current_user — 401 paths
+# ---------------------------------------------------------------------------
+
+
+def test_get_current_user_missing_bearer_returns_401(shim_client: TestClient) -> None:
+    """No Authorization header at all → 401."""
+    resp = shim_client.get("/probe/current")
+    assert resp.status_code == 401, resp.text
+    assert resp.json()["detail"] == "Missing bearer token"
+
+
+def test_get_current_user_empty_bearer_returns_401(shim_client: TestClient) -> None:
+    """Authorization header without a token → 401 (HTTPBearer rejects empty)."""
+    resp = shim_client.get("/probe/current", headers={"Authorization": "Bearer "})
+    assert resp.status_code == 401, resp.text
+
+
+def test_get_current_user_invalid_signature_returns_401(shim_client: TestClient) -> None:
+    """Token signed with the wrong secret → 401 (jwt.PyJWTError path)."""
+    import jwt as pyjwt
+
+    bogus = pyjwt.encode({"sub": "user-x", "role": "customer"}, "wrong-secret", algorithm="HS256")
+    resp = shim_client.get("/probe/current", headers={"Authorization": f"Bearer {bogus}"})
+    assert resp.status_code == 401, resp.text
+    assert resp.json()["detail"] == "Invalid or expired token"
+
+
+def test_get_current_user_malformed_token_returns_401(shim_client: TestClient) -> None:
+    """Garbage in the token slot → 401 (jwt.PyJWTError on decode)."""
+    resp = shim_client.get(
+        "/probe/current",
+        headers={"Authorization": "Bearer not-a-jwt-at-all"},
+    )
+    assert resp.status_code == 401, resp.text
+    assert resp.json()["detail"] == "Invalid or expired token"
+
+
+# ---------------------------------------------------------------------------
+# get_current_user — happy path
+# ---------------------------------------------------------------------------
+
+
+def test_get_current_user_valid_token_returns_claims(shim_client: TestClient) -> None:
+    """Token signed with the AdConnect secret + valid claims → 200 with claims."""
+    token = create_token({"sub": "user-1", "role": "customer", "email": "c@example.com"})
+    resp = shim_client.get("/probe/current", headers={"Authorization": f"Bearer {token}"})
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["sub"] == "user-1"
+    assert body["role"] == "customer"
+
+
+# ---------------------------------------------------------------------------
+# require_role — gates
+# ---------------------------------------------------------------------------
+
+
+def test_require_role_no_token_returns_401(shim_client: TestClient) -> None:
+    """``require_role`` chains through ``get_current_user`` first — missing
+    token must surface as 401, not 403. Confirms the chain order."""
+    resp = shim_client.get("/probe/admin")
+    assert resp.status_code == 401, resp.text
+
+
+def test_require_role_wrong_role_returns_403(shim_client: TestClient) -> None:
+    """Valid token with role NOT in the allowed set → 403."""
+    token = create_token({"sub": "user-1", "role": "customer"})
+    resp = shim_client.get("/probe/admin", headers={"Authorization": f"Bearer {token}"})
+    assert resp.status_code == 403, resp.text
+    assert resp.json()["detail"] == "Role not allowed"
+
+
+def test_require_role_correct_role_passes(shim_client: TestClient) -> None:
+    """Valid token with role IN the allowed set → 200."""
+    token = create_token({"sub": "user-2", "role": "admin"})
+    resp = shim_client.get("/probe/admin", headers={"Authorization": f"Bearer {token}"})
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["role"] == "admin"
+
+
+def test_require_role_multi_allowed_set(shim_client: TestClient) -> None:
+    """``require_role("admin", "customer")`` accepts either role."""
+    token_a = create_token({"sub": "u-a", "role": "admin"})
+    token_c = create_token({"sub": "u-c", "role": "customer"})
+
+    resp_a = shim_client.get("/probe/multi", headers={"Authorization": f"Bearer {token_a}"})
+    assert resp_a.status_code == 200, resp_a.text
+    assert resp_a.json()["role"] == "admin"
+
+    resp_c = shim_client.get("/probe/multi", headers={"Authorization": f"Bearer {token_c}"})
+    assert resp_c.status_code == 200, resp_c.text
+    assert resp_c.json()["role"] == "customer"
+
+
+def test_require_role_missing_role_claim_returns_403(shim_client: TestClient) -> None:
+    """Token missing the ``role`` claim entirely → 403 (user.get returns None,
+    None not in allowed-set)."""
+    token = create_token({"sub": "u-norole"})
+    resp = shim_client.get("/probe/admin", headers={"Authorization": f"Bearer {token}"})
+    assert resp.status_code == 403, resp.text
