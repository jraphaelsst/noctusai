@@ -0,0 +1,369 @@
+"""Per-product `audit_hook` factory — lifts the N=6+ duplicated lazy
+SQLAlchemy + session-factory + noop-writer shape into the seed.
+
+Before this module landed, every product (core / mailing / daily-life /
+personal-finance / therapy-platform / erp-imobiliario) shipped a
+near-byte-identical `app/services/audit_hook.py` with:
+
+    - module-level `_engine` + `_session_factory` singletons
+    - `_get_engine_and_factory()` lazily constructing them off `settings.postgres_url`
+    - a `_noop_writer` returned when `postgres_url` is empty
+    - a `get_audit_writer()` that wraps the seed `make_audit_writer`
+      with a per-call short-lived session
+
+The body is ~70 LoC; only the product's `settings` import + `ToolCallAudit`
+class differ. The factory below closes over those two seams and returns
+the matching `get_audit_writer` callable plus a `reset_for_test()` hook
+(equivalent to the per-product `_engine = None; _session_factory = None`
+monkeypatch dance the tests do).
+
+**Optional `build_audit_record_for_feature`** — three products
+(personal-finance, daily-life, therapy-platform) also ship a helper that
+applies feature-catalog redaction (`get_feature(feature_key).redact_*`)
+BEFORE constructing the `AuditRecord`. Two semantics exist:
+
+    - `on_missing_redactor="over_redact"` (PF default) — drop the field
+      to None when no redactor registered. Safe for finance-LGPD.
+    - `on_missing_redactor="passthrough"` (daily-life default) — log
+      debug + fall back to raw arguments/result.
+
+The therapy-platform per-feature redactor lambdas are domain-specific
+(Art. 11 clinical scrubbing) and stay product-side; therapy's
+`audit_dispatch` wrapper composes those with the seed `get_writer` + the
+seed-side record construction.
+
+**`audit_chat_dispatch` async helper** — generalizes ERP's `_dispatch_chat`
+shape (monotonic-ns timing, success/failure audit row, exception re-raise
+with audit row landed first). Single-adopter today (ERP); ships at the
+seed so subsequent adopters consume rather than duplicate.
+
+Best-effort everywhere: audit-side failures NEVER raise to the caller.
+The seed `make_audit_writer` swallows DB errors; this module also catches
+exceptions in the redactor + record-construction path so audit gaps stay
+observable but never abort dispatch.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import TYPE_CHECKING, Any, Callable, Literal, Optional
+
+from .tool_audit import (
+    AuditRecord,
+    AuditWriter,
+    make_audit_writer,
+    now_utc,
+)
+
+if TYPE_CHECKING:
+    from sqlalchemy.engine import Engine
+    from sqlalchemy.orm import sessionmaker as SessionmakerType
+
+logger = logging.getLogger(__name__)
+
+
+OnMissingRedactor = Literal["over_redact", "passthrough"]
+
+
+def make_get_audit_writer_for_product(
+    *,
+    settings: Any,
+    table_class: type,
+    postgres_url_attr: str = "postgres_url",
+    pool_size: int = 2,
+    max_overflow: int = 2,
+    logger_name: Optional[str] = None,
+) -> tuple[Callable[[], AuditWriter], Callable[[], None]]:
+    """Build a product's `get_audit_writer()` + `reset_for_test()` pair.
+
+    Closes over the product's `settings` object and `ToolCallAudit` ORM
+    class. Returns:
+
+        get_audit_writer: () -> AuditWriter
+            Lazy-constructs the SQLAlchemy engine + sessionmaker on first
+            call. When `settings.<postgres_url_attr>` is empty, returns a
+            noop writer that debug-logs each call (audit-trail gap stays
+            observable). On engine-construction failure, also returns the
+            noop writer (logged at exception level).
+        reset_for_test: () -> None
+            Clears the cached engine + sessionmaker. Lets tests flip
+            `settings.postgres_url` between cases without surviving state.
+
+    Args:
+        settings: Product settings object (Pydantic model or namespace).
+            Read via `getattr(settings, postgres_url_attr, "")`.
+        table_class: The product's concrete `ToolCallAudit` ORM class
+            (subclass of the product's `Base`). Passed verbatim to the
+            seed `make_audit_writer(session, table_class)`.
+        postgres_url_attr: Settings attribute carrying the connection
+            string. Default `"postgres_url"` matches every adopter.
+        pool_size / max_overflow: Forwarded to `create_engine`. Defaults
+            match the byte-identical per-product shape.
+        logger_name: Logger used for noop / engine-failure messages.
+            Defaults to `__name__` (this module). Override when a product
+            wants log lines attributed to its own namespace.
+    """
+    log = logging.getLogger(logger_name) if logger_name else logger
+
+    # Module-state-equivalent closure cells. The closure replaces the
+    # per-product `_engine` + `_session_factory` module globals.
+    state: dict[str, Any] = {"engine": None, "session_factory": None}
+
+    def _get_engine_and_factory() -> tuple[Any, Any]:
+        """Lazy engine + sessionmaker. Returns (None, None) on missing URL
+        or engine construction failure."""
+        if state["engine"] is not None and state["session_factory"] is not None:
+            return state["engine"], state["session_factory"]
+        postgres_url = getattr(settings, postgres_url_attr, "") or ""
+        if not postgres_url:
+            return None, None
+        try:
+            from sqlalchemy import create_engine
+            from sqlalchemy.orm import sessionmaker
+
+            engine = create_engine(
+                postgres_url,
+                pool_pre_ping=True,
+                pool_size=pool_size,
+                max_overflow=max_overflow,
+            )
+            session_factory = sessionmaker(bind=engine, expire_on_commit=False)
+            state["engine"] = engine
+            state["session_factory"] = session_factory
+            return engine, session_factory
+        except Exception:
+            log.exception(
+                "audit_hook: failed to construct SQLAlchemy engine; "
+                "tool-call audit will skip writes"
+            )
+            return None, None
+
+    def _noop_writer(record: AuditRecord) -> None:
+        """Used when no Postgres connection is configured. Best-effort means
+        audit gaps are visible — log at debug so dev runs don't spam."""
+        log.debug(
+            "audit_hook: %s unset; skipping tool_call_audit write for tool=%s",
+            postgres_url_attr,
+            record.tool_name,
+        )
+
+    def get_audit_writer() -> AuditWriter:
+        """Return an `AuditWriter` bound to a fresh SQLAlchemy session per call.
+
+        Wraps `make_audit_writer(db, table_class)`. Each call opens a short-lived
+        session, writes the row, commits, and closes. When `postgres_url` is
+        unset, returns the noop writer.
+        """
+        _engine, session_factory = _get_engine_and_factory()
+        if session_factory is None:
+            return _noop_writer
+
+        def write(record: AuditRecord) -> None:
+            session = session_factory()
+            try:
+                inner = make_audit_writer(session, table_class)
+                inner(record)
+            finally:
+                session.close()
+
+        return write
+
+    def reset_for_test() -> None:
+        """Clear the lazy engine + sessionmaker cache. Tests should call
+        this after flipping `settings.postgres_url` between cases."""
+        state["engine"] = None
+        state["session_factory"] = None
+
+    return get_audit_writer, reset_for_test
+
+
+def build_audit_record_for_feature(
+    *,
+    feature_key: str,
+    tool_name: str,
+    status: str,
+    duration_ms: int,
+    get_feature: Callable[[str], Any],
+    arguments: Optional[dict[str, Any]] = None,
+    result: Any = None,
+    error: Optional[str] = None,
+    user_id: Optional[int] = None,
+    correlation_id: Optional[str] = None,
+    conversation_id: Optional[str] = None,
+    on_missing_redactor: OnMissingRedactor = "over_redact",
+) -> AuditRecord:
+    """Construct an `AuditRecord` after applying the feature's registered
+    redaction lambdas. Defaults to `"over_redact"` (drop on missing) —
+    LGPD-safe for sensitive products.
+
+    Args:
+        feature_key: Catalog key passed to `get_feature(feature_key)`.
+        get_feature: Catalog lookup callable. Typically
+            `noctusai_lib.domain.ai.get_feature` — passed by reference so
+            this helper doesn't take a hard dependency on consent-module
+            initialization order.
+        on_missing_redactor:
+            - `"over_redact"` (PF default) — when no redactor exists,
+              drop the field to `None`. Audit row keeps structural shape
+              but no free text. Safe for LGPD-sensitive products.
+            - `"passthrough"` — log debug + keep raw values. Used by
+              daily-life where audit content drives downstream analytics
+              and the consent surface gates the dispatch upstream.
+
+    A redactor raising is ALWAYS caught: logged at WARNING and the field
+    falls back to `None` (over-redact, never leak). The audit row still
+    lands so the failure is observable.
+    """
+    feature = None
+    try:
+        feature = get_feature(feature_key)
+    except Exception:
+        logger.warning(
+            "audit_hook: get_feature(%r) raised; treating as missing feature",
+            feature_key,
+        )
+
+    def _apply(redactor: Optional[Callable[[Any], Any]], value: Any, kind: str) -> Any:
+        if value is None:
+            return None
+        if redactor is None:
+            if on_missing_redactor == "over_redact":
+                logger.debug(
+                    "audit_hook: no %s redactor for feature=%s; dropping field",
+                    kind,
+                    feature_key,
+                )
+                return None
+            # passthrough
+            return value
+        try:
+            return redactor(value)
+        except Exception:
+            logger.warning(
+                "audit_hook: %s redactor raised for feature=%s; dropping field",
+                kind,
+                feature_key,
+            )
+            return None
+
+    redact_arguments = getattr(feature, "redact_arguments", None) if feature else None
+    redact_result = getattr(feature, "redact_result", None) if feature else None
+
+    if feature is None and on_missing_redactor == "passthrough":
+        logger.debug(
+            "audit_hook: feature_key=%s not in catalog — audit row uses raw "
+            "arguments/result",
+            feature_key,
+        )
+
+    safe_arguments = _apply(redact_arguments, arguments, "arguments")
+    safe_result = _apply(redact_result, result, "result")
+
+    # PF historically coerced non-dict redacted args into `{"_value": ...}`;
+    # preserve that behavior so audit row shape stays compatible with
+    # downstream consumers expecting a JSONB dict.
+    if safe_arguments is not None and not isinstance(safe_arguments, dict):
+        safe_arguments = {"_value": safe_arguments}
+
+    return AuditRecord(
+        tool_name=tool_name,
+        status=status,  # type: ignore[arg-type]
+        duration_ms=duration_ms,
+        started_at=now_utc(),
+        arguments=safe_arguments,
+        result=safe_result,
+        error=error,
+        user_id=user_id,
+        correlation_id=correlation_id,
+        conversation_id=conversation_id,
+    )
+
+
+async def audit_chat_dispatch(
+    *,
+    tool_name: str,
+    chat_call: Callable[..., Any],
+    get_writer: Callable[[], AuditWriter],
+    messages: list[dict[str, Any]],
+    arguments: Optional[dict[str, Any]] = None,
+    user_id: Optional[int] = None,
+    org_id: Optional[str] = None,
+    **chat_kwargs: Any,
+) -> Any:
+    """Wrap a chat-completion call with audit-row write on success + failure.
+
+    Generalizes the ERP `_dispatch_chat(...)` pattern. The audit writer is
+    obtained per call (so it picks up `reset_for_test` and lazy-init).
+
+    Best-effort guarantee: a failure in audit-write path NEVER masks the
+    original chat exception (or success result). If `chat_call` raises,
+    we attempt to write a `status="failure"` row, log any audit-side
+    exception, and re-raise the original.
+
+    Args:
+        tool_name: Audit row's `tool_name`.
+        chat_call: The chat-completion callable (`noctusai_lib.integrations.llm.chat_completion`
+            or a wrapped variant). Called as
+            `await chat_call(messages=messages, org_id=org_id, **chat_kwargs)`.
+        get_writer: Callable that returns the current `AuditWriter`.
+            Typically the product's `get_audit_writer` from
+            `make_get_audit_writer_for_product`.
+        messages / org_id / chat_kwargs: Forwarded to `chat_call`.
+        arguments: Logged as the audit row's `arguments`.
+        user_id: Stored on the audit row.
+    """
+    started_at = now_utc()
+    started_ns = time.monotonic_ns()
+    audit_writer = get_writer()
+
+    try:
+        result = await chat_call(messages=messages, org_id=org_id, **chat_kwargs)
+    except Exception as exc:
+        duration_ms = max(0, (time.monotonic_ns() - started_ns) // 1_000_000)
+        try:
+            audit_writer(
+                AuditRecord(
+                    tool_name=tool_name,
+                    status="failure",
+                    duration_ms=duration_ms,
+                    started_at=started_at,
+                    arguments=arguments,
+                    result=None,
+                    error=str(exc),
+                    user_id=user_id,
+                )
+            )
+        except Exception:
+            logger.exception(
+                "audit_chat_dispatch: audit-writer failed for tool=%s", tool_name
+            )
+        raise
+
+    duration_ms = max(0, (time.monotonic_ns() - started_ns) // 1_000_000)
+    try:
+        audit_writer(
+            AuditRecord(
+                tool_name=tool_name,
+                status="success",
+                duration_ms=duration_ms,
+                started_at=started_at,
+                arguments=arguments,
+                result={"content": result} if isinstance(result, str) else result,
+                user_id=user_id,
+            )
+        )
+    except Exception:
+        logger.exception(
+            "audit_chat_dispatch: audit-writer failed for tool=%s", tool_name
+        )
+
+    return result
+
+
+__all__ = [
+    "audit_chat_dispatch",
+    "build_audit_record_for_feature",
+    "make_get_audit_writer_for_product",
+    "OnMissingRedactor",
+]
