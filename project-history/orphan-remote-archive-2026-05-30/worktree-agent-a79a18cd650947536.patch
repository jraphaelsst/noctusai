+# ---------------------------------------------------------------------------
+# audit_chat_dispatch — generalized ERP `_dispatch_chat` shape.
+# ---------------------------------------------------------------------------
+
+
+class _RecordingWriter:
+    """Capture every `AuditRecord` the dispatch helper writes."""
+
+    def __init__(self) -> None:
+        self.records: list[AuditRecord] = []
+        self.fail_on_record = False
+
+    def __call__(self, record: AuditRecord) -> None:
+        if self.fail_on_record:
+            raise RuntimeError("audit-writer boom")
+        self.records.append(record)
+
+
+def _run(coro: Any) -> Any:
+    return asyncio.get_event_loop().run_until_complete(coro)
+
+
+def test_audit_chat_dispatch_success_writes_one_row() -> None:
+    """Successful chat call ⇒ one audit row with status=success + result captured."""
+    writer = _RecordingWriter()
+
+    async def _fake_chat(*, messages: list, org_id: Any = None, **_kw: Any) -> str:
+        return "hello back"
+
+    out = _run(
+        audit_chat_dispatch(
+            tool_name="demo.chat",
+            chat_call=_fake_chat,
+            get_writer=lambda: writer,
+            messages=[{"role": "user", "content": "hi"}],
+            arguments={"prompt_version": "v1"},
+            user_id=7,
+        )
+    )
+
+    assert out == "hello back"
+    assert len(writer.records) == 1
+    rec = writer.records[0]
+    assert rec.tool_name == "demo.chat"
+    assert rec.status == "success"
+    assert rec.user_id == 7
+    assert rec.arguments == {"prompt_version": "v1"}
+    assert rec.result == {"content": "hello back"}
+    assert rec.duration_ms >= 0
+
+
