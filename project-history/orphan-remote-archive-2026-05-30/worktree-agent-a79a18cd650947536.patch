@@ -0,0 +1,564 @@
+"""Tests for `noctusai_lib.domain.ai.audit_hook` — the per-product
+factory that lifts the duplicated lazy-engine + session-factory +
+noop-writer shape.
+
+Covers:
+  - `make_get_audit_writer_for_product` returns noop when settings has
+    no `postgres_url`.
+  - The returned writer caches engine state until `reset_for_test`.
+  - Engine construction failure surfaces as noop (not raise).
+  - `build_audit_record_for_feature` `"over_redact"` semantics —
+    missing redactor drops field.
+  - `build_audit_record_for_feature` `"passthrough"` semantics —
+    missing redactor keeps raw value.
+  - Redactor exception → field dropped + WARNING logged (never raise).
+  - Non-dict redacted args coerced to `{"_value": ...}` (PF
+    compatibility).
+  - `audit_chat_dispatch` success path writes one row with status="success"
+    + monotonic duration.
+  - `audit_chat_dispatch` failure path writes row with status="failure"
+    + re-raises original.
+  - `audit_chat_dispatch` audit-side failure NEVER masks chat exception.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from types import SimpleNamespace
+from typing import Any, Optional
+
+import pytest
+
+from noctusai_lib.domain.ai.audit_hook import (
+    audit_chat_dispatch,
+    build_audit_record_for_feature,
+    make_get_audit_writer_for_product,
+)
+from noctusai_lib.domain.ai.tool_audit import AuditRecord, now_utc
+
+
+# ---------------------------------------------------------------------------
+# Fakes — minimal session stand-ins. The factory is product-agnostic;
+# tests don't need a real engine for the noop-branch coverage.
+# ---------------------------------------------------------------------------
+
+
+class _FakeTableClass:
+    """Stand-in ORM class — accepts the kwargs `AuditRecord.to_row_kwargs`
+    emits. Per the seed contract, the only requirement is `TableClass(**kwargs)`
+    succeeds."""
+
+    def __init__(self, **kwargs: Any) -> None:
+        self.kwargs = kwargs
+
+
+# ---------------------------------------------------------------------------
+# Noop branch — the most common path in dev / test contexts without a
+# Postgres URL.
+# ---------------------------------------------------------------------------
+
+
+def test_make_get_audit_writer_noop_when_postgres_url_unset(caplog) -> None:
+    """No `postgres_url` in settings ⇒ noop writer returned. Debug log fires
+    so audit-trail gaps stay observable."""
+    settings = SimpleNamespace(postgres_url="")
+    get_writer, _reset = make_get_audit_writer_for_product(
+        settings=settings, table_class=_FakeTableClass
+    )
+
+    writer = get_writer()
+    with caplog.at_level(logging.DEBUG, logger="noctusai_lib.domain.ai.audit_hook"):
+        writer(
+            AuditRecord(
+                tool_name="seed.factory_test",
+                status="success",
+                duration_ms=0,
+                started_at=now_utc(),
+            )
+        )
+
+    assert any("postgres_url unset" in r.getMessage() for r in caplog.records)
+
+
+def test_make_get_audit_writer_noop_when_postgres_url_missing_attr(caplog) -> None:
+    """Settings without the attribute at all ⇒ noop (treated as empty)."""
+    settings = SimpleNamespace()  # no postgres_url attribute
+    get_writer, _reset = make_get_audit_writer_for_product(
+        settings=settings, table_class=_FakeTableClass
+    )
+
+    writer = get_writer()
+    with caplog.at_level(logging.DEBUG, logger="noctusai_lib.domain.ai.audit_hook"):
+        writer(
+            AuditRecord(
+                tool_name="x",
+                status="success",
+                duration_ms=1,
+                started_at=now_utc(),
+            )
+        )
+
+    assert any("postgres_url unset" in r.getMessage() for r in caplog.records)
+
+
+def test_make_get_audit_writer_custom_attr_name(caplog) -> None:
+    """`postgres_url_attr=` lets products with a different settings key
+    consume the factory unchanged."""
+    settings = SimpleNamespace(audit_db_dsn="")
+    get_writer, _reset = make_get_audit_writer_for_product(
+        settings=settings,
+        table_class=_FakeTableClass,
+        postgres_url_attr="audit_db_dsn",
+    )
+
+    writer = get_writer()
+    with caplog.at_level(logging.DEBUG, logger="noctusai_lib.domain.ai.audit_hook"):
+        writer(
+            AuditRecord(
+                tool_name="x",
+                status="success",
+                duration_ms=1,
+                started_at=now_utc(),
+            )
+        )
+
+    assert any("audit_db_dsn unset" in r.getMessage() for r in caplog.records)
+
+
+def test_reset_for_test_clears_engine_cache() -> None:
+    """After `reset_for_test`, flipping `postgres_url` to "" yields the
+    noop writer on the next `get_audit_writer()` call (no stale engine)."""
+    settings = SimpleNamespace(postgres_url="")
+    get_writer, reset = make_get_audit_writer_for_product(
+        settings=settings, table_class=_FakeTableClass
+    )
+
+    writer_a = get_writer()
+    # Both empty → noop. After reset, still empty → noop. (We can't easily
+    # exercise the real-engine path without sqlalchemy + a real DSN, so
+    # noop-after-reset is the empirical surface.)
+    reset()
+    writer_b = get_writer()
+
+    # Both are noop writers — confirmable because calling them does NOT raise
+    # (a real session_factory() in the cold path against a bogus URL would).
+    rec = AuditRecord(
+        tool_name="t", status="success", duration_ms=0, started_at=now_utc()
+    )
+    writer_a(rec)
+    writer_b(rec)  # MUST NOT raise
+
+
+def test_engine_construction_failure_falls_back_to_noop(caplog, monkeypatch) -> None:
+    """A bad `postgres_url` that raises in `create_engine` is caught + logged
+    at exception level. The returned writer is the noop, dispatch continues."""
+    settings = SimpleNamespace(postgres_url="not-a-real-dsn://bogus")
+    get_writer, _reset = make_get_audit_writer_for_product(
+        settings=settings, table_class=_FakeTableClass
+    )
+
+    # Force sqlalchemy.create_engine to raise — emulates a malformed DSN
+    # without depending on what sqlalchemy actually does with this string.
+    import sqlalchemy
+
+    def _boom(*_args: Any, **_kwargs: Any) -> Any:
+        raise RuntimeError("engine create failed")
+
+    monkeypatch.setattr(sqlalchemy, "create_engine", _boom)
+
+    with caplog.at_level(logging.ERROR, logger="noctusai_lib.domain.ai.audit_hook"):
+        writer = get_writer()
+        # The noop path doesn't raise — confirms we fell back.
+        writer(
+            AuditRecord(
+                tool_name="t",
+                status="success",
+                duration_ms=0,
+                started_at=now_utc(),
+            )
+        )
+
+    assert any(
+        "failed to construct SQLAlchemy engine" in r.getMessage()
+        for r in caplog.records
+    )
+
+
+# ---------------------------------------------------------------------------
+# build_audit_record_for_feature — redaction semantics.
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class _FakeFeature:
+    redact_arguments: Optional[Any] = None
+    redact_result: Optional[Any] = None
+
+
