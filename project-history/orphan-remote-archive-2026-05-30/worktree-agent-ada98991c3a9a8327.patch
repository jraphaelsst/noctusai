 # Team router — provided by seed framework
 # ---------------------------------------------------------------------------
 
+#: Default org_id used by team-router suites. Matches the ``org_id`` claim
+#: stamped onto ``MockUser`` by every product's ``client`` fixture (the
+#: seed-shipped conftest pattern). Production ``GET /api/team`` filters via
+#: ``noctus_users.select("*").eq("org_id", org_id)`` — seeded rows MUST
+#: carry the same value or SELECT-predicate evaluation (introduced by the
+#: ``mock-select-predicate-filter-fix-2026-05-11`` parallel work) returns []
+#: and ``test_list_members_returns_data`` 200s with ``len(data) == 0``.
+_DEFAULT_ORG_ID = "test-org-123"
+
 #: Default member fixture used by team-router suites. Override via class attr
 #: if your product needs a different shape.
 _DEFAULT_SAMPLE_MEMBER = {
@@ -69,6 +78,7 @@ _DEFAULT_SAMPLE_MEMBER = {
     "org_role": "member",
     "avatar_url": None,
     "created_at": "2026-01-01T00:00:00",
