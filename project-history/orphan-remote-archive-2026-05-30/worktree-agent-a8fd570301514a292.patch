+    def test_byte_identical_to_old_script(self, gen, tmp_path):
+        """gen_promotions_index output == former gen-promotions-index.py."""
+        # Identically-NAMED workspace dirs on each side so the header's
+        # `# Promotion Manifest Index — {name}` token matches (the only
+        # workspace-identity-derived byte); isolates rendering-logic parity.
+        (tmp_path / "old" / "myws").mkdir(parents=True)
+        (tmp_path / "new" / "myws").mkdir(parents=True)
+        ws_old = _mk_ws(tmp_path / "old" / "myws")
+        ws_new = _mk_ws(tmp_path / "new" / "myws")
