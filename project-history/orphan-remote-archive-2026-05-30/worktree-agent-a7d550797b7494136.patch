diff --git a/seed/lib/backend/noctusai_lib/api/__init__.py b/seed/lib/backend/noctusai_lib/api/__init__.py
index cd36debb..4bcadf07 100644
--- a/seed/lib/backend/noctusai_lib/api/__init__.py
+++ b/seed/lib/backend/noctusai_lib/api/__init__.py
@@ -18,7 +18,7 @@ contributes to a product's HTTP layer".
 - `auth.py` — JWT + SSO factories, `verify_*` helpers
 - `middleware.py` — correlation-ID middleware, request logger
 - `rate_limit.py` — slowapi `create_limiter(...)` factory (Redis-backed when reachable, in-memory fallback)
-- `rate_limit_policies.py` — canonical named policies (`DEFAULT_AI_RL` / `DEFAULT_AUTH_RL` / `DEFAULT_WEBHOOK_RL` / `DEFAULT_PORTAL_RL`); intent-encoded so per-product tuning lifts to one seed-side change
+- `rate_limit_policies.py` — canonical named policies (`DEFAULT_AI_RL` / `DEFAULT_AUTH_RL` / `DEFAULT_WEBHOOK_RL` / `DEFAULT_PORTAL_RL` / `DEFAULT_REGISTER_RL` / `DEFAULT_PRE_AUTH_STRICT_RL`); intent-encoded so per-product tuning lifts to one seed-side change. Register/OAuth/login/refresh use `DEFAULT_REGISTER_RL` (10/minute); change-password / forgot-password / admin-only test-account CRUD use `DEFAULT_PRE_AUTH_STRICT_RL` (5/minute).
 - `app_factory.py` — `create_product_app(...)` companion shim
 - `crud_safety.py` — `delete_with_existence_check` + `delete_or_404` (replaces the unreliable `.delete()` + `if not result.data` 404 shape)
 - `schemas.py` — `StrictHttpModel` base (Pydantic `extra="forbid"`) for HTTP-boundary request/response shapes; defends against silent-drop misroutes (see `KB § PATTERNS/pydantic-strict-http.md`).
diff --git a/seed/lib/backend/noctusai_lib/api/rate_limit_policies.py b/seed/lib/backend/noctusai_lib/api/rate_limit_policies.py
index ca38b81e..b0b6ffd9 100644
--- a/seed/lib/backend/noctusai_lib/api/rate_limit_policies.py
+++ b/seed/lib/backend/noctusai_lib/api/rate_limit_policies.py
@@ -60,10 +60,27 @@ DEFAULT_WEBHOOK_RL: str = "30/minute"
 # the per-token tenant scope is narrower than per-IP.
 DEFAULT_PORTAL_RL: str = "30/minute"
 
+# Register / OAuth / login / refresh endpoints — pre-auth and session-
+# bootstrap flows where a stricter cadence than the default auth bucket
+# is intentional (account-creation spam, credential stuffing). Tightened
+# from `DEFAULT_AUTH_RL` (30/minute) to 10/minute. Active occupants:
+# core /signup /login /refresh, core /oauth/callback, therapy /register/*.
+DEFAULT_REGISTER_RL: str = "10/minute"
+
+# Pre-auth strict + admin-strict + password-management endpoints —
+# the most sensitive cadence: change-password, forgot-password (reset
+# email trigger), and admin-only test-account CRUD. 5/minute reflects
+# the brute-force-resistance + abuse-resistance posture. Stricter than
+# `DEFAULT_REGISTER_RL` because side-effect cost is higher (email send,
+# org creation, license grants).
+DEFAULT_PRE_AUTH_STRICT_RL: str = "5/minute"
+
 
 __all__ = [
     "DEFAULT_AI_RL",
     "DEFAULT_AUTH_RL",
     "DEFAULT_WEBHOOK_RL",
     "DEFAULT_PORTAL_RL",
+    "DEFAULT_REGISTER_RL",
+    "DEFAULT_PRE_AUTH_STRICT_RL",
 ]
