 from __future__ import annotations
 
 import importlib
 import logging
+import os
 
 logger = logging.getLogger(__name__)
 
+# ---------------------------------------------------------------------------
+# JWT-shape SUPABASE_* placeholder pre-population (lifted from per-product
+# conftests; was previously duplicated at `products/therapy-platform/backend/
+# tests/conftest.py` module-top by Engineer T's `ef01f57`).
+#
+# Why module-level (not inside pytest_configure):
+# Product `app/main.py` is imported from `pytest_configure` below, which
+# triggers settings construction. Settings read `SUPABASE_URL` /
+# `SUPABASE_ANON_KEY` / `SUPABASE_SERVICE_ROLE_KEY` at attribute-access
+# time. The Supabase client also validates the key as a JWT regex
+# (`^[A-Za-z0-9-_=]+\.[A-Za-z0-9-_=]+\.?[A-Za-z0-9-_.+/=]*$`) — plain
+# "test" fails with "Invalid API key" at module-import. Setting these
+# placeholders at plugin module-load time guarantees they're present
+# before ANY `app.main` import (here OR in a product conftest).
+#
+# `setdefault` semantics: a real .env / CI secret wins; the placeholder
+# only fills the gap when the variable is genuinely unset. NO real
+# secrets — these never reach a real Supabase. Tests asserting real
+# network IO live under `tests/realdb/` and use their own env probe.
+# ---------------------------------------------------------------------------
+_FAKE_JWT = "aaa.bbb.ccc"
+os.environ.setdefault("SUPABASE_URL", "http://test.local")
+os.environ.setdefault("SUPABASE_ANON_KEY", _FAKE_JWT)
+os.environ.setdefault("SUPABASE_SERVICE_ROLE_KEY", _FAKE_JWT)
+
 
 def pytest_configure(config) -> None:  # noqa: D401 — pytest hook
     """Probe for `app.main` and import it to load the consent catalog.
