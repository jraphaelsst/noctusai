@@ -0,0 +1,86 @@
+"""Tests for `noctusai_lib.testing.pytest_plugin`.
+
+Two responsibilities under test:
+
+1. **JWT-shape SUPABASE_* placeholder pre-population** at plugin
+   module-load time (so `app.main` imports during `pytest_configure`
+   don't crash on missing/invalid Supabase env). `setdefault` semantics
+   are verified to preserve real env values.
+
+2. **`pytest_configure` probe** silently no-ops when `app.main` is not
+   on the import path (the seed-lib's own test session, this one).
+"""
+from __future__ import annotations
+
+import importlib
+import os
+import re
+
+import pytest
+
+
+_JWT_RE = re.compile(r"^[A-Za-z0-9-_=]+\.[A-Za-z0-9-_=]+\.?[A-Za-z0-9-_.+/=]*$")
+
+
+def test_supabase_placeholders_set_at_plugin_load() -> None:
+    """After plugin module-load, the three SUPABASE_* env vars are present
+    and the key vars match the JWT shape the Supabase client validates.
+
+    This guards against the regression where a product `app.main` import
+    crashes on `supabase_url is required` or `Invalid API key` because
+    no `.env` is wired in test sessions.
+    """
+    # The plugin is auto-loaded via the `pytest11` entry point in
+    # `seed/lib/backend/pyproject.toml`. Force-import is also safe
+    # (idempotent on os.environ.setdefault).
+    importlib.import_module("noctusai_lib.testing.pytest_plugin")
+
+    assert "SUPABASE_URL" in os.environ
+    assert "SUPABASE_ANON_KEY" in os.environ
+    assert "SUPABASE_SERVICE_ROLE_KEY" in os.environ
+
+    # Keys must satisfy the supabase-py JWT regex (header.body.signature).
+    assert _JWT_RE.match(os.environ["SUPABASE_ANON_KEY"]), (
+        f"SUPABASE_ANON_KEY {os.environ['SUPABASE_ANON_KEY']!r} fails JWT shape"
+    )
+    assert _JWT_RE.match(os.environ["SUPABASE_SERVICE_ROLE_KEY"]), (
+        f"SUPABASE_SERVICE_ROLE_KEY {os.environ['SUPABASE_SERVICE_ROLE_KEY']!r} fails JWT shape"
+    )
+
+
+def test_setdefault_preserves_existing_values(monkeypatch: pytest.MonkeyPatch) -> None:
+    """`os.environ.setdefault` MUST NOT overwrite a real env value (real
+    Supabase credentials in CI / realdb runs).
+
+    Simulate the real-env case by setting a sentinel, re-importing the
+    plugin module fresh, and asserting the sentinel survived.
+    """
+    sentinel_url = "https://real-supabase.example.test"
+    sentinel_anon = "real.anon.key"
+    sentinel_service = "real.service.key"
+    monkeypatch.setenv("SUPABASE_URL", sentinel_url)
+    monkeypatch.setenv("SUPABASE_ANON_KEY", sentinel_anon)
+    monkeypatch.setenv("SUPABASE_SERVICE_ROLE_KEY", sentinel_service)
+
+    # Re-import fresh so the module-level setdefault block re-runs.
+    import sys as _sys
+    _sys.modules.pop("noctusai_lib.testing.pytest_plugin", None)
+    importlib.import_module("noctusai_lib.testing.pytest_plugin")
+
+    assert os.environ["SUPABASE_URL"] == sentinel_url
+    assert os.environ["SUPABASE_ANON_KEY"] == sentinel_anon
+    assert os.environ["SUPABASE_SERVICE_ROLE_KEY"] == sentinel_service
+
+
+def test_pytest_configure_silent_noop_when_app_main_absent() -> None:
+    """In the seed-lib's own test session (this one), `app.main` does NOT
+    resolve. `pytest_configure` MUST silently no-op (the seed-lib's tests
+    are running right now — if it raised, this assertion would never run).
+    """
+    from noctusai_lib.testing import pytest_plugin
+
+    class _FakeConfig:
+        pass
+
+    # Should not raise — silent return path for ModuleNotFoundError.
+    pytest_plugin.pytest_configure(_FakeConfig())
