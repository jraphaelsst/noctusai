     assert "<unknown>" in str(excinfo.value)
+
+
+# ---------------------------------------------------------------------------
+# Backstop: allow_origin_regex is wired when cors_origins='@registry:all'
+# and PRODUCT_URL_PATTERN is a subdomain-style template.
+#
+# Gate↔methodology-sync: the regex IS the compliance-by-construction
+# mechanism (a new product is covered automatically). This test prevents
+# a future refactor from silently dropping allow_origin_regex from the
+# CORSMiddleware mount.
+# ---------------------------------------------------------------------------
+
+
+def _make_registry_all_settings(monkeypatch, pattern: str):
+    """Build a BaseAppSettings stub in @registry:all mode."""
+    import os
+
+    monkeypatch.setenv("PRODUCT_URL_PATTERN", pattern)
+    from noctusai_lib.config.settings import BaseAppSettings
+
+    s = BaseAppSettings(cors_origins="@registry:all")
+    # cors_origins_list may need the start.sh; provide localhost alts as fallback.
+    # The middleware stack test only cares that allow_origin_regex is wired.
+    return s
+
+
+def _get_cors_middleware_kwargs(app) -> dict:
+    """Extract the kwargs passed to CORSMiddleware from the app's middleware stack."""
+    from starlette.middleware.cors import CORSMiddleware as StarletteCorsMW
+
+    for middleware in app.user_middleware:
+        # Starlette wraps middleware as Middleware(cls, **options).
+        cls = getattr(middleware, "cls", None)
+        kwargs = getattr(middleware, "kwargs", {})
+        if cls is StarletteCorsMW or (
+            cls is not None and issubclass(cls, StarletteCorsMW)
+        ):
+            return kwargs
+    return {}
+
+
+def test_allow_origin_regex_wired_for_registry_all_with_subdomain_pattern(
+    monkeypatch,
+) -> None:
+    """CORSMiddleware receives a non-None allow_origin_regex when using
+    @registry:all + a subdomain-style PRODUCT_URL_PATTERN.
+
+    This is the gate↔methodology-sync backstop: the regex is the
+    compliance-by-construction seam that covers future products automatically.
+    If this test fails, the seam was dropped from app_factory.
+    """
+    import re
+
+    from fastapi import FastAPI
+
+    from noctusai_lib.api.app_factory import configure_app
+
+    settings = _make_registry_all_settings(monkeypatch, "https://{slug}.noctusai.com")
+
+    app = FastAPI()
+    configure_app(app, settings, allow_credentials=True)
+
+    cors_kwargs = _get_cors_middleware_kwargs(app)
+    regex = cors_kwargs.get("allow_origin_regex")
+
+    assert regex is not None, (
+        "allow_origin_regex was not passed to CORSMiddleware. "
+        "The SSO by-construction seam is broken — future product origins will "
+        "be CORS-blocked until someone hand-adds a PRODUCT_URL_<SLUG> env var."
+    )
+    # Sanity: the regex actually matches a real first-party origin.
+    assert re.fullmatch(regex, "https://orbity.noctusai.com"), (
+        f"The derived regex {regex!r} does not match the expected origin."
+    )
+    # And it rejects a known-bad origin.
+    assert not re.fullmatch(regex, "https://evil.com"), (
+        f"The derived regex {regex!r} incorrectly matches https://evil.com."
+    )
+
+
+def test_allow_origin_regex_is_none_for_plain_csv_settings(monkeypatch) -> None:
+    """Plain enumerated cors_origins → allow_origin_regex=None (tight allowlist)."""
+    from fastapi import FastAPI
+
+    from noctusai_lib.api.app_factory import configure_app
+
+    monkeypatch.setenv("PRODUCT_URL_PATTERN", "https://{slug}.noctusai.com")
+
+    app = FastAPI()
+    plain_settings = _make_settings(["https://app.example.com"])
+
+    configure_app(app, plain_settings, allow_credentials=True)
+
+    cors_kwargs = _get_cors_middleware_kwargs(app)
+    assert cors_kwargs.get("allow_origin_regex") is None
