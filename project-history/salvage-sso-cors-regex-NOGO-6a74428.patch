+    @property
+    def cors_origin_regex(self) -> Optional[str]:
+        """Derive a FastAPI ``allow_origin_regex`` for the SSO-bridge shape.
+
+        Only active when ``cors_origins == "@registry:all"`` AND
+        ``PRODUCT_URL_PATTERN`` is set to a subdomain-style template (e.g.
+        ``https://{slug}.noctusai.com``). Returns an anchored regex that matches
+        any valid first-party product subdomain — so adding a product to the fleet
+        is automatically covered by CORS with NO core rebuild and NO new
+        ``PRODUCT_URL_<SLUG>`` env var.
+
+        Single-product apps (``@registry:own`` or a plain CSV string) keep a
+        tight explicit allowlist and get ``None`` here (no regex broadening).
+
+        **Deploy-aware / no-op in dev.** When no ``PRODUCT_URL_PATTERN`` is set
+        (local dev), :func:`derive_cors_origin_regex` returns ``None`` — this
+        property follows suit.
+
+        See :func:`noctusai_lib.config.cors_registry.derive_cors_origin_regex`.
+        """
+        if self.cors_origins != "@registry:all":
+            return None
+        # Lazy import — mirrors cors_origins_list's lazy import of cors_registry.
+        from noctusai_lib.config.cors_registry import derive_cors_origin_regex
+
+        return derive_cors_origin_regex()
+
     @property
     def is_production(self) -> bool:
         return not self.debug
