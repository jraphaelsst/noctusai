     assert "http://localhost:5173" in origins  # localhost set still present
+
+
+# ---------------------------------------------------------------------------
+# derive_cors_origin_regex — core logic
+# ---------------------------------------------------------------------------
+
+
+_PROD_PATTERN = "https://{slug}.noctusai.com"
+
+
+def test_regex_subdomain_pattern_matches_valid_products() -> None:
+    """Subdomain-style pattern → regex that matches any first-party product origin."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    # Must match real first-party product origins.
+    assert re.fullmatch(regex, "https://orbity.noctusai.com")
+    assert re.fullmatch(regex, "https://erp.noctusai.com")
+    assert re.fullmatch(regex, "https://whatever-new.noctusai.com")
+    # Hyphenated slug (e.g. erp-imobiliario is served as erp-imobiliario).
+    assert re.fullmatch(regex, "https://erp-imobiliario.noctusai.com")
+
+
+def test_regex_subdomain_pattern_rejects_wrong_scheme() -> None:
+    """http:// must NOT match an https:// pattern."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    assert not re.fullmatch(regex, "http://orbity.noctusai.com")
+
+
+def test_regex_subdomain_pattern_rejects_evil_domain() -> None:
+    """A completely different domain is rejected."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    assert not re.fullmatch(regex, "https://evil.com")
+
+
+def test_regex_subdomain_pattern_rejects_suffix_hijack() -> None:
+    """orbity.noctusai.com.evil.com must NOT match (suffix trick)."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    assert not re.fullmatch(regex, "https://orbity.noctusai.com.evil.com")
+
+
+def test_regex_subdomain_pattern_rejects_apex() -> None:
+    """Apex origin (no subdomain slug) must NOT match — must stay explicit."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    # https://noctusai.com has no slug label — the regex requires one.
+    assert not re.fullmatch(regex, "https://noctusai.com")
+
+
+def test_regex_subdomain_pattern_rejects_extra_label() -> None:
+    """sub.orbity.noctusai.com has an extra label — must NOT match."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    assert not re.fullmatch(regex, "https://sub.orbity.noctusai.com")
+
+
+def test_regex_literal_dot_is_anchored() -> None:
+    """The '.' in '.noctusai.com' is escaped to '\\.' so 'X' doesn't match it."""
+    regex = derive_cors_origin_regex(_PROD_PATTERN)
+    assert regex is not None
+    # Replace the literal dot in the domain part with an arbitrary char.
+    # If '.' were unescaped in the regex it would match — it must NOT.
+    assert not re.fullmatch(regex, "https://orbityXnoctusai.com")
+    assert not re.fullmatch(regex, "https://orbity.noctusaiXcom")
+
+
+def test_regex_no_pattern_returns_none(monkeypatch: pytest.MonkeyPatch) -> None:
+    """No argument and no env var → None (dev no-op)."""
+    monkeypatch.delenv("PRODUCT_URL_PATTERN", raising=False)
+    assert derive_cors_origin_regex() is None
+
+
+def test_regex_no_pattern_arg_none_returns_none(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Explicit None arg + no env var → None."""
+    monkeypatch.delenv("PRODUCT_URL_PATTERN", raising=False)
+    assert derive_cors_origin_regex(None) is None
+
+
+def test_regex_path_style_pattern_returns_none() -> None:
+    """Path-style pattern (slug in path, not authority) → None.
+
+    An Origin header has no path, so a path-regex would never match. The
+    function detects this and returns None, deferring to explicit allow_origins.
+    """
+    assert derive_cors_origin_regex("https://app.noctusai.com/{slug}") is None
+
+
+def test_regex_slug_underscored_variant() -> None:
+    """{slug_underscored} pattern produces a regex that allows underscore slugs."""
+    regex = derive_cors_origin_regex("https://{slug_underscored}.noctusai.com")
+    assert regex is not None
+    # An underscored slug (e.g. erp_imobiliario) must match.
+    assert re.fullmatch(regex, "https://erp_imobiliario.noctusai.com")
+    # But hyphens are NOT in the underscore class.
+    assert not re.fullmatch(regex, "https://erp-imobiliario.noctusai.com")
+    # Evil domains still rejected.
+    assert not re.fullmatch(regex, "https://evil.com")
+
+
+def test_regex_is_anchored_end_to_end() -> None:
+    """The regex must use ^ and $ anchors so partial matches are rejected."""
