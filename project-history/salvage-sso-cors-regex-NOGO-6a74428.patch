+def derive_cors_origin_regex(pattern: Optional[str] = None) -> Optional[str]:
+    """Derive a FastAPI ``allow_origin_regex`` from ``PRODUCT_URL_PATTERN``.
+
+    **Deploy-aware / no-op in dev.** When ``PRODUCT_URL_PATTERN`` is set to a
+    subdomain-style template such as ``https://{slug}.noctusai.com``, this
+    returns an anchored regex that matches ANY valid first-party product
+    subdomain — so a product added to the fleet is automatically covered by the
+    SSO-bridge CORS policy WITHOUT a core rebuild or a new ``PRODUCT_URL_<SLUG>``
+    env var. When no pattern is set (local dev, container without the env) the
+    function returns ``None``, which is the FastAPI ``allow_origin_regex=None``
+    no-op (no regex broadening).
+
+    **Subdomain-style only.** The ``Origin`` header carries only
+    ``scheme://authority`` (no path). A path-style pattern such as
+    ``https://app.noctusai.com/{slug}`` shares a SINGLE authority, so a
+    path-matching regex would never be compared against an ``Origin`` header at
+    all. Such patterns are detected and return ``None`` — the caller must rely on
+    the explicit ``allow_origins`` list instead (``PRODUCT_URL_<SLUG>`` env vars
+    or hardcoded entries).
+
+    Slug character classes used in the regex:
+
+    - ``{slug}``            → ``[a-z0-9](?:[a-z0-9-]*[a-z0-9])?``
+      (RFC-1123 label; hyphens allowed mid-label, not at edges)
+    - ``{slug_underscored}`` → ``[a-z0-9](?:[a-z0-9_]*[a-z0-9])?``
+      (same but underscore instead of hyphen for legacy naming styles)
+
+    Args:
+        pattern: URL pattern string, e.g. ``https://{slug}.noctusai.com``.
+            Defaults to ``os.environ.get("PRODUCT_URL_PATTERN")``.
+
+    Returns:
+        An anchored regex string (``^...$``) or ``None``.
+    """
+    if pattern is None:
+        pattern = os.environ.get("PRODUCT_URL_PATTERN")
+    if not pattern:
+        return None
+
+    # -------------------------------------------------------------------------
+    # Parse the pattern to locate the scheme and authority (host[:port]).
+    # The Origin header is ONLY scheme://authority — never has a path. A pattern
+    # whose slug placeholder appears only in the path portion cannot be matched
+    # via allow_origin_regex and must fall back to explicit allow_origins.
+    #
+    # Strategy: split on "://" to get scheme, then take everything before the
+    # first "/" (or end-of-string) as the authority template.
+    # -------------------------------------------------------------------------
+    _SLUG_PLACEHOLDER = "{slug}"
+    _SLUG_UNDERSCORED_PLACEHOLDER = "{slug_underscored}"
+
+    if "://" not in pattern:
+        logger.debug(
+            "derive_cors_origin_regex: pattern lacks '://', cannot derive regex — "
+            "pattern=%r",
+            pattern,
+        )
+        return None
+
+    after_scheme = pattern.split("://", 1)[1]
+    # authority = everything before the first "/"
+    authority_template = after_scheme.split("/", 1)[0]
+
+    # The slug placeholder must be inside the authority for the regex to be
+    # meaningful against Origin headers.
+    has_slug_in_authority = (
+        _SLUG_PLACEHOLDER in authority_template
+        or _SLUG_UNDERSCORED_PLACEHOLDER in authority_template
+    )
+    if not has_slug_in_authority:
+        logger.debug(
+            "derive_cors_origin_regex: no slug placeholder in authority %r; "
+            "path-style pattern — returning None (use explicit allow_origins)",
+            authority_template,
+        )
+        return None
+
+    # -------------------------------------------------------------------------
+    # Build the regex over scheme://authority.
+    #
+    # Sentinel-swap approach so re.escape() doesn't mangle the slug class we
+    # are about to inject:
+    #   1. Replace each placeholder with a unique sentinel that contains NO
+    #      regex-special chars and NO chars re.escape touches.
+    #   2. re.escape() the whole origin template (escapes literal dots, etc.).
+    #   3. Swap sentinels back to the slug character classes.
+    #   4. Wrap in ^...$  anchors.
+    # -------------------------------------------------------------------------
+    # Use the scheme + authority only (no path) — Origin header has no path.
+    scheme = pattern.split("://", 1)[0]
+    origin_template = f"{scheme}://{authority_template}"
+
+    _SENTINEL_SLUG = "XSLUGX"
+    _SENTINEL_SLUG_UNDERSCORED = "XSLUGUNDERSCOREDX"
+    # Slug char classes (RFC-1123 label; hyphens / underscores mid-label).
+    _CLASS_SLUG = r"[a-z0-9](?:[a-z0-9\-]*[a-z0-9])?"
+    _CLASS_SLUG_UNDERSCORED = r"[a-z0-9](?:[a-z0-9_]*[a-z0-9])?"
+
+    # Step 1 — sentinel replacement (order: longer name first to avoid partial
+    # replacement if one is a prefix of the other).
+    swapped = origin_template.replace(_SLUG_UNDERSCORED_PLACEHOLDER, _SENTINEL_SLUG_UNDERSCORED)
+    swapped = swapped.replace(_SLUG_PLACEHOLDER, _SENTINEL_SLUG)
+
+    # Step 2 — escape all remaining literal regex chars (dots become \., etc.).
+    escaped = re.escape(swapped)
+
+    # Step 3 — inject the slug character classes back (re.escape turns
+    # the sentinel letters into themselves — no special chars in sentinels).
+    result = escaped.replace(_SENTINEL_SLUG_UNDERSCORED, _CLASS_SLUG_UNDERSCORED)
+    result = result.replace(_SENTINEL_SLUG, _CLASS_SLUG)
+
+    # Step 4 — anchor.
+    regex = f"^{result}$"
+
+    logger.debug(
+        "derive_cors_origin_regex: pattern=%r → regex=%r",
+        pattern,
+        regex,
+    )
+    return regex
+
+
 __all__ = [
     "LOCALHOST_ALT_PORTS",
     "ProductEntry",
+    "derive_cors_origin_regex",
     "derive_cors_origins",
     "parse_products_registry",
 ]
