+def _raw_workflow(**overrides: object) -> dict:
+    base = {
+        "id": "wf1",
+        "name": "Flow",
+        "active": True,
+        "isArchived": False,
+        "tags": [],
+        "nodes": [{"type": "n8n-nodes-base.webhook", "parameters": {"path": "p", "httpMethod": "GET"}}],
+        "createdAt": "2026-07-16T00:00:00.000Z",
+        "updatedAt": "2026-07-16T01:00:00.000Z",
+    }
+    base.update(overrides)
+    return base
+
