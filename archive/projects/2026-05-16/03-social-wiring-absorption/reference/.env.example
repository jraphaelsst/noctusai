# YouTube Crawler — environment template.
# Copy to .env and fill in real values:  cp .env.example .env
#
# IMPORTANT — values that contain SPACES must be wrapped in double quotes.
# start.sh runs `source .env`, and bash interprets the first space as the
# end of the assignment, then tries to execute the rest as a command. A
# canonical offender is GOOGLE_OAUTH_SCOPES (space-separated URL list):
#
#   WRONG:  GOOGLE_OAUTH_SCOPES=https://...calendar https://...drive
#   RIGHT:  GOOGLE_OAUTH_SCOPES="https://...calendar https://...drive"
#
# Comma-separated values (CORS_ORIGINS, META_OAUTH_SCOPES) don't need
# quotes — no spaces, no shell interpretation drama.

# ─── Workspace pointer ───────────────────────────────────────────────
# Path to the noc repo. The Dockerfiles use this as an additional build
# context to pull seed packages into the image (the workspace's `seed/`
# is a symlink, which Docker COPY can't follow).
NOCTUSAI_HOME=/Users/rapha/Documents/repository/NoctusAI/noctusai

# ─── YouTube Data API v3 ─────────────────────────────────────────────
# Generate OAuth 2.0 credentials at https://console.cloud.google.com/
# Scopes required: youtube.upload, youtube.readonly, youtube.force-ssl
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8010/api/youtube/oauth/callback
FRONTEND_BASE_URL=http://localhost:8150

# ─── OpenAI chatbot orchestration ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
WHATSAPP_CHATBOT_ENABLED=true

# ─── Conversation buffer (Redis-backed, seed-driven) ─────────────────
# Debounce: how long to wait after a WhatsApp inbound before firing the
# LLM. New inbounds within the window reset the timer, so multi-message
# intents (code in msg1, drive URL in msg2 a few seconds later) get
# processed in a single tick. 8s mirrors the seed default; tune up if
# users type slower, down for snappier replies.
MESSAGE_DEBOUNCE_SECONDS=8
# How long a conversation's memory list survives in Redis after the
# last touch (seconds). 1h matches the operator's per-property session
# duration.
CONVERSATION_MEMORY_TTL_SECONDS=3600
# Split the bot's reply on \n\n + send one WAHA message per paragraph
# so the chat reads as a natural back-and-forth instead of a wall of
# text. Set false to revert to the legacy single-message behavior.
WHATSAPP_PARAGRAPH_SPLIT=true
# Inter-paragraph send delay (seconds). 0.6s reads as snappy-but-natural
# in manual testing; raise for slower clients, drop for tighter cadence.
WHATSAPP_PARAGRAPH_DELAY_SECONDS=0.6
# Interim "ping" messages during long uploads ("📥 Baixando do Drive…",
# "📤 Subindo pro YouTube…"). Useful for debugging the pipeline; turn
# off for production where the operator doesn't need the chatter.
WHATSAPP_PROGRESS_PINGS=true
# Keep the explicit "Confirma upload? (sim/não)" step before triggering
# the upload (default true, human-in-the-loop on). Flip to false to
# auto-proceed once the regex/LLM has both code + Drive URL.
YOUTUBE_AUTO_CONFIRMATION_MESSAGE=true

# ─── Upload pipeline tuning ─────────────────────────────────────────
# Max uploads in-flight at the same time across the whole product.
# 1 = global single-flight (safest for YT quota); bump for higher
# throughput when traffic grows.
UPLOAD_MAX_CONCURRENT=1
# Hours to keep a Drive folder download cached on disk for retries +
# multi-video flows. 24h is a healthy default; lower for fuller disk
# turnover, higher if uploads tend to fail + need same-day re-runs.
DOWNLOAD_CACHE_TTL_HOURS=24

# ─── Listing page + agent contact (post-upload tail) ────────────────
# Listing-page URL template — ``{code}`` gets substituted with the
# property's ONE code in the post-upload WhatsApp message. Leave empty
# to omit the "Anúncio:" line.
LISTING_URL_TEMPLATE=https://oneconsultoriaimobiliaria.com.br/imovel/{code}
# WhatsApp number for the "talk to the agent" CTA in the post-upload
# message. The bot builds a wa.me link; non-digits get stripped.
# Single number for v1; per-agent routing is a future improvement.
DEFAULT_AGENT_WHATSAPP=5511974693365

# Fernet key for encrypting refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── SMTP (Gmail with App Password) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ─── WAHA (WhatsApp HTTP API) ────────────────────────────────────────
# Leave WAHA_BASE_URL empty for FakeWahaClient fallback (no real WhatsApp
# delivery; safe for dev). Use http://waha:3000 when running the WAHA
# service from this docker-compose stack.
WAHA_IMAGE=devlikeapro/waha:arm
WAHA_BASE_URL=http://waha:3000
# Leave WAHA_API_KEY empty — ./start.sh generates a random value on first
# run and writes it back here. Both the app and waha containers read it
# from .env at compose time, so the app authenticates to WAHA via
# X-Api-Key without any manual step. Set a value yourself only if you
# need to pin a specific key (e.g. to match an external worker).
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DASHBOARD_URL=http://localhost:3000/dashboard
WAHA_WEBHOOK_URL=
WAHA_WEBHOOK_HMAC_SECRET=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin

# ─── Database ────────────────────────────────────────────────────────
# Use sqlite during local development to avoid touching Supabase.
DATABASE_BACKEND=sqlite
SQLITE_PATH=tmp/dev.sqlite3
LOCAL_DEV_ORG_ID=00000000-0000-4000-8000-000000000001
LOCAL_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Supabase remains the production backend. Leave these empty when
# DATABASE_BACKEND=sqlite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Vista CRM ───────────────────────────────────────────────────────
# Server-only. Never expose as VITE_*.
VISTA_BASE_URL=https://your-tenant-rest.vistahost.com.br
VISTA_API_KEY=your-vista-api-key
CRM_BASE_URL=https://your-tenant-rest.vistahost.com.br
CRM_API_KEY=your-vista-api-key

# ─── Cloudflare tunnel ───────────────────────────────────────────────
TUNNEL_HOSTNAME=

# ─── Google integrations (Calendar OAuth + service-account + Maps) ───
# Ported from whatsapp-google-scheduling. Same env var names so an
# operator who already has working credentials there can copy them
# verbatim.
#
# OAuth client (lets the chatbot create events that add real attendees
# + send invite emails). Register a redirect URI in Google Cloud Console
# matching GOOGLE_OAUTH_REDIRECT_URI EXACTLY, then visit
# /api/calendar/oauth/start to consent once.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/api/calendar/oauth/callback
GOOGLE_OAUTH_ACCOUNT_EMAIL=

# Scope strategy (parallels META_OAUTH_SCOPES):
#   "auto" (recommended) — use the in-code kitchen-sink list covering
#     Calendar + Drive + identity (Calendar + Drive read + Drive write
#     scoped to app-created files + Drive metadata read). The code is
#     the source of truth, .env doesn't need maintenance.
#   "<space- or comma-separated full Google scope URLs>" — pin
#     explicitly when you need a different set.
#
# IMPORTANT: scopes requested at consent MUST also be added in the GCP
# Console → APIs & Services → OAuth Consent Screen → Scopes. Google
# blocks scopes that aren't configured there.
#
# See /api/google/scopes for a live four-layer view (configured /
# kitchen-sink default / granted-to-user / declined-by-user).
GOOGLE_OAUTH_SCOPES=auto

# Service-account path (works without consent, but cannot add
# attendees on personal-Gmail calendars). The target calendar must be
# shared with the service-account email at "Make changes to events".
# Place the JSON under ./secrets/ (gitignored) and reference by path.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Default calendar id + timezone the chatbot writes to / reads from
# when the user doesn't specify.
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=America/Sao_Paulo

# Google Maps Routes API key (works for Routes + Geocoding + Places).
# Used by the chatbot's `travel_estimate` tool.
GOOGLE_MAPS_API_KEY=

# ─── Meta (Facebook + Instagram) read-only ───────────────────────────
# 1. Create a Meta app at https://developers.facebook.com/apps/
# 2. Add the products: "Facebook Login" + "Instagram Graph API"
# 3. Under Facebook Login → Settings → Valid OAuth Redirect URIs,
#    register META_OAUTH_REDIRECT_URI EXACTLY (incl. trailing slash)
# 4. Copy App ID + App Secret from Settings → Basic
# 5. Set META_APP_ID + META_APP_SECRET below, then visit
#    /api/meta/oauth/start to consent.
META_APP_ID=
META_APP_SECRET=
# System User Token — PRODUCTION-GRADE auth for backend automation
# against Business Portfolio-owned Pages + IG accounts. When set,
# this token is used INSTEAD of the OAuth flow (which Meta gates for
# BM-owned assets in dev mode). Generate at:
#   business.facebook.com → Settings → Usuários do sistema →
#   [your bot user] → Gerar novo token → pick the app + scopes
# Token never expires while the System User retains asset access.
# Recommended for any server-to-server use case.
META_SYSTEM_USER_TOKEN=
# Tunnel-aware redirect URI; the cloudflare-tunnel refresh script can
# rewrite this in lockstep with GOOGLE_OAUTH_REDIRECT_URI.
META_OAUTH_REDIRECT_URI=http://localhost:8010/api/meta/oauth/callback
# Pin a Graph API version. v21.0 is the current stable (Jan 2026);
# v22.0 ships in May 2026. Bump deliberately, not silently.
META_GRAPH_API_VERSION=v21.0
# Scope strategy:
#   "auto"          — discover from Meta's app permissions endpoint at
#                     consent time, fall back to a kitchen-sink list
#                     (recommended — no manual maintenance)
#   "" (empty)      — same as "auto"
#   "a,b,c,..."     — pin to a specific comma-separated list
#
# See /api/meta/scopes for a live view of what's configured vs. what
# Graph reports vs. what the user actually granted.
META_OAUTH_SCOPES=auto

# ─── LLM (seed default-wired via create_product_app lifespan) ────────
# Either ANTHROPIC_API_KEY or OPENAI_API_KEY is enough for the seed's
# default LLM config to come up. Both unset → LLM-dependent endpoints
# (transcribe, vision, chat completion) will surface a clear error at
# request time; non-LLM endpoints work unaffected.
ANTHROPIC_API_KEY=

# ─── Frontend (vite) ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8010
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key
