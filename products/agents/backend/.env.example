# agents — backend
#
# `ProductSettings` reads the ROOT `.env` (not a local `.env` in this
# directory) — see products/agents/docker-compose.yml's
# `env_file: - ../../.env`. SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY / CORS_ORIGINS / JWT_SECRET already come from
# the root `.env`; this file documents only the ADDITIONAL variables this
# product needs — copy them into the root `.env`, never here (this file is
# NOT loaded at runtime).
#
# Placeholders only — this repo is PUBLIC. No client, company or knowledge
# content in this file or any fixture.

# 🔴 See the root .env.example's agents block for a CUTOVER FINDING before
# filling this in for prod: the bare ANTHROPIC_API_KEY name collides with
# the platform's generic per-product LLM key on the SAME shared root
# `.env`, contradicting contract §E.5's "never shared" requirement. Not
# fixed in this slice (needs a compose-level override at cutover, not an
# app-code change) — tracked for M6.
ANTHROPIC_API_KEY=

# Product token this product holds to call academia-de-reciclagem's HTTP
# API (contract §C / §E.5). Minted via academia's admin token-mint route
# with `principal_agent_id` = ACADEMIA_AGENT_ID below.
ACADEMIA_API_TOKEN=

# The agent id the academia token is bound to (contract §D `sub` claim;
# a Studio agent since the Renata cutover). Must equal
# ACADEMIA_API_TOKEN's `principal_agent_id` exactly. BIA_AGENT_ID is the
# deprecated name (still read, logged once).
ACADEMIA_AGENT_ID=

# Token this product holds to call social-wiring's scoped One Chat bridge
# (contract §E.6) — read/toggle scopes only, issuer=agents.
SOCIAL_WIRING_API_TOKEN=

# HS256 key(s) this product SIGNS `X-Approval-Assertion` headers with
# (contract §D) — signs with element [0]. Comma-separated; MUST match (or
# be a superset of) academia's key list. Empty → refuses to start in a
# deploy context.
APPROVAL_ASSERTION_SECRETS=

# Optional — sane defaults, override only if wrong for prod:
# APPROVAL_TIMEOUT_SECONDS=900
# MESSAGES_RATE_LIMIT=20/minute
# CLAUDE_CLI_PATH=/app/bin/bia-cli-exec
