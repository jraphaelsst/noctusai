# Store — backend
#
# `ProductSettings` reads the `.env` at the ROOT of the monorepo (not one local
# to this directory). SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# and CORS_ORIGINS already come from there — this file documents only the
# variables the store ADDS. Placeholders only: never commit a real value.

# ── Asaas (hosted one-off checkout) ─────────────────────────────────────────
# Sandbox by default. Production is an explicit opt-in:
#   ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Shared secret Asaas sends in the `asaas-access-token` header. Unset => every
# webhook delivery is a 401 (fail closed). Use the same value when registering
# the webhook (https://<host>/api/webhooks/asaas) in the Asaas dashboard.
ASAAS_WEBHOOK_TOKEN=

# A missing ASAAS_API_KEY refuses checkout (503) UNLESS this is true. Local dev /
# test harness ONLY — never set it in production (a silent Fake would hand a
# paying buyer a fake checkout URL, and a Fake email sender would "deliver" nothing).
PAYMENTS_ALLOW_FAKE=false

# ── Public site ─────────────────────────────────────────────────────────────
# Origin of the storefront, no trailing slash. Builds the Asaas successUrl
# ({STORE_PUBLIC_URL}/obrigado?pedido=<token>) and the e-mail download link.
STORE_PUBLIC_URL=https://store.noctusai.com

# ── Admin (the owner only) ──────────────────────────────────────────────────
# Comma-separated e-mails, case-insensitive. Empty => nobody is an admin and
# every /api/admin/* route answers 403.
STORE_ADMIN_EMAILS=owner@example.com

# ── Delivery e-mail (seed make_email_sender, SMTP) ──────────────────────────
# All of host/port/username/password must be set; otherwise a delivery e-mail
# FAILS LOUDLY (recorded on the pedido, re-sendable from /admin/vendas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
EMAIL_FROM=
EMAIL_FROM_NAME=Contrato Blindado

# ── Rate limits (per visitor IP; slowapi syntax) — defaults shown ───────────
# WEBHOOK_RATE_LIMIT=60/minute
# PUBLIC_READ_RATE_LIMIT=120/minute
# CHECKOUT_RATE_LIMIT=10/minute;60/hour
# DOWNLOAD_RATE_LIMIT=30/minute
