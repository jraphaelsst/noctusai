# Store — backend
#
# `ProductSettings` reads the `.env` at the ROOT of the monorepo (not one local
# to this directory). SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# and CORS_ORIGINS already come from there — this file documents only what the
# store ADDS. Placeholders only: never commit a real value.
#
# 🔑 Keys and tokens are NOT env vars. The Asaas API key, the Asaas webhook
# token and the Asaas environment (sandbox | production) are written by the owner
# in the admin UI, Fernet-encrypted into `store.credentials`, and resolved
# through `noctusai_lib.security.api_keys.resolve_api_key` (local store ->
# platform chain -> env fallback). SMTP (smtp_host/port/username/password/
# security, email_from, email_from_name) comes from the PLATFORM chain
# (org_settings / platform_settings / env), not from the store.

# Fernet key that encrypts the DB-stored keys. REQUIRED to write a key from the UI:
# unset => the key routes answer 503 (nothing is ever stored in plaintext). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUTSIDE the database; rotating it makes already-stored keys unreadable.
ENCRYPTION_KEY=

# The owner's org (single-tenant): every managed key is stored and resolved under it.
#   SELECT id FROM public.organizations WHERE slug = '<owner org slug>';
STORE_ORG_ID=00000000-0000-0000-0000-000000000000

# Origin of the storefront, no trailing slash. Builds the Asaas successUrl
# ({STORE_PUBLIC_URL}/obrigado?pedido=<token>) and the e-mail download link.
STORE_PUBLIC_URL=https://store.noctusai.com

# Comma-separated e-mails (case-insensitive) allowed into the admin routes. Empty =>
# nobody is admin and every /api/admin/* and /api/settings/api-keys* route is 403.
STORE_ADMIN_EMAILS=owner@example.com

# A missing Asaas key refuses checkout (503) UNLESS this is true. Local dev / test
# harness ONLY — never in production (a Fake would hand a paying buyer a fake
# checkout URL and "deliver" nothing).
PAYMENTS_ALLOW_FAKE=false

# ── Rate limits (per visitor IP; slowapi syntax) — defaults shown ───────────
# WEBHOOK_RATE_LIMIT=60/minute
# PUBLIC_READ_RATE_LIMIT=120/minute
# CHECKOUT_RATE_LIMIT=10/minute;60/hour
# DOWNLOAD_RATE_LIMIT=30/minute
