# Imobi Scheduling — backend environment template.
#
# Copy to .env and fill in. Empty values keep the schema valid for early-dev
# but disable the corresponding integration (e.g. empty WAHA_BASE_URL → seed
# factory returns FakeWahaClient per `KB § PATTERNS/seed-fake-real-adapter.md`).
#
# This file lives alongside the product because no platform-wide backend
# `.env.example` template exists yet — first product to ship one. If a second
# product needs a backend env template, lift this shape into
# `templates/product-seed/backend/` per the recurrence rule (N=2 → triage time).

# ── Supabase (inherited from BaseAppSettings — required for live DB) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# ── CORS / app ──
CORS_ORIGINS=http://localhost:8011,http://localhost:8160,http://localhost:5173,http://localhost:3000

# ── Webhook receiver — placeholder vendor (legacy from scaffolded webhook_router) ──
# Used by `app/routers/webhook_router.py` (Svix scheme). Empty → bypass mode.
EXAMPLE_WEBHOOK_SECRET=

# ── Phase 5 — WhatsApp / WAHA ──
# Real WAHA endpoint (e.g. `http://localhost:3000` or a tunnel URL).
# Empty → seed factory returns FakeWahaClient (no real outbound).
WAHA_BASE_URL=
# Optional Bearer token if the WAHA server requires authentication.
WAHA_API_KEY=
# WAHA session name (single-session per deployment in v1).
WAHA_SESSION_NAME=imobi_scheduling
# HMAC-SHA256 hex secret WAHA signs inbound webhooks with. When empty the
# seed router skips signature verification + logs a WARNING — set this to
# enforce pins 1-3 of the webhook 5-pin compliance contract.
IMOBI_WHATSAPP_WEBHOOK_SECRET=

# Conversation framework knobs (consumed Phase 6).
CONVERSATION_MEMORY_TTL_SECONDS=3600
MESSAGE_DEBOUNCE_SECONDS=8

# ── Phase 8 — Google Calendar (forward-compat stubs) ──
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=

# ── Phase 8 — Google Maps (forward-compat stubs) ──
GOOGLE_MAPS_API_KEY=

# ── Phase 6 — LLM (forward-compat) ──
OPENAI_MODEL=gpt-4o-mini

# ── Phase 7 — Scheduling engine (forward-compat stubs) ──
IMOBI_SCHEDULING_TIMEZONE=America/Sao_Paulo
IMOBI_SCHEDULING_MORNING_START=09:00
IMOBI_SCHEDULING_MORNING_END=12:00
IMOBI_SCHEDULING_AFTERNOON_START=13:30
IMOBI_SCHEDULING_AFTERNOON_END=18:00
