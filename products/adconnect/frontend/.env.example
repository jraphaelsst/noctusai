# NoctusAI {{PRODUCT_NAME}} — Frontend Environment Variables
# Var definitions: shared/frontend/src/env.ts (single source of truth)
# Copy this file to .env and fill in the values.

# Supabase project URL (required by shared createProductSupabase)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (required by shared createProductSupabase)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key

# Product backend API URL
VITE_BACKEND_API_URL=http://localhost:{{BACKEND_PORT}}

# Core platform frontend URL (SSO redirect, navigation)
VITE_CORE_URL=http://localhost:5173

# Core platform backend API URL (SSO token exchange)
VITE_CORE_API_URL=http://localhost:8000
