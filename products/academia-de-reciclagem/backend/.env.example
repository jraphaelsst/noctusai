# academia-de-reciclagem — backend
#
# `ProductSettings` reads the ROOT `.env` (not a local `.env` in this
# directory) — see products/academia-de-reciclagem/docker-compose.yml's
# `env_file: - ../../.env`. SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY / CORS_ORIGINS / JWT_SECRET already come from
# the root `.env`; this file documents only the ADDITIONAL variables this
# product needs — copy them into the root `.env`, never here (this file is
# NOT loaded at runtime).
#
# Placeholders only — this repo is PUBLIC. No client, company or knowledge
# content in this file or any fixture.

# HS256 key(s) this product VERIFIES `X-Approval-Assertion` headers
# against (contract §D, projects/julia-agents-academia-CONTRACT.md).
# Comma-separated; accepts ANY element. Must equal (or include) `agents`'
# signing key. Empty → refuses to start in a deploy context.
APPROVAL_ASSERTION_SECRETS=

# Comma-separated hostnames trusted as primary sources for
# POST /api/sources (contract §B.5). Empty by default (every host gets a
# warning until configured).
PRIMARY_SOURCE_ALLOWLIST=
