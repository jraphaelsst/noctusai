{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@noctusai/shared/*": ["../../../seed/frontend/lib/src/*"],
      "@noctusai/shared": ["../../../seed/frontend/lib/src/index.ts"],
      "@noctusai/seed/*": ["../../../seed/frontend/framework/src/*"],
      "@noctusai/seed": ["../../../seed/frontend/framework/src/index.ts"]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}
