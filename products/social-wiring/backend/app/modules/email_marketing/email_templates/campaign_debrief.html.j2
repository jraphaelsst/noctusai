{% extends "_digest_base.html.j2" %}

{% block header %}Debrief da campanha — {{ campaign_name }}{% endblock %}

{% block body %}
<table style="width:100%;border-collapse:collapse;margin:16px 0;font-size:14px">
  <tbody>
    {% for row in metric_rows %}
    <tr>
      <td style="padding:6px 12px;border-bottom:1px solid #eee">{{ row.label }}</td>
      <td style="padding:6px 12px;border-bottom:1px solid #eee;text-align:right">{{ row.value }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h3 style="margin:20px 0 8px 0;font-size:16px">Resumo</h3>
{% for para in narrative_paragraphs %}
<p style="margin:8px 0">{{ para }}</p>
{% endfor %}

<h3 style="margin:20px 0 8px 0;font-size:16px">Links mais clicados</h3>
<table style="width:100%;border-collapse:collapse;font-size:14px">
  <thead>
    <tr style="background:#f7f7f7">
      <th style="padding:6px 12px;text-align:left">URL</th>
      <th style="padding:6px 12px;text-align:right">Cliques</th>
    </tr>
  </thead>
  <tbody>
    {% for url, count in top_links[:5] %}
    <tr>
      <td style="padding:6px 12px;border-bottom:1px solid #eee;font-family:monospace;font-size:12px">{{ url }}</td>
      <td style="padding:6px 12px;border-bottom:1px solid #eee;text-align:right">{{ count }}</td>
    </tr>
    {% else %}
    <tr><td colspan="2" style="padding:6px 12px;color:#888">(sem cliques)</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}

{% block footer %} · prompt {{ prompt_version }}{% endblock %}
