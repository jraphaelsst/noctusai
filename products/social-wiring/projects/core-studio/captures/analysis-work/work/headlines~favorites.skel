  <body>
    <script ./back/dist/js/demo-theme.min.js>
    <script inline>
    <div class="mainContainerV2">
      <div class="containerAsideV2 card">
        <aside class="contentAsideV2" data-bs-theme="dark">
          <div class="headerAsideV2 d-flex">
            <button class="navbar-toggler" id="toggleSidebarButtonV2" type="button">
            <a href>
            <hr class="m-0 p-0">
          <div class="containerBodyAsideV2">
            <div class="bodyAsideV2" id="sidebar-menu">
              <ul class="navbar-nav">
                <li class="nav-item navLinkV2 ">
                  <a class="nav-link m-0 p-0" href="https://corestudio.ai/dashboard/user">
                    <section>
                      <div>
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                        <p class="nav-link-title m-0">
                          "Dashboard"
                <li class="nav-item navLinkV2 ">
                  <a class="nav-link m-0 p-0" href="https://corestudio.ai/dashboard/user/chat">
                    <section>
                      <div>
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
