                <li class="nav-item navDropdownV2 ">
                  <section>
                    <div>
                      <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <p class="nav-link-title">
                        "Pesquisa"
                  <div class="asideDropdownItemV2 ">
                    <div class="dropdownMenuColumnsV2">
                      <a class href="https://corestudio.ai/dashboard/user/searches">
                        "Minha Pesquisa"
                      <a class href="https://corestudio.ai/dashboard/user/searches/extract-profile">
                        "Extrair Pesquisa"
                <li class="nav-item navLinkV2 ">
                  <a class="nav-link m-0 p-0 w-100" href="https://corestudio.ai/dashboard/user/cores">
                    <section class="w-100">
                      <div>
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                        <p class="nav-link-title m-0">
                          "Segundo Cérebro"
                <li class="nav-item navLinkV2 " title="Exclusivo para o Plano Premium">
                  <a class="nav-link m-0 p-0 w-100" href="https://corestudio.ai/dashboard/user/library">
                    <section class="w-100">
                      <div>
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                        <p class="nav-link-title m-0">
                          "Biblioteca"
                <li class="nav-item navDropdownV2 active">
                  <section>
                    <div>
                      <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <p class="nav-link-title m-0">
                        "Configurações"
                  <div class="asideDropdownItemV2 d-block">
                    <div class="dropdownMenuColumnsV2">
                      <a class href="https://corestudio.ai/dashboard/user/profile">
                        "Minha conta"
                      <a class href="https://corestudio.ai/dashboard/user/my-library">
                        "Minha Biblioteca"
                      <a class href="https://corestudio.ai/dashboard/user/trainings">
                        "Treinamentos"
                      <div class="subMenuV2 open">
                        <div class="subMenuTriggerV2">
                          <span>
                            "Headlines"
                        <div class="subMenuItemsV2">
                          <a class href="https://corestudio.ai/dashboard/user/headlines/generate">
                            "Gerar Headlines"
                          <a class href="https://corestudio.ai/dashboard/user/headlines/favorites">
                            "Headlines Favoritas"
                          <a class href="https://corestudio.ai/dashboard/user/headlines/suggested">
                            "Headlines sugeridas"
                      <a class href="https://corestudio.ai/dashboard/user/roadmaps">
                        "Roteiros"
            <header class=" d-print-none h-auto">
              <section class="sectionProfileV2 m-0">
                <div class="d-flex" style="height: 45px">
                  <div class="avatarV2">
                    "GT"
                  <div class="boxtextV2">
                    <p class="m-0" style="font-size: 1rem">
                      "Gilson"
                    <span style="color: #FFFFFF80;">
                      "My Workspace"
                <div class="dropdownMenuProfileV2 modalAnimation">
                  <div class="dropdownMenuProfileHeaderV2">
                    <h3 class="m-0">
                      "Espaços de trabalho"
                  <form action="https://corestudio.ai/dashboard/user/workspace/switch" method="post">
                    <input type="hidden" name="_token" value="HWvJLPiqDMlGcMojApMxvY6o0HwI3pvpTwhyUCdC">
                    <ul class="dropdownMenuProfileBodyV2">
                      <li>
                        <button type="submit" name="workspace_id" value="1619" style="width: 100%; background: none; border: none" class="active">
                          "My Workspace"
                  <a href="javascript:;" class="dropdownMenuProfileTutorialV2" data-bs-toggle="modal" data-bs-target="#modal-first-access-tutorial" title="Assistir ao tutorial de boas-vindas">
                    <span>
                      "Ver tutorial novamente"
                  <a class="dropdownMenuProfileFooterV2">
                    "Fazer logout"
                <form id="logout-form" action="https://corestudio.ai/logout" method="POST" style="display: none;">
                  <input type="hidden" name="_token" value="HWvJLPiqDMlGcMojApMxvY6o0HwI3pvpTwhyUCdC">
          <div class="modal fade custom-slide" id="modal-create-workspace">
            <div class="modal-dialog modal-dialog-centered d-flex justify-content-center" style="min-width: fit-content !important;">
              <div class="modal-content card" style="width: min(650px, 100vw)">
                <header class="d-flex justify-content-between align-items-center flex-row" style="padding: 20px; border-bottom: 1px solid #E1C8FF26; height: fit-content !important">
                  <h2 class="m-0">
                    "Adicionar Workspace"
                <form id="customers-workspace-create" method="post" style="padding: 20px;">
                  <input type="hidden" name="customer_id" value="1667">
                  <h3 class="mb-2">
                    "Nome"
                  <input type="text" class="form-control" value="My Workspace 2" name="name" placeholder="Ex.. My Workspace 2">
                <footer class="d-flex justify-content-end align-items-center" style="padding: 20px; border-top: 1px solid #E1C8FF26; gap: 20px">
                  <button data-bs-dismiss="modal" type="button">
                    "Cancelar"
                  <button form="customers-workspace-create" id="create_workspace" type="submit">
                    "Criar"
          <script inline>
      <a data-bs-toggle="offcanvas" href="#offcanvasEnd" role="button" class="card card-link card-link-pop j_headline_icon_box" style="display:none">
        <div class="card-body">
          <div class="col-auto">
            <span class="badge bg-blue badge-notification badge-blink" style="left: -15px;width: 1rem;height: 1rem;">
            <span class="bg-red-lt avatar">
      <div class="offcanvas offcanvas-end j_headline_content_box" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
        <div class="offcanvas-header">
          <h2 class="offcanvas-title" id="offcanvasEndLabel">
            "Headlines na Box"
          <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close">
        <div class="offcanvas-body">
          <form id="box-headlines-save" method="post">
            <div class="mb-2">
              <a href="javascript:;" class="j_box_remove_headlines" style="display: flex;flex-direction: row-reverse;">
                "Remover selecionados"
            <div class="j_box-headlines-list">
            <div class="card-footer mt-3 text-end">
              <div class="d-flex">
                <button id="box_save_headlines" class="btn btn-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#modal-box-headlines-save">
                  "Salvar Headlines"
      <div class="mainContentV2">
        <div class="top-header-v2" x-data="notificationsDropdown()" @click.away="open = false">
          <div class="top-header-v2-inner">
            <div class="notification-bell-wrapper" style="position: relative;">
              <button class="notification-bell-btn" @click="toggle()" type="button">
                <span class="notification-badge" x-show="unreadCount > 0" x-text="unreadCount > 9 ? '9+' : unreadCount" x-cloak>
              <div class="notification-dropdown" x-show="open" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-[-8px]" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-[-8px]">
                <div class="notification-dropdown-header">
                  <span class="notification-dropdown-title">
                    "Notificações"
                  <div class="notification-header-actions">
                    <button class="notification-mark-all" @click="markAllRead()" x-show="unreadCount > 0" type="button">
                      "Marcar todas como lidas"
                    <button class="notification-toggle-read" @click="toggleShowRead()" x-show="readCount > 0" type="button">
                      <span x-text="showRead ? 'Ocultar lidas' : 'Ver já lidas'">
                <div class="notification-dropdown-body">
                  <template x-if="notifications.length === 0">
                    <div class="notification-empty">
                      <p>
                        "Nenhuma notificação por aqui"
                  <template x-for="n in notifications" :key="n.id">
                    <a :href="n.link || '#'" class="notification-item" :class="{ 'unread': n.status === 0 }" @click="markRead(n)">
                      <div class="notification-item-icon" :class="'type-' + n.type">
                        <template x-if="n.icon">
                          <span x-text="n.icon">
                        <template x-if="!n.icon">
                      <div class="notification-item-content">
                        <div class="notification-item-title" x-text="n.title">
                        <div class="notification-item-body" x-text="n.body" x-show="n.body">
                        <div class="notification-item-time" x-text="timeAgo(n.created_at)">
                      <div class="notification-item-dot" x-show="n.status === 0">
        <script inline>
        <div class="modal fade" id="advancedRoadmapModal" aria-labelledby="advancedRoadmapModalLabel">
          <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content roadmap-modal-premium">
              <div class="modal-header roadmap-modal-header">
                <div class="d-flex align-items-center gap-3">
                  <div class="roadmap-modal-icon">
                  <div>
                    <h5 class="modal-title mb-0 fw-semibold" id="advancedRoadmapModalLabel">
                      "Roteiro Avançado"
                    <p class="text-muted small mb-0 mt-0 lh-1">
                      "Crie um roteiro avançado em 3 passos"
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar">
              <div class="modal-body roadmap-modal-body">
                <div id="advancedRoadmapCreatingState" style="display: none;">
                  <div class="text-center py-4">
                    <div class="spinner-border text-purple mb-3" role="status">
                      <span class="visually-hidden">
                        "Processando..."
                    <h6 class="text-muted">
                      "Criando roteiro avançado com IA..."
                    <p class="text-muted small">
                      "Este processo passa por 2 etapas de análise e pode levar até 2 minutos"
                    <div class="progress mt-3" style="height: 8px;">
                      <div class="progress-bar progress-bar-striped progress-bar-animated bg-purple" role="progressbar" style="width: 0%" id="advancedProgressBar">
                    <div class="mt-3">
                      <small class="text-muted">
                        <span id="advancedProgressStatus">
                          "Iniciando processamento..."
                      <div id="advancedArticleSearchStatus" class="text-muted small mt-2" style="display: none;">
                <div id="advancedRoadmapLoadingLinksState" style="display: none;">
                  <div class="text-center py-5">
                    <div class="spinner-border text-purple mb-4" role="status" style="width: 3rem; height: 3rem;">
                      <span class="visually-hidden">
                        "Buscando..."
                    <h5 class="mb-3 fw-bold">
                      "🔍 Buscando informações na internet"
                    <p class="text-muted mb-4" id="loadingLinksMessage">
                      "Entendendo a busca necessária para seu roteiro..."
                    <div class="progress mt-3 mx-auto" style="height: 10px; max-width: 400px;">
                      <div class="progress-bar progress-bar-striped progress-bar-animated bg-purple" role="progressbar" style="width: 0%" id="loadingLinksProgressBar">
                <div id="advancedRoadmapSelectLinksState" style="display: none;">
                  <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                      <div>
                        <h5 class="mb-1 fw-bold">
                          "📋 Selecione os links relevantes"
                        <p class="text-muted small mb-0">
                          "O sistema encontrou informações relevantes. Selecione até"
                          <strong id="maxLinksCount">
                            "2"
                          "links por categoria para incluir no roteiro."
                      <div class="text-end">
                        <span class="badge bg-purple" id="selectedLinksCount">
                          "0 selecionados"
                    <div id="linksContainer" class="mb-4">
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                      <button type="button" class="btn btn-outline-secondary" id="backToFormFromLinksBtn">
                        "Voltar"
                      <button type="button" class="btn btn-purple" id="continueWithSelectedLinksBtn" disabled>
                        "Continuar com links selecionados"
                <div id="advancedRoadmapFormState" class="roadmap-form-premium">
                  <input type="hidden" id="advancedRoadmapHeadlineId" name="headline_id">
                  <input type="hidden" id="advancedRoadmapAI" name="ai_provider" value="claude">
                  <input type="hidden" id="advancedRoadmapChatResourceId" name="chat_resource_id" value>
                  <input type="hidden" id="advancedRoadmapIdForUpdate" value>
                  <input type="hidden" id="advancedRoadmapChatResourceType" value="user_roadmaps">
                  <input type="hidden" id="saveToTable" name="save_to" value="user_roadmaps">
                  <input type="hidden" id="roadmapSourceType" name="roadmap_source_type" value>
                  <input type="hidden" id="roadmapUsePubmed" name="roadmap_use_pubmed" value="0">
                  <input type="hidden" id="roadmapIsReprocess" name="is_reprocess" value="0">
                  <div id="step1Container" class="roadmap-form-section">
                    <label class="roadmap-form-label">
                      "Headline"
                    <p class="roadmap-form-hint">
                      "Base do roteiro. Se veio de sugerida ou favorita, já está preenchida."
                    <textarea class="form-control roadmap-input" id="advancedRoadmapHeadline" placeholder="Ex: 3 alimentos que aumentam testosterona">
                  <div id="step2Container" class="roadmap-form-section">
                    <label class="roadmap-form-label">
                      "Instruções"
                    <p class="roadmap-form-hint">
                      "Tom, público-alvo, o que pode ou não falar. Quanto mais detalhes, melhor."
                    <textarea class="form-control roadmap-input" id="advancedRoadmapObservations" name="observations" placeholder="Ex: Não falar de suplementos; tom leve; público 25–40 anos; evitar jargões médicos…">
                  <div id="step3Container" class="roadmap-form-section">
                    <label class="roadmap-form-label">
                      "Fonte das informações"
                    <p class="roadmap-form-hint mb-4">
                      "Escolha a origem das informações para o roteiro."
                    <div class="row g-3 mb-0">
                      <div class="col-md-4">
                        <div class="roadmap-source-card roadmap-source-none cursor-pointer" id="sourceOptionNone" data-source="none">
                          <div class="roadmap-source-card-inner">
                            <div class="roadmap-source-icon-wrap roadmap-source-icon-none">
                            <h6 class="roadmap-source-title">
                              "Deixe a IA pensar"
                            <p class="roadmap-source-desc">
                              "Sem fontes externas. Só headline e instruções."
                      <div class="col-md-4">
                        <div class="roadmap-source-card roadmap-source-links cursor-pointer" id="sourceOptionLinks" data-source="links">
                          <div class="roadmap-source-card-inner">
                            <div class="roadmap-source-icon-wrap roadmap-source-icon-links">
                            <h6 class="roadmap-source-title">
                              "Link específico"
                            <p class="roadmap-source-desc">
                              "URLs de artigos ou páginas como base."
                      <div class="col-md-4">
                        <div class="roadmap-source-card roadmap-source-serper cursor-pointer" id="sourceOptionSerper" data-source="serper">
                          <div class="roadmap-source-card-inner">
                            <div class="roadmap-source-icon-wrap roadmap-source-icon-serper">
                            <h6 class="roadmap-source-title">
                              "Pesquisar na web"
                            <p class="roadmap-source-desc">
                              "Busca na internet e usa os resultados."
                    <div id="roadmapSourceFieldsBelow" class="roadmap-source-below mt-4" style="display: none;">
                      <div id="sourceLinksPanel" class="roadmap-source-panel" style="display: none;">
                        <label class="roadmap-form-label">
                          "URLs para usar como base"
                        <p class="roadmap-form-hint mb-3">
                          "Adicione um ou mais links. Depois clique em"
                          <strong>
                            "Criar Roteiro"
                          "."
                        <div id="sourceLinksContainer" class="roadmap-source-fields-inner mb-2">
                          <div class="input-group input-group-sm mb-2">
                            <input type="url" class="form-control form-control-sm roadmap-input roadmap-link-input" placeholder="https://…" data-index="0">
                            <button type="button" class="btn btn-outline-danger btn-sm btn-remove-link" data-index="0" style="display: none;" title="Remover">
                              "×"
                        <button type="button" class="btn btn-sm btn-outline-primary roadmap-btn-add-link" id="btnAddMoreLinks">
                          <span class="roadmap-btn-add-link-icon">
                            "+"
                          "Adicionar novo link"
                      <div id="sourceSerperPanel" class="roadmap-source-panel roadmap-serper-section" style="display: none;">
                        <p class="roadmap-serper-notice text-muted small mb-3">
                          "Por padrão as buscas são feitas em"
                          <strong>
                            "inglês"
                          "para melhores resultados, mesmo que você digite em português."
                        <div class="roadmap-serper-search-bar mb-3">
                          <div class="input-group roadmap-serper-input-wrap">
                            <span class="input-group-text roadmap-serper-icon">
                            <input type="text" class="form-control form-control-lg roadmap-input" id="serperQueryInput" placeholder="Pesquisar na web…">
                            <button type="button" class="btn btn-primary roadmap-btn-serper-search" id="btnSerperSearch">
                              "Pesquisar"
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                          <label class="form-check mb-0 roadmap-form-check-pubmed">
                            <input type="checkbox" class="form-check-input" id="serperUsePubmed" name="use_pubmed" value="1">
                            <span class="form-check-label">
                              "[PubMed] Incluir artigos científicos"
                          <label class="form-check mb-0 roadmap-form-check-portuguese">
                            <input type="checkbox" class="form-check-input" id="serperSearchInPortuguese" name="serper_search_in_portuguese" value="1">
                            <span class="form-check-label">
                              "Quero buscar em português"
                        <div id="serperSelectedWrap" class="roadmap-serper-selected-wrap mb-3" style="display: none;">
                          <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="roadmap-form-label mb-0">
                              "Selecionados"
                            <span class="badge bg-primary text-white" id="serperSelectedCount">
                              "0"
                          <div id="serperSelectedContainer" class="roadmap-serper-selected-list">
                        <div id="serperResultsWrap" class="roadmap-serper-results-wrap" style="display: none;">
                          <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="roadmap-form-label mb-0">
                              "Resultados"
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnTranslateSerperResults" title="Traduzir resultados para português">
                              "Traduzir resultados"
                          <div id="serperResultsContainer" class="roadmap-serper-results">
                        <div id="serperLoadingState" class="roadmap-serper-loading text-center py-5" style="display: none;">
                          <div class="spinner-border text-primary mb-2" role="status">
                          <p class="text-muted small mb-0">
                            "Buscando na web…"
                        <div id="serperEmptyState" class="roadmap-serper-empty text-center py-2 text-muted small" style="display: none;">
                          "Digite algo acima e clique em"
                          <strong>
                            "Pesquisar"
                          "para buscar na web."
                  <div class="row g-3 mt-4">
                    <div class="col-md-4">
                      <div id="stepDurationContainer" class="roadmap-form-section roadmap-duration-inline">
                        <label class="roadmap-form-label">
                          "Duração do vídeo"
                        <p class="roadmap-form-hint mb-2">
                          "Defina um tempo-alvo."
                        <select class="form-select form-select-sm roadmap-input roadmap-duration-select" id="roadmapDurationMinutes" name="duration_minutes">
                          <option value="auto" selected>
                            "Auto (recomendado)"
                          <option value="1">
                            "~1 min"
                          <option value="2">
                            "~2 min"
                          <option value="3">
                            "~3 min"
                    <div class="col-md-8">
                      <div id="roadmapCoreOptionalSection" class="roadmap-form-section">
                        <label class="roadmap-form-label">
                          "Segundo Cérebro (opcional)"
                        <p class="roadmap-form-hint mb-2">
                          "Adicione um cérebro personalizado ao contexto."
                        <input type="hidden" id="roadmapCoreId" name="core_id" value>
                        <select class="form-select roadmap-input" id="selectCoreForRoadmap" style="max-width: 100%;">
                          <option value>
                            "— Nenhum —"
                          <option value="8">
                            "História de Criação"
                          <option value="9">
                            "Histórias de Vida do Especialista"
                          <option value="14">
                            "Método do Especialista"
                          <option value="3081">
                            "Núcleo de Influência"
                          <option value="3741">
                            "Call de diagnóstico"
                          <option value="4191">
                            "Formulário"
                          <option value="4192">
                            "Narrativa"
                  <div id="roadmapVideoModelSection" class="roadmap-form-section roadmap-video-model-section mt-4">
                    <label class="roadmap-form-label">
                      "Vídeo da biblioteca (opcional)"
                    <p class="roadmap-form-hint mb-3">
                      "Use um vídeo viral como referência de formato e estrutura. Ao escolher, o vídeo selecionado aparecerá aqui com opção de remover."
                    <input type="hidden" id="selectedViralVideoId" name="viral_video_id" value>
                    <button type="button" class="btn btn-sm btn-outline-primary roadmap-btn-open-library" id="btnOpenLibrary">
                      "Abrir biblioteca e escolher vídeo"
