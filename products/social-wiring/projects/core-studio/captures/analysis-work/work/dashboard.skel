                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar">
              <div class="modal-body roadmap-modal-body">
                <div id="advancedRoadmapCreatingState" style="display: none;">
                  <div class="text-center py-4">
                    <div class="spinner-border text-purple mb-3" role="status">
                      <span class="visually-hidden">
                        "Processando..."
                    <h6 class="text-muted">
                      "Criando roteiro avançado com IA..."
                    <p class="text-muted small">
                      "Este processo passa por 2 etapas de análise e pode levar até 2 minutos"
                    <div class="progress mt-3" style="height: 8px;">
                      <div class="progress-bar progress-bar-striped progress-bar-animated bg-purple" role="progressbar" style="width: 0%" id="advancedProgressBar">
                    <div class="mt-3">
                      <small class="text-muted">
                        <span id="advancedProgressStatus">
                          "Iniciando processamento..."
                      <div id="advancedArticleSearchStatus" class="text-muted small mt-2" style="display: none;">
                <div id="advancedRoadmapLoadingLinksState" style="display: none;">
                  <div class="text-center py-5">
                    <div class="spinner-border text-purple mb-4" role="status" style="width: 3rem; height: 3rem;">
                      <span class="visually-hidden">
                        "Buscando..."
                    <h5 class="mb-3 fw-bold">
                      "🔍 Buscando informações na internet"
                    <p class="text-muted mb-4" id="loadingLinksMessage">
                      "Entendendo a busca necessária para seu roteiro..."
                    <div class="progress mt-3 mx-auto" style="height: 10px; max-width: 400px;">
                      <div class="progress-bar progress-bar-striped progress-bar-animated bg-purple" role="progressbar" style="width: 0%" id="loadingLinksProgressBar">
                <div id="advancedRoadmapSelectLinksState" style="display: none;">
                  <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                      <div>
                        <h5 class="mb-1 fw-bold">
