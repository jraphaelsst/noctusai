                  <input type="hidden" id="advancedRoadmapIdForUpdate" value>
                  <input type="hidden" id="advancedRoadmapChatResourceType" value="user_roadmaps">
                  <input type="hidden" id="saveToTable" name="save_to" value="user_roadmaps">
                  <input type="hidden" id="roadmapSourceType" name="roadmap_source_type" value>
                  <input type="hidden" id="roadmapUsePubmed" name="roadmap_use_pubmed" value="0">
                  <input type="hidden" id="roadmapIsReprocess" name="is_reprocess" value="0">
                  <div id="step1Container" class="roadmap-form-section">
                    <label class="roadmap-form-label">
                      "Headline"
                    <p class="roadmap-form-hint">
                      "Base do roteiro. Se veio de sugerida ou favorita, já está preenchida."
                    <textarea class="form-control roadmap-input" id="advancedRoadmapHeadline" placeholder="Ex: 3 alimentos que aumentam testosterona">
                  <div id="step2Container" class="roadmap-form-section">
                    <label class="roadmap-form-label">
                      "Instruções"
                    <p class="roadmap-form-hint">
                      "Tom, público-alvo, o que pode ou não falar. Quanto mais detalhes, melhor."
                    <textarea class="form-control roadmap-input" id="advancedRoadmapObservations" name="observations" placeholder="Ex: Não falar de suplementos; tom leve; público 25–40 anos; evitar jargões médicos…">
                  <div id="step3Container" class="roadmap-form-section">
