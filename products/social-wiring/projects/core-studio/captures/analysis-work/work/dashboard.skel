              <button class="notification-bell-btn" @click="toggle()" type="button">
                <span class="notification-badge" x-show="unreadCount > 0" x-text="unreadCount > 9 ? '9+' : unreadCount" style="display: none;">
                  "0"
              <div class="notification-dropdown" x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-[-8px]" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-[-8px]" style="display: none;">
                <div class="notification-dropdown-header">
                  <span class="notification-dropdown-title">
