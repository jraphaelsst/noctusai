                  "Salvar Headlines"
      <div class="mainContentV2">
        <div class="top-header-v2" x-data="notificationsDropdown()" @click.away="open = false">
          <div class="top-header-v2-inner">
            <div class="notification-bell-wrapper" style="position: relative;">
              <button class="notification-bell-btn" @click="toggle()" type="button">
                <span class="notification-badge" x-show="unreadCount > 0" x-text="unreadCount > 9 ? '9+' : unreadCount" x-cloak>
              <div class="notification-dropdown" x-show="open" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-[-8px]" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 translate-y-[-8px]">
                <div class="notification-dropdown-header">
                  <span class="notification-dropdown-title">
                    "Notificações"
                  <div class="notification-header-actions">
                    <button class="notification-mark-all" @click="markAllRead()" x-show="unreadCount > 0" type="button">
                      "Marcar todas como lidas"
                    <button class="notification-toggle-read" @click="toggleShowRead()" x-show="readCount > 0" type="button">
                      <span x-text="showRead ? 'Ocultar lidas' : 'Ver já lidas'">
                <div class="notification-dropdown-body">
                  <template x-if="notifications.length === 0">
                    <div class="notification-empty">
                      <p>
                        "Nenhuma notificação por aqui"
                  <template x-for="n in notifications" :key="n.id">
                    <a :href="n.link || '#'" class="notification-item" :class="{ 'unread': n.status === 0 }" @click="markRead(n)">
                      <div class="notification-item-icon" :class="'type-' + n.type">
                        <template x-if="n.icon">
                          <span x-text="n.icon">
                        <template x-if="!n.icon">
                      <div class="notification-item-content">
                        <div class="notification-item-title" x-text="n.title">
                        <div class="notification-item-body" x-text="n.body" x-show="n.body">
                        <div class="notification-item-time" x-text="timeAgo(n.created_at)">
                      <div class="notification-item-dot" x-show="n.status === 0">
        <script inline>
        <div class="page-wrapper">
          <div class="page-body d-flex flex-column align-items-center" style="min-height: 85vh">
            <div style="margin-top: 70px" class="text-center mb-2">
              <h2 class="m-2" style="font-size: 1.9rem">
                "Gerar headlines"
              <p style="color: #FFFFFF80; font-size: 1.2rem">
                "Selecione o assunto que deseja gerar suas headlines"
            <section class="d-flex containerCardHeadlineTypeV2" style="gap: 20px">
              <article class="card overflow-hidden cardHeadlineTypeV2" style="height: 468px; max-width: 380px; width: calc(100% / 3);">
                <div class="h-50 d-flex justify-content-center align-items-center" style="background-color: #000808; overflow: hidden; position: relative; border: 1px solid #E1C8FF">
                  <span class="span_light" style="background: #008E9B;">
                  <img src="https://corestudio.ai/back/static/assets/Firefly.png" class="imageCards" style="height: 150px;">
                <div class="h-50 d-flex flex-column justify-content-between" style="padding: 25px">
                  <div>
                    <h3 class="mb-2" style="font-size: 1.3rem">
                      "Sobre mim"
                    <p style="font-size: 1.2rem; color: #FFFFFF80; margin: 0;">
                      "Headlines com base nas suas convicções, hábitos e histórias de vida."
                  <a href="https://corestudio.ai/dashboard/user/headlines?who=me">
                    "Gerar Headlines"
              <article class="card overflow-hidden cardHeadlineTypeV2" style="height: 468px; max-width: 380px; width: calc(100% / 3)">
                <div class="h-50 d-flex justify-content-center align-items-center" style="background-color: #000716; overflow: hidden; position: relative; border: 1px solid #E1C8FF">
                  <span class="span_light" style="background: #335FC6;">
                  <img src="https://corestudio.ai/back/static/assets/Productimage.png" class="imageCards" style="height: 130px;">
                <div class="h-50 d-flex flex-column justify-content-between" style="padding: 25px">
                  <div>
                    <h3 class="mb-2" style="font-size: 1.3rem">
                      "Sobre meu público"
                    <p style="font-size: 1.2rem; color: #FFFFFF80; margin: 0;">
                      "Headlines com base em dores, desejos, crenças e demais características do seu público alvo."
                  <a href="https://corestudio.ai/dashboard/user/headlines?who=public">
                    "Gerar Headlines"
              <article class="card overflow-hidden cardHeadlineTypeV2" style="height: 468px; max-width: 380px; width: calc(100% / 3)">
                <div class="h-50 d-flex justify-content-center align-items-center" style="background-color: #0C0012; overflow: hidden; position: relative; border: 1px solid #E1C8FF">
                  <span class="span_light" style="background: #9F26E0;">
                  <img src="https://corestudio.ai/back/static/assets/fire.png" class="imageCards" style="height: 140px;">
                <div class="h-50 d-flex flex-column justify-content-between" style="padding: 25px;">
                  <div>
                    <h3 class="mb-2" style="font-size: 1.3rem">
                      "Assuntos do Virais"
                    <p style="font-size: 1.2rem; color: #FFFFFF80; margin: 0;">
                      "Headlines com assuntos em alta que conectam com o seu público-alvo."
                  <a href="https://corestudio.ai/dashboard/user/headlines?who=viral">
                    "Gerar Headlines"
        <footer class="footerV2">
          <div class="d-flex justify-content-between align-items-center p-2 w-100" style="font-size:12px">
            <p class="m-0">
              "Copyright © 2026 Inteligência Core. Todos os direitos reservados."
            <span class="link-secondary">
              "Feito com"
              "por VC"
        <div class="modal modal-blur fade" id="modal-report" role="dialog">
          <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">
                  "New report"
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
              <div class="modal-body">
                <div class="mb-3">
                  <label class="form-label">
                    "Name"
                  <input type="text" class="form-control" name="example-text-input" placeholder="Your report name">
                <label class="form-label">
                  "Report type"
                <div class="form-selectgroup-boxes row mb-3">
                  <div class="col-lg-6">
                    <label class="form-selectgroup-item">
                      <input type="radio" name="report-type" value="1" class="form-selectgroup-input" checked>
                      <span class="form-selectgroup-label d-flex align-items-center p-3">
                        <span class="me-3">
                          <span class="form-selectgroup-check">
                        <span class="form-selectgroup-label-content">
                          <span class="form-selectgroup-title strong mb-1">
                            "Simple"
                          <span class="d-block text-secondary">
                            "Provide only basic data needed for the report"
                  <div class="col-lg-6">
                    <label class="form-selectgroup-item">
                      <input type="radio" name="report-type" value="1" class="form-selectgroup-input">
                      <span class="form-selectgroup-label d-flex align-items-center p-3">
                        <span class="me-3">
                          <span class="form-selectgroup-check">
                        <span class="form-selectgroup-label-content">
                          <span class="form-selectgroup-title strong mb-1">
                            "Advanced"
                          <span class="d-block text-secondary">
                            "Insert charts and additional advanced analyses to be inserted in the report"
                <div class="row">
                  <div class="col-lg-8">
                    <div class="mb-3">
                      <label class="form-label">
                        "Report url"
                      <div class="input-group input-group-flat">
                        <span class="input-group-text">
                          "https://tabler.io/reports/"
                        <input type="text" class="form-control ps-0" value="report-01">
                  <div class="col-lg-4">
                    <div class="mb-3">
                      <label class="form-label">
                        "Visibility"
                      <select class="form-select">
                        <option value="1" selected>
                          "Private"
                        <option value="2">
                          "Public"
                        <option value="3">
                          "Hidden"
              <div class="modal-body">
                <div class="row">
                  <div class="col-lg-6">
                    <div class="mb-3">
                      <label class="form-label">
                        "Client name"
                      <input type="text" class="form-control">
                  <div class="col-lg-6">
                    <div class="mb-3">
                      <label class="form-label">
                        "Reporting period"
                      <input type="date" class="form-control">
                  <div class="col-lg-12">
                    <div>
                      <label class="form-label">
                        "Additional information"
                      <textarea class="form-control">
              <div class="modal-footer">
                <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                  "Cancel"
                <a href="#" class="btn btn-primary ms-auto" data-bs-dismiss="modal">
                  "Create new report"
