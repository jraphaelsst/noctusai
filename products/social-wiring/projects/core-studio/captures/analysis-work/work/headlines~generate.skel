            <span class="badge bg-blue badge-notification badge-blink" style="left: -15px;width: 1rem;height: 1rem;">
            <span class="bg-red-lt avatar">
      <div class="offcanvas offcanvas-end j_headline_content_box" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
        <div class="offcanvas-header">
          <h2 class="offcanvas-title" id="offcanvasEndLabel">
            "Headlines na Box"
          <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close">
        <div class="offcanvas-body">
          <form id="box-headlines-save" method="post">
