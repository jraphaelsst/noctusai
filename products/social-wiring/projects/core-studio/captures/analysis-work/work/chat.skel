        'https://corestudio.ai/dashboard/user/twin/api/recharges',
        'https://corestudio.ai/dashboard/user/twin/faturamento'
    )" x-on:show-trace.window="openTrace($event.detail.trace)" x-on:update-url.window="traceVisible = false; traceData = {}" x-on:copy-clean-script-result.window="onCopyCleanScriptResult($event.detail)">
              <script application/json>
              <button class="dc-sidebar-toggle d-lg-none" @click="sidebarOpen = !sidebarOpen" :class="{ 'active': sidebarOpen }">
              <aside class="dc-sidebar" :class="{ 'open': sidebarOpen }">
                <div class="dc-sidebar-header">
                  <h3 class="dc-sidebar-title">
                    "Conversas"
                <button class="dc-new-chat-btn" :disabled="creatingChat || streaming" @click="
                if (activeAbortController) { activeAbortController.abort(); activeAbortController = null; }
                streaming = false;
                stopTyping();
                creatingChat = true;
                localMessages = [];
                localConversationId = null;
                $wire.startNewConversation();
                setTimeout(() => creatingChat = false, 400);
  …">
                  <span x-show="!creatingChat" class="dc-new-chat-icon">
                    "+"
                  <span x-show="creatingChat" class="spinner-border" style="display:none;width:.7rem;height:.7rem;border-width:1.5px;flex-shrink:0" role="status">
                  <span x-text="creatingChat ? 'Criando...' : 'Novo chat'">
                <div class="dc-sidebar-list">
                  <template x-for="conversation in sidebarConversations" :key="conversation.id">
                    <div class="dc-conversation-item-wrapper" :class="{ 'active': $wire.conversationId === conversation.id }" x-data="{ editing: false, saving: false, editTitle: conversation.title }">
                      <template x-if="!editing">
                        <button class="dc-conversation-item" @click="if (activeAbortController) { activeAbortController.abort(); activeAbortController = null; } streaming = false; stopTyping(); $wire.selectConversation(conversation.id); sidebarOpen = false; localMessages = []; localConversationId = null; switchingChat = true;" :disabled="$wire.thinking">
                          <span class="dc-conversation-title" x-text="conversation.title">
                      <template x-if="editing">
                        <div style="flex:1;min-width:0;display:flex;align-items:center;">
                          <input x-show="!saving" class="dc-conversation-edit-input" type="text" x-model="editTitle" @keydown.enter.prevent="saving = true; $wire.renameConversation(conversation.id, editTitle).then(() => { editing = false; saving = false; })" @keydown.escape="editing = false" @click.outside="if(!saving) editing = false" x-init="$nextTick(() => $el.focus())" maxlength="100">
                          <span x-show="saving" style="display:flex;align-items:center;gap:6px;padding:6px 10px;color:#8b949e;font-size:.78rem;">
                            <span class="spinner-border spinner-border-sm" style="width:.65rem;height:.65rem;border-width:1.5px;color:#58a6ff;" role="status">
                            "Salvando..."
                      <div class="dc-conversation-actions">
                        <button class="dc-conversation-edit" @click.stop="editing = !editing; $nextTick(() => { const inp = $el.closest('.dc-conversation-item-wrapper').querySelector('.dc-conversation-edit-input'); if(inp) inp.focus(); })" title="Renomear conversa">
                        <button type="button" class="dc-conversation-delete" @click.stop="deleteConfirm = { open: true, id: conversation.id, title: conversation.title, busy: false }" :disabled="$wire.thinking" title="Apagar conversa">
                  <template x-if="$wire.hasMoreConversations" x-key="has-more">
                    <button class="dc-load-more" @click="$wire.loadMoreConversations()">
                      "Ver mais conversas"
                  <template x-if="!sidebarConversations || sidebarConversations.length === 0">
                    <div class="dc-sidebar-empty">
                      "Nenhuma conversa para este agente."
                <div class="dc-sidebar-footer">
                  <a href="https://corestudio.ai/dashboard/user/cores" class="dc-sidebar-link">
                    "Segundo cérebro"
                  <div x-data="{
                memOpen: false,
                memLoading: false,
                memItems: [],
                async memShow() {
                    this.memOpen = true;
                    this.memLoading = true;
                    this.memItems = await $wire.loadMemories();
                    this.memLoading = false;
                },
                memNew: '',
                memSaving:…">
                    <button type="button" class="dc-sidebar-link dc-sidebar-link-btn" @click="memShow()">
                      "Memória"
                    <template x-teleport="body">
                      <div x-show="memOpen" x-transition.opacity.duration.150ms class="dc-confirm-overlay" @click="memOpen = false" @keydown.escape.window="memOpen = false" style="display:none">
                        <div class="dc-confirm-modal dc-memory-modal" @click.stop x-transition.duration.180ms>
                          <h3 class="dc-confirm-title">
                            "Memória"
                          <p class="dc-confirm-text">
                            "O que a IA sabe sobre você em todos os chats de Roteiro e Headline. Adicione aqui ou escreva no chat"
                            <strong>
                              ""guarda na memória que eu não uso emojis""
                            "."
                          <form class="dc-memory-add" @submit.prevent="memAdd()">
                            <textarea x-model="memNew" maxlength="500" placeholder="Ex.: Meu público são donos de clínica de estética." @keydown.enter="if (!$event.shiftKey) { $event.preventDefault(); memAdd(); }">
                            <button type="submit" class="dc-memory-add-btn" :disabled="memSaving || !memNew.trim()">
                              <span x-text="memSaving ? 'Guardando…' : 'Guardar'">
                          <div x-show="memError" x-text="memError" class="dc-memory-error" style="display:none">
                          <div class="dc-memory-list">
                            <div x-show="memLoading" class="dc-memory-empty">
                              "Carregando…"
                            <div x-show="!memLoading && memItems.length === 0" class="dc-memory-empty">
                              "Nada salvo ainda."
                            <template x-for="item in memItems" :key="item.id">
                              <div class="dc-memory-item">
                                <div class="dc-memory-text">
                                  <span x-text="item.content">
                                  <small x-text="item.created_at">
                                <button type="button" class="dc-memory-del" title="Apagar" @click="memDelete(item.id)">
                          <div class="dc-confirm-actions">
                            <button type="button" class="dc-confirm-btn dc-confirm-cancel" @click="memOpen = false">
                              "Fechar"
              <div class="dc-overlay d-lg-none" :class="{ 'active': sidebarOpen }" @click="sidebarOpen = false">
              <main class="dc-main">
                <div class="dc-header">
                  <div class="dc-header-left">
                    <span class="dc-header-title">
                      "Chat com Documentos"
                  <div class="dc-header-right">
                    <button class="dc-docs-toggle" @click="docsPanel = !docsPanel" :class="{ 'active': docsPanel }">
                      <span class="dc-docs-count" x-show="$wire.attachedDocuments.length > 0" x-text="$wire.attachedDocuments.length">
                <div class="dc-messages-wrapper">
                  <div class="dc-switching-overlay" x-show="switchingChat" x-transition.opacity>
                    <span class="spinner-border" style="width:1.5rem;height:1.5rem;border-width:2px;color:#58a6ff;" role="status">
                  <div class="dc-messages" id="chat-messages" x-ref="chatMessages" x-effect="
                if ($wire.conversationId) {
                    $nextTick(() => {
                        const el = $refs.chatMessages;
                        if (el) el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' });
                    });
                }
            " x-init="$nextTick(() => { const el = $el; setTimeout(() => el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' }), 100); })" @scroll="
                const el = $refs.chatMessages;
                atBottom = (el.scrollHeight - el.scrollTop - el.clientHeight) < 80;
            ">
                    <div class="dc-msg dc-msg-user">
                      <div class="dc-msg-bubble dc-msg-bubble-user">
                        "O QUARTO CHEIO DE MENINOS*Teve uma época em que parecia que a casa nunca ficava vazia.Tinha menino entrando sem bater. Tênis largado perto da porta. Violão tocando no quarto. Gargalhada vindo do corredor.E um cheiro de chulé que, sinceramente, ninguém sente falta. Ou sente. Depois sente até disso.A geladeira vivia sendo aberta. Sempre cabia mais um no jantar. Tinha cachorro-quente de última hora, "
                    <div class="dc-msg dc-msg-assistant">
                      <div class="dc-avatar">
                      <div class="dc-msg-content" x-data="{ copiedFull: false }">
                        <div class="dc-msg-bubble dc-msg-bubble-assistant markdown-body">
                          <p>
                            "Aqui está a headline para esse roteiro:"
                          <ol>
                            <li>
                              <strong>
                                "A casa que parecia pequena demais um dia começa a parecer grande demais, e ninguém te prepara pra isso"
                              "("
                              <a href="https://corestudio.ai/dashboard/user/library?viral_id=124688">
                                "estrutura #124688"
                              ")"
                              <button class="dc-action-btn" data-action="roteiro" data-params="{"id":"124688","headline":"A casa que parecia pequena demais um dia começa a parecer grande demais, e ninguém te prepara pra isso"}" title="Criar roteiro a partir desta headline">
                              <button class="dc-action-btn dc-action-btn-edit" data-action="roteiro_edit" data-params="{"id":"124688","headline":"A casa que parecia pequena demais um dia começa a parecer grande demais, e ninguém te prepara pra isso"}" title="Criar roteiro com headline editável">
                        <div class="dc-msg-actions">
                          <div class="dc-msg-btns">
                            <button type="button" class="dc-copy-full-btn" :class="{ 'dc-copy-success': copiedFull }" @click="navigator.clipboard.writeText('Aqui est\u00e1 a headline para esse roteiro:\n\n1. **A casa que parecia pequena demais um dia come\u00e7a a parecer grande demais, e ningu\u00e9m te prepara pra isso** ([estrutura #124688](https:\/\/corestudio.ai\/dashboard\/user\/library?viral_id=124688)) {{action:roteiro|id=124688|headline=A casa que parecia pequena demais um dia come\u00e7a a parecer grande demais…">
                              <span x-text="copiedFull ? 'Copiado!' : 'Completo'">
                    <div class="dc-msg dc-msg-user">
                      <div class="dc-msg-bubble dc-msg-bubble-user">
                        "me dá mais 10 opções de headline"
                    <div class="dc-msg dc-msg-assistant">
                      <div class="dc-avatar">
                      <div class="dc-msg-content" x-data="{ copiedFull: false }">
                        <div class="dc-msg-bubble dc-msg-bubble-assistant markdown-body">
                          <p>
                            "Aqui estão 10 headlines para o roteiro:"
                          <ol>
                            <li>
                              <strong>
                                "A casa não ficou silenciosa porque os filhos cresceram. Ficou porque você também foi crescendo sem perceber"
                              "("
                              <a href="https://corestudio.ai/dashboard/user/library?viral_id=124688">
                                "estrutura #124688"
                              ")"
                              <button class="dc-action-btn" data-action="roteiro" data-params="{"id":"124688","headline":"A casa não ficou silenciosa porque os filhos cresceram. Ficou porque você também foi crescendo sem perceber"}" title="Criar roteiro a partir desta headline">
                              <button class="dc-action-btn dc-action-btn-edit" data-action="roteiro_edit" data-params="{"id":"124688","headline":"A casa não ficou silenciosa porque os filhos cresceram. Ficou porque você também foi crescendo sem perceber"}" title="Criar roteiro com headline editável">
                            <li>
                              <strong>
