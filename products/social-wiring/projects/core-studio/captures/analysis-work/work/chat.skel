                          "Minha Pesquisa"
                        <button x-show="isRoteiroAgent()" class="dc-mention-tab" :class="{ 'active': mentionActiveTab === 'cerebro' }" @click="switchMentionTab('cerebro')" type="button">
                          "Meu Cérebro"
                      <div class="dc-mention-modal-search">
                        <input type="text" x-ref="mentionSearchInput" :placeholder="mentionActiveTab === 'documents' ? 'Buscar nos seus documentos...' : (mentionActiveTab === 'research' ? 'Buscar na minha pesquisa...' : (mentionActiveTab === 'cerebro' ? 'Buscar no meu cérebro...' : 'Buscar vídeos e perfis...'))" @input.debounce.200ms="fetchMentions($event.target.value)" @keydown.escape="mentionOpen = false" @keydown.arrow-down.prevent="mentionIndex = Math.min(mentionIndex + 1, filteredResults().length - 1)" @keydown.arrow-up.prevent="mentionIndex = Math.max(mentionIndex - 1, 0)" @keydown.enter.prevent="const list = filteredResults(); if(list.length && list[mentionIndex]?.ready !== false) toggleMentionSelection(list[mentionIndex])">
                      <div x-show="mentionActiveTab === 'research'" class="dc-mention-group-filters" style="justify-content:space-between">
                        <div style="display:flex;gap:4px;align-items:center">
                          <button type="button" class="dc-mention-group-chip dc-chip-audience" :class="{ 'active': researchGroupFilter === 'Meu Público', 'loading': researchGroupFilter === 'Meu Público' && mentionInitialLoading }" @click="switchResearchGroup('Meu Público')" :disabled="mentionInitialLoading">
                            <span class="dc-chip-spinner" x-show="researchGroupFilter === 'Meu Público' && mentionInitialLoading">
                            "Meu Público"
                          <button type="button" class="dc-mention-group-chip dc-chip-about" :class="{ 'active': researchGroupFilter === 'Sobre mim', 'loading': researchGroupFilter === 'Sobre mim' && mentionInitialLoading }" @click="switchResearchGroup('Sobre mim')" :disabled="mentionInitialLoading">
                            <span class="dc-chip-spinner" x-show="researchGroupFilter === 'Sobre mim' && mentionInitialLoading">
                            "Sobre mim"
                          <template x-if="researchVariables.length > 0">
                            <div style="display:flex;align-items:center;position:relative">
                              <div style="width:1px;height:14px;background:#ffffff18;margin-right:6px">
                              <select class="dc-research-var-select" :class="{ 'has-value': researchVariableFilter !== null }" @change="switchResearchVariable($event.target.value ? parseInt($event.target.value) : null)" :disabled="mentionInitialLoading">
                                <option value>
                                  "Todas as categorias"
                                <template x-for="v in researchVariables" :key="v.id">
                                  <option :value="v.id" :selected="researchVariableFilter === v.id" x-text="v.label">
                        <div style="display:flex;gap:4px">
                          <button type="button" class="dc-mention-group-chip" :class="{ 'active': researchSortFilter === 'recent' }" @click="switchResearchSort('recent')" :disabled="mentionInitialLoading">
                            "Recentes"
                          <button type="button" class="dc-mention-group-chip" :class="{ 'active': researchSortFilter === 'plays' }" @click="switchResearchSort('plays')" :disabled="mentionInitialLoading">
                            "Views"
                      <div x-show="mentionActiveTab === 'documents'" class="dc-mention-dropzone" :class="{ 'dragover': isDraggingDoc, 'uploading': docUploading }" @dragover.prevent="isDraggingDoc = true" @dragleave.prevent="isDraggingDoc = false" @drop.prevent="isDraggingDoc = false; handleDocDrop($event)">
                        <input type="file" x-ref="docFileInput" accept=".pdf,.docx,.txt,.md,.csv" style="display:none" @change="handleDocFileInput($event)">
                        <div class="dc-mention-dropzone-content">
                          <div class="dc-mention-dropzone-text">
                            <span x-show="!docUploading">
                              <strong>
                                "Arraste"
                              "um arquivo ou"
                            <span x-show="docUploading">
                              <span class="spinner-border spinner-border-sm" role="status">
                              "Enviando…"
                          <button type="button" class="dc-mention-upload-btn" :disabled="docUploading" @click="$refs.docFileInput.click()">
                            "Fazer upload"
                        <div class="dc-mention-dropzone-hint">
                          "PDF, DOCX, TXT, MD ou CSV · até 20MB"
                        <div x-show="docUploadError" class="dc-mention-dropzone-error" x-text="docUploadError">
                      <div class="dc-mention-modal-results" @scroll="if($event.target.scrollTop + $event.target.clientHeight >= $event.target.scrollHeight - 30) loadMoreMentions()">
                        <template x-if="mentionInitialLoading">
                          <div class="dc-mention-skeleton-list">
                            <template x-for="i in 6" :key="'skel-'+i">
                              <div class="dc-mention-skeleton-item">
                                <div class="dc-skeleton dc-skeleton-icon">
                                <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
                                  <div class="dc-skeleton dc-skeleton-title" :style="'width:' + (50 + Math.random()*40) + '%'">
                                  <div class="dc-skeleton dc-skeleton-meta" style="width:25%">
                        <template x-if="!mentionInitialLoading">
                          <div>
                            <template x-for="(item, i) in filteredResults()" :key="(item.source || 'config') + '-' + item.id">
                              <div>
                                <button class="dc-mention-item" :class="{ 'active': i === mentionIndex, 'disabled': item.ready === false, 'selected': isMentionSelected(item) }" :disabled="item.ready === false" @click="item.ready !== false && toggleMentionSelection(item)" @mouseenter="mentionIndex = i">
                                  <span class="dc-mention-check-wrap">
                                    <span class="dc-mention-check" :class="{ 'checked': isMentionSelected(item) }">
                                  <span class="dc-mention-title" x-text="item.title">
                                  <span class="dc-mention-type" x-text="({
                                                        profile: 'Perfil',
                                                        video: 'Vídeo',
                                                        document: 'Documento',
                                                        about_me: 'Sobre mim',
                                                        audience: 'Meu Público',
           …">
                                  <span class="dc-mention-meta" x-text="item.meta">
                                  <span x-show="item.plays > 0" class="dc-mention-plays" x-text="item.plays >= 1000000 ? (item.plays / 1000000).toFixed(1).replace(/\.0$/, '') + 'M views' : item.plays >= 1000 ? (item.plays / 1000).toFixed(1).replace(/\.0$/, '') + 'K views' : item.plays + ' views'">
                                  <span x-show="item.status === 'processing' || item.status === 'pending'" class="spinner-border spinner-border-sm" role="status" style="width:12px;height:12px;margin-left:auto;">
                            <div x-show="mentionLoading" style="display:flex;justify-content:center;padding:12px;opacity:.6;">
                              <span class="spinner-border spinner-border-sm" role="status">
                              <span style="margin-left:6px;font-size:.75rem;">
                                "Carregando mais..."
                            <div x-show="!mentionLoading && mentionResults.length === 0" style="padding:24px;text-align:center;color:#484f58;font-size:.85rem;">
                              <span x-show="mentionActiveTab === 'documents'">
                                "Nenhum documento ainda. Faça upload acima."
                              <div x-show="mentionActiveTab === 'research'" style="display:flex;flex-direction:column;align-items:center;gap:10px">
                                <span>
                                  "Nenhum item encontrado."
                                <a href="/dashboard/user/searches" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:7px;backgrou">
                                  "Adicionar pesquisa"
                              <span x-show="mentionActiveTab === 'references'">
                                "Nenhum resultado encontrado"
                      <div class="dc-mention-confirm-bar" x-show="mentionSelected.length > 0" x-transition.opacity.duration.150ms>
                        <span class="dc-mention-confirm-count" x-text="mentionSelected.length + (mentionSelected.length === 1 ? ' selecionado' : ' selecionados')">
                        <div style="display:flex;gap:8px;align-items:center;">
                          <button type="button" class="dc-mention-clear-btn" @click="mentionSelected = []">
                            "Limpar"
                          <button type="button" class="dc-mention-confirm-btn" @click="confirmMentionSelection()">
                            "Confirmar"
              <template x-teleport="body">
                <div x-show="deleteConfirm.open" x-transition.opacity.duration.150ms class="dc-confirm-overlay" @click="if (!deleteConfirm.busy) deleteConfirm.open = false" @keydown.escape.window="if (deleteConfirm.open && !deleteConfirm.busy) deleteConfirm.open = false">
                  <div class="dc-confirm-modal" @click.stop x-transition.duration.180ms>
                    <div class="dc-confirm-icon">
                    <h3 class="dc-confirm-title">
                      "Remover conversa"
                    <p class="dc-confirm-text">
                      "Tem certeza que deseja remover"
                      <strong x-text="deleteConfirm.title || 'esta conversa'">
                      "? Esta ação não pode ser desfeita — todas as mensagens, referências e traces serão removidos."
                    <div class="dc-confirm-actions">
                      <button type="button" class="dc-confirm-btn dc-confirm-cancel" :disabled="deleteConfirm.busy" @click="deleteConfirm.open = false">
                        "Cancelar"
                      <button type="button" class="dc-confirm-btn dc-confirm-delete" :disabled="deleteConfirm.busy" @click="
                            deleteConfirm.busy = true;
                            $wire.deleteConversation(deleteConfirm.id).then(() => {
                                deleteConfirm = { open: false, id: null, title: '', busy: false };
                            });
                        ">
                        <span x-show="!deleteConfirm.busy">
                          "Apagar"
                        <span x-show="deleteConfirm.busy" style="display:inline-flex;align-items:center;gap:6px;">
                          <span class="spinner-border spinner-border-sm" style="width:.7rem;height:.7rem;border-width:1.5px;" role="status">
                          "Apagando…"
              <aside class="dc-docs-panel" :class="{ 'open': docsPanel }">
                <div class="dc-docs-panel-header">
                  <h4 class="dc-docs-panel-title">
                    "Referências anexadas"
                  <button class="dc-trace-close" @click="docsPanel = false">
                <div class="dc-docs-panel-body">
                  <template x-if="$wire.attachedReferences.length === 0">
                    <div class="dc-docs-panel-empty">
                      <p>
                        "Nenhuma referência anexada"
                      <small>
                        "Use"
                        <code>
                          "@"
                        "no chat para mencionar vídeos da biblioteca"
                  <template x-for="ref in $wire.attachedReferences" :key="ref.id">
                    <div class="dc-docs-panel-item">
                      <div class="dc-docs-panel-item-info">
                        <div>
                          <div class="dc-docs-panel-item-title" x-text="ref.title">
                          <div class="dc-docs-panel-item-meta" x-text="ref.meta">
                      <button class="dc-docs-panel-item-remove" @click="removeTagFromInput(ref.id, ref.source || 'config'); $wire.detachReference(ref.id, ref.source || 'config')" title="Remover referência">
              <template x-if="traceVisible">
                <div>
                  <div class="dc-overlay active" @click="closeTrace()">
                  <div class="dc-trace-drawer">
                    <div class="dc-trace-header">
                      <span class="fw-semibold" style="color:#e6edf3; font-size:.95rem;">
                        "Trace da IA"
                      <button class="dc-trace-close" @click="closeTrace()">
                    <div class="dc-trace-body">
                      <template x-if="!traceData || !traceData.model">
                        <div style="color:#8b949e; font-size:.85rem; padding:24px 0; text-align:center;">
                          "Nenhum dado de trace disponível para esta mensagem."
                      <div class="d-flex flex-wrap gap-2 mb-3" x-show="traceData && traceData.model">
                        <span class="badge" style="background:#1f3a6e; color:#60a5fa; border:1px solid #2d4f8e; font-weight:400;" x-text="traceData.model || '-'">
                        <span x-show="traceData.duration_ms" class="badge" style="background:#1a3524; color:#3fb950; border:1px solid #245830; font-weight:400;" x-text="formatTraceDuration(traceData.duration_ms)">
                        <span x-show="traceData.usage" class="badge" style="background:#3d1f00; color:#d29922; border:1px solid #5c3a0a; font-weight:400;" x-text="formatTraceTokens()">
                      <template x-if="traceData.system_prompt">
                        <details class="dc-trace-section">
                          <summary class="dc-trace-summary">
                            <span class="d-flex align-items-center gap-2">
                              "System Prompt"
                              <span class="dc-badge-muted ms-auto" x-text="(traceData.system_prompt||'').length + ' chars'">
                          <pre class="dc-trace-pre" x-text="traceData.system_prompt">
                      <template x-if="traceData.user_prompt">
                        <details class="dc-trace-section">
                          <summary class="dc-trace-summary">
                            <span class="d-flex align-items-center gap-2">
                              "User Prompt"
                          <pre class="dc-trace-pre" x-text="traceData.user_prompt">
                      <template x-if="traceData.conversation_history && traceData.conversation_history.length > 0">
                        <details class="dc-trace-section">
                          <summary class="dc-trace-summary">
                            <span class="d-flex align-items-center gap-2">
                              "Contexto da Conversa"
                              <span class="dc-badge-muted ms-auto" x-text="traceData.conversation_history.length + ' msgs'">
                          <div class="dc-trace-content" style="max-height:400px; overflow-y:auto;">
                            <template x-for="(msg, i) in traceData.conversation_history" :key="i">
                              <div class="mb-2 pb-2" :style="i < traceData.conversation_history.length - 1 ? 'border-bottom:1px solid #21262d' : ''">
                                <div class="mb-1">
                                  <span class="badge" :style="msg.role === 'user' ? 'background:#1f3a6e; color:#60a5fa' : msg.role === 'assistant' ? 'background:#1a3524; color:#3fb950' : 'background:#3d1f00; color:#d29922'" style="font-weight:400; font-size:.7rem;" x-text="msg.role">
                                <pre x-show="msg.content" style="color:#c9d1d9; font-size:.7rem; white-space:pre-wrap; word-break:break-word; margin:0;" x-text="msg.content">
                                <template x-if="msg.tool_calls">
                                  <div class="mt-1">
                                    <template x-for="tc in msg.tool_calls" :key="tc.name">
                                      <div style="font-size:.7rem; color:#8b949e;">
                                        <span style="color:#d2a8ff;" x-text="tc.name">
                                        "("
                                        <span style="color:#6e7681;" x-text="JSON.stringify(tc.arguments)">
                                        ")"
                                <template x-if="msg.results">
                                  <div class="mt-1">
                                    <template x-for="r in msg.results" :key="r.name">
                                      <div style="font-size:.7rem; color:#8b949e;">
                                        <span style="color:#d29922;" x-text="r.name">
                                        ":"
                                        <span style="color:#6e7681;" x-text="r.result">
                      <template x-if="traceData.rag_steps && traceData.rag_steps.length > 0">
                        <div>
                          <div class="d-flex align-items-center gap-2 mb-2 mt-3" style="color:#8b949e; font-size:.85rem;">
                            <span>
                              "Pipeline de etapas"
                            <span class="dc-badge-muted" x-text="traceData.rag_steps.filter(s => s.status === 'done').length + ' etapas'">
                          <div class="dc-trace-content">
                            <template x-for="(step, i) in traceData.rag_steps.filter(s => s.status === 'done')" :key="'tl-'+i">
                              <details class="dc-step-expandable">
                                <summary class="dc-step-item" style="cursor:pointer; list-style:none;">
                                  <div class="dc-step-icon">
                                  <div class="dc-step-info" style="flex:1;">
                                    <span class="fw-semibold" style="color:#c9d1d9;" x-text="ragStepLabel(step.tool)">
                                    <span x-show="step.data?.query" style="color:#6e7681;" x-text="' : ' + step.data?.query">
                                    <template x-if="step.data?.count !== undefined || step.data?.approved !== undefined">
                                      <span class="dc-badge-result" x-text="(step.data.approved !== undefined ? step.data.approved + ' aprovados' : step.data.count + ' resultados')">
                                    <span x-show="step.data && Object.keys(step.data).length > 0" class="dc-step-chevron">
                                <div class="dc-step-expand-body" x-show="step.data && Object.keys(step.data).length > 0">
                                  <div style="font-size:.65rem; color:#484f58; font-family:monospace; margin-bottom:4px;" x-text="'Tool: ' + toolClassName(step.tool)">
                                  <template x-if="step.data?.analise">
                                    <div class="dc-step-detail-item mt-1" x-text="step.data.analise">
                                  <template x-if="step.data?.items?.length">
                                    <details class="mt-1" style="font-size:.75rem;">
                                      <summary style="cursor:pointer; color:#58a6ff; user-select:none;">
                                        "Ver"
                                        <span x-text="step.data.items.length">
                                        <span x-text="step.tool === 'gerar_headlines.generate' || step.tool === 'gerar_headlines' ? 'headlines' : 'itens'">
                                      <div class="mt-1 d-flex flex-column gap-1" style="max-height:250px; overflow-y:auto;">
                                        <template x-for="(item, j) in step.data.items" :key="'it-'+j">
                                          <div class="dc-step-detail-item">
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                              <span x-show="item.gatilho" class="dc-badge-trigger" x-text="item.gatilho">
                                              <span x-show="item.heading" style="color:#8b949e; font-size:.65rem;" x-text="item.heading">
                                              <span class="dc-badge-source" x-text="item.source">
                                            <div style="color:#c9d1d9; font-size:.7rem; margin-top:2px; line-height:1.4;" x-text="item.preview">
                                  <template x-if="step.data?.sources?.length">
                                    <div class="mt-1 d-flex flex-wrap gap-1">
                                      <template x-for="src in step.data.sources" :key="src">
                                        <span class="dc-badge-source" x-text="src">
                                  <template x-if="step.data?.resumo">
                                    <div class="mt-2">
                                      <div class="d-flex gap-2 mb-1 flex-wrap">
                                        <span class="badge" style="background:#1a3524; color:#3fb950; border:1px solid #245830; font-weight:400; font-size:.6" x-text="step.data.resumo.templates_validados + ' templates'">
                                        <span class="badge" style="background:#1f3a6e; color:#60a5fa; border:1px solid #2d4f8e; font-weight:400; font-size:.6" x-text="step.data.resumo.variaveis_validadas + ' variaveis'">
                                        <span class="badge" style="background:#3d1f00; color:#d29922; border:1px solid #5c3a0a; font-weight:400; font-size:.6" x-text="step.data.resumo.gatilhos_validados + ' gatilhos'">
                                      <template x-if="step.data.resumo.templates?.length">
                                        <details class="mb-1">
                                          <summary style="cursor:pointer; color:#3fb950; font-size:.7rem; user-select:none;">
                                            "Templates usados ("
                                            <span x-text="step.data.resumo.templates.length">
                                            ")"
                                          <div class="d-flex flex-column gap-1 mt-1" style="max-height:150px; overflow-y:auto;">
                                            <template x-for="(t, ti) in step.data.resumo.templates" :key="'rt-'+ti">
                                              <div class="dc-step-detail-item">
                                                <span class="dc-badge-source" x-text="t.source">
                                                <div style="color:#c9d1d9; font-size:.65rem; margin-top:2px;" x-text="t.preview">
                                      <template x-if="step.data.resumo.variaveis?.length">
                                        <details class="mb-1">
                                          <summary style="cursor:pointer; color:#60a5fa; font-size:.7rem; user-select:none;">
                                            "Variaveis usadas ("
                                            <span x-text="step.data.resumo.variaveis.length">
                                            ")"
                                          <div class="d-flex flex-column gap-1 mt-1" style="max-height:150px; overflow-y:auto;">
                                            <template x-for="(v, vi) in step.data.resumo.variaveis" :key="'rv-'+vi">
                                              <div class="dc-step-detail-item">
                                                <span class="dc-badge-source" x-text="v.source">
                                                <div style="color:#c9d1d9; font-size:.65rem; margin-top:2px;" x-text="v.preview">
                                      <template x-if="step.data.resumo.gatilhos?.length">
                                        <details class="mb-1">
                                          <summary style="cursor:pointer; color:#d29922; font-size:.7rem; user-select:none;">
                                            "Gatilhos usados ("
                                            <span x-text="step.data.resumo.gatilhos.length">
                                            ")"
                                          <div class="d-flex flex-column gap-1 mt-1" style="max-height:150px; overflow-y:auto;">
                                            <template x-for="(g, gi) in step.data.resumo.gatilhos" :key="'rg-'+gi">
                                              <div class="dc-step-detail-item">
                                                <span x-show="g.gatilho" class="dc-badge-trigger" x-text="g.gatilho">
                                                <span class="dc-badge-source" x-text="g.source">
                                                <div style="color:#c9d1d9; font-size:.65rem; margin-top:2px;" x-text="g.preview">
                                  <template x-if="step.data && !step.data.items && !step.data.resumo && !step.data.analise">
                                    <div class="dc-json-tree mt-1" style="max-height:300px; overflow-y:auto;" x-html="renderJsonTree(step.data, 0, true)">
                      <template x-if="traceData.review_executions && traceData.review_executions.length > 0">
                        <div>
                          <div class="d-flex align-items-center gap-2 mb-2 mt-3" style="color:#8b949e; font-size:.85rem;">
                            <span>
                              "Revisões"
                            <span class="dc-badge-muted" x-text="traceData.review_executions.length + ' tentativa(s)'">
                            <span x-show="traceData.review_executions.every(r => r.approved)" style="color:#3fb950; font-size:.7rem; margin-left:auto;">
                              "✓ aprovado"
                            <span x-show="!traceData.review_executions.every(r => r.approved) && traceData.review_executions[traceData.review_executions.length-1]?.approved" style="color:#d29922; font-size:.7rem; margin-left:auto;">
                              "↻ aprovado após retry"
                          <div class="dc-trace-content">
                            <template x-for="(exec, i) in traceData.review_executions" :key="'rev-'+i">
                              <details class="dc-step-expandable">
                                <summary class="dc-step-item" style="cursor:pointer; list-style:none;">
                                  <div class="dc-step-icon">
                                  <div class="dc-step-info" style="flex:1;">
                                    <span class="fw-semibold" style="color:#c9d1d9;" x-text="exec.name">
                                    <span style="color:#6e7681; font-size:.72rem;" x-text="' · tentativa ' + exec.attempt">
                                    <span x-show="exec.metadata?.count !== undefined" class="dc-badge-result" x-text="exec.metadata.count + ' chars'">
                                    <span x-show="exec.duration_ms" style="color:#484f58; font-size:.65rem;" x-text="exec.duration_ms + 'ms'">
                                    <span class="dc-step-chevron">
                                <div class="dc-step-expand-body">
                                  <div style="font-size:.65rem; color:#484f58; font-family:monospace; margin-bottom:6px;" x-text="'Tipo: ' + exec.type">
                                  <template x-if="exec.description">
                                    <div style="font-size:.7rem; color:#8b949e; margin-bottom:6px;" x-text="exec.description">
                                  <template x-if="!exec.approved && exec.feedback">
                                    <div class="dc-step-detail-item" style="border-left:2px solid #d29922; padding-left:8px; color:#d29922;">
                                      <strong>
                                        "Feedback ao orquestrador:"
                                      <div style="margin-top:3px; color:#c9d1d9; font-size:.75rem; white-space:pre-wrap;" x-text="exec.feedback">
                                  <template x-if="exec.metadata && Object.keys(exec.metadata).length > 0">
                                    <div class="dc-json-tree mt-2" x-html="renderJsonTree(exec.metadata, 0, true)">
                      <template x-if="traceData.rounds && traceData.rounds.length > 0">
                        <div>
                          <div class="dc-rounds-summary">
                            <div class="dc-rounds-summary-row">
                              <div class="dc-rounds-stat">
                                <span class="dc-rounds-stat-num" x-text="traceData.rounds.length">
                                <span class="dc-rounds-stat-label">
                                  "rounds"
                              <div class="dc-rounds-stat">
                                <span class="dc-rounds-stat-num" x-text="traceData.rounds.reduce((s,r) => s + (r.tool_calls?.length||0), 0)">
                                <span class="dc-rounds-stat-label">
                                  "tools"
                              <div class="dc-rounds-stat" x-show="traceData.rounds.some(r => r.tool_calls?.some(t => t.is_error))">
                                <span class="dc-rounds-stat-num" style="color:#f85149;" x-text="traceData.rounds.reduce((s,r) => s + (r.tool_calls?.filter(t => t.is_error)?.length||0), 0)">
                                <span class="dc-rounds-stat-label" style="color:#f85149;">
                                  "erros"
                              <div class="dc-rounds-stat">
                                <span class="dc-rounds-stat-num" style="color:#3fb950;" x-text="formatTraceDuration(traceData.duration_ms)">
                                <span class="dc-rounds-stat-label">
                                  "total"
                              <div class="dc-rounds-stat" x-show="traceData.rounds.some(r => r.parallel)">
                                <span class="dc-rounds-stat-num" style="color:#a371f7;">
                                  "⚔"
                                <span class="dc-rounds-stat-label">
                                  "paralelo"
                          <div class="dc-timeline">
                            <template x-for="(round, ri) in traceData.rounds" :key="'r-'+ri">
                              <div>
                                <template x-if="round.thinking_ms && round.thinking_ms > 500">
                                  <div class="dc-thinking-pill">
                                    <span x-text="'LLM pensando ' + formatTraceDuration(round.thinking_ms)">
                                <div class="dc-timeline-round">
                                  <div class="dc-timeline-node">
                                    <div class="dc-timeline-dot" :class="{
                                                'dot-tools': round.has_tool_calls && !round.tool_calls?.some(t => t.is_error),
                                                'dot-error': round.has_tool_calls && round.tool_calls?.some(t => t.is_error),
                                                'dot-final': !round.has_tool_calls
                                            }">
                                    <div class="dc-timeline-line" x-show="ri < traceData.rounds.length - 1">
                                  <div class="dc-timeline-content">
                                    <details class="dc-trace-section" :open="traceData.rounds.length <= 5">
                                      <summary class="dc-trace-summary">
                                        <span class="d-flex align-items-center gap-2 flex-wrap" style="width:100%;">
                                          <span class="fw-semibold" x-text="'Round ' + round.round">
                                          <template x-if="round.model">
                                            <span class="badge" style="background:#1f3a6e; color:#60a5fa; border:1px solid #2d4f8e; font-weight:400; font-size:.6" x-text="round.model">
                                          <template x-if="round.has_tool_calls">
                                            <span class="badge" :style="round.parallel
                                                                ? 'background:#2d1b69; color:#a371f7; border:1px solid #3d2b7a'
                                                                : 'background:#1f3a6e; color:#60a5fa; border:1px solid #2d4f8e'" style="font-weight:400; font-size:.65rem;" x-text="round.tool_calls.length + (round.parallel ? ' tools em paralelo' : ' tool' + (round.tool_calls.length > 1 ? 's' : ''))">
                                          <template x-if="!round.has_tool_calls">
                                            <span class="badge" style="background:#1a3524; color:#3fb950; border:1px solid #245830; font-weight:400; font-size:.6">
                                              "resposta final"
                                          <template x-if="round.tool_calls?.some(t => t.is_error)">
                                            <span class="badge" style="background:#490202; color:#f85149; border:1px solid #6e1b1b; font-weight:400; font-size:.6" x-text="round.tool_calls.filter(t => t.is_error).length + ' erro' + (round.tool_calls.filter(t => t.is_error).length > 1 ? 's' : '')">
                                          <template x-if="round.usage">
                                            <span class="badge ms-auto" style="background:#3d1f00; color:#d29922; border:1px solid #5c3a0a; font-weight:400; font-size:.6" x-text="'in: ' + (round.usage.prompt_tokens||0).toLocaleString() + ' · out: ' + (round.usage.completion_tokens||0).toLocaleString()">
                                      <div style="margin-top:6px;">
                                        <template x-if="round.tool_calls && round.tool_calls.length > 0">
                                          <div class="d-flex flex-column gap-1">
                                            <template x-for="(tool, ti) in round.tool_calls" :key="'rt-'+ri+'-'+ti">
                                              <details class="dc-trace-section" style="margin-left:0;" :class="tool.is_error ? 'dc-tool-error' : ''" x-on:toggle="if($el.open && tool.has_detail && !tool._loaded) { loadToolDetail($el, ri, ti) }">
                                                <summary class="dc-trace-summary" style="padding:5px 8px;">
                                                  <span class="d-flex align-items-center gap-2" style="width:100%;">
                                                    <template x-if="tool.is_error">
                                                    <template x-if="!tool.is_error">
                                                    <span class="fw-semibold" :style="tool.is_error ? 'color:#f85149' : ''" x-text="toolNameLabel(tool.name)">
                                                    <template x-if="tool.sub_steps_count">
                                                      <span class="badge" style="background:#161b22; color:#8b949e; border:1px solid #21262d; font-weight:400; font-size:.5" x-text="tool.sub_steps_count + ' steps'">
                                                    <span class="badge ms-auto" :style="tool.is_error
                                                                                ? 'background:#490202; color:#f85149; border:1px solid #6e1b1b; font-weight:400; font-size:.6rem;'
                                                                                : 'background:#1a3524; color:#3fb950; border:1px solid #245830; font-weight:400; font-size:.6rem;'" x-text="formatTraceDuration(tool.duration_ms)">
                                                <div class="dc-trace-content dc-tool-detail" style="min-height:40px;">
                                                  <div class="dc-tool-loading" style="color:#8b949e; font-size:.72rem; padding:8px;">
                                                    "Carregando detalhes..."
                                        <template x-if="!round.has_tool_calls && round.assistant_content">
                                          <div>
                                            <div style="color:#c9d1d9; font-size:.75rem; background:#0d1117; border:1px solid #1a3524; border-radi" x-text="round.assistant_content?.substring(0, 500) + (round.assistant_content?.length > 500 ? '...' : '')">
                      <template x-if="(!traceData.rounds || traceData.rounds.length === 0) && traceData.tool_traces && traceData.tool_traces.length > 0">
                        <div>
                          <div class="d-flex align-items-center gap-2 mb-2 mt-3" style="color:#8b949e; font-size:.85rem;">
                            <span>
                              "Tool Calls"
                            <span class="dc-badge-muted" x-text="traceData.tool_traces.length">
                          <template x-for="(tool, i) in traceData.tool_traces" :key="i">
                            <details class="dc-trace-section">
                              <summary class="dc-trace-summary">
                                <span class="d-flex align-items-center gap-2">
                                  <span class="fw-semibold" x-text="tool.name">
                                  <span class="badge ms-auto" style="background:#1a3524; color:#3fb950; border:1px solid #245830; font-weight:400; font-size:.7" x-text="formatTraceDuration(tool.duration_ms)">
                              <div class="dc-trace-content">
                                <div class="mb-2">
                                  <div style="color:#8b949e; font-size:.75rem; margin-bottom:4px;">
                                    "Arguments"
                                  <div class="dc-json-tree" x-html="renderJsonTree(tool.arguments, 0, true)">
                                <div x-show="tool.result_preview">
                                  <div style="color:#8b949e; font-size:.75rem; margin-bottom:4px;">
                                    "Result"
                                  <div class="dc-json-tree" style="max-height:500px; overflow-y:auto;" x-html="renderJsonTree(tryParseJson(tool.result_preview), 0, true)">
              <template x-if="cleanScriptVisible">
                <div>
                  <div class="dc-overlay active" @click="!cleanScriptLoading && closeCleanScript()">
                  <div class="dc-clean-script-modal">
                    <div class="dc-trace-header">
                      <span class="fw-semibold" style="color:#e6edf3; font-size:.95rem;">
                        "Roteiro limpo"
                      <button class="dc-trace-close" @click="closeCleanScript()" :disabled="cleanScriptLoading">
                    <div class="dc-clean-script-loading" x-show="cleanScriptLoading">
                      <div class="dc-csl-wand">
                      <p class="dc-csl-label">
                        "Limpando roteiro com IA"
                        <span class="dc-csl-dots">
                          <span>
                            "."
                          <span>
                            "."
                          <span>
                            "."
                      <p class="dc-csl-sub">
                        "Removendo formatação, metadados e estrutura markdown"
                    <template x-if="!cleanScriptLoading">
                      <div style="display:contents">
                        <textarea class="dc-clean-script-textarea" x-effect="if (!cleanScriptLoading && cleanScriptText) { $el.value = cleanScriptText }" @input="cleanScriptText = $el.value">
                        <div class="dc-clean-script-footer">
                          <button class="dc-clean-script-force-btn" @click="cleanScriptText = ''; cleanScriptCopied = false; cleanScriptLoading = true; $wire.forceCleanScript()" title="Use se o roteiro acima saiu errado ou incompleto">
                            "Saiu errado? Limpar com IA"
                          <button class="dc-clean-script-copy-btn" :class="{ 'dc-clean-script-copied': cleanScriptCopied }" @click="copyCleanScriptText()">
                            <span x-text="cleanScriptCopied ? 'Copiado!' : 'Copiar'">
              <template x-if="cloneConfirmVisible">
                <div>
                  <div class="dc-overlay active" @click="!cloneConfirmLoading && closeCloneConfirm()">
                  <div class="dc-clone-picker-modal" :class="{ 'is-wide': cloneConfirmStep === 'script' && !rechargeVisible }">
                    <div class="dc-trace-header">
                      <span class="fw-semibold" style="color:#e6edf3; font-size:.95rem;" x-text="rechargeVisible ? 'Gerar vídeo com o Twin?' : (cloneConfirmStep === 'script' ? 'Revise o roteiro' : 'Gerar vídeo com o Twin?')">
                      <button class="dc-trace-close" @click="closeCloneConfirm()" :disabled="cloneConfirmLoading">
                    <div class="dc-clone-confirm-body" x-show="!rechargeVisible && cloneConfirmStep === 'script'">
                      <template x-if="cloneConfirmScriptLoading">
                        <div class="dc-clone-script-loading">
                          <span class="spinner-border spinner-border-sm" role="status">
                          <p>
                            "Preparando o roteiro com IA..."
                      <template x-if="!cloneConfirmScriptLoading">
                        <div class="dc-clone-script-editor">
                          <p>
                            "Esse é o texto que o Twin vai falar. Ajuste o que quiser antes de continuar."
                          <textarea class="form-control dc-clone-script-textarea" x-model="cloneConfirmScript" x-init="$nextTick(() => autosizeCloneScript($el))" @input="autosizeCloneScript($el)" placeholder="Texto que o Twin vai narrar...">
                          <div class="dc-clone-script-count" x-text="cloneConfirmScript.trim().length + ' caracteres'">
                    <div class="dc-clone-confirm-body" x-show="!rechargeVisible && cloneConfirmStep === 'avatar'" x-cloak>
                      <img class="dc-clone-picker-thumb dc-clone-confirm-thumb" :src="selectedCloneProfile()?.thumbnail_url || ''" x-on:error="$el.style.visibility='hidden'">
                      <p>
                        "O roteiro revisado vai virar um vídeo com o Twin abaixo. Pode trocar antes de gerar."
                      <select class="form-select dc-clone-confirm-select" x-model.number="cloneConfirmSelectedId" :disabled="cloneConfirmLoading">
                        <template x-for="profile in cloneConfirmProfiles" :key="profile.id">
                          <option :value="profile.id" x-text="profile.name">
                    <div class="dc-clone-confirm-body" x-show="rechargeVisible" x-cloak>
                      <p x-show="rechargeLoading && !rechargePackages.length">
                        "Carregando pacotes de crédito..."
                      <template x-if="!rechargeLoading && !rechargeHasCard">
                        <div style="text-align:center;">
                          <p>
                            "Você ainda não tem um cartão cadastrado."
                          <button type="button" class="dc-clean-script-copy-btn" @click="goToFaturamento()">
                            "Ir para Faturamento"
                      <template x-if="!rechargeLoading && rechargeHasCard && rechargePackages.length">
                        <div>
                          <p>
                            "Saldo insuficiente pra gerar esse vídeo. Escolha um pacote e recarregue agora:"
                          <div class="dc-recharge-packages">
                            <template x-for="pkg in rechargePackages" :key="pkg.id">
                              <div class="dc-recharge-package" :class="{ 'is-selected': rechargeSelectedId === pkg.id }" @click="selectRechargePackage(pkg.id)">
                                <div class="credits-amount" x-text="pkg.credits">
                                <div class="credits-label">
                                  "créditos"
                                <div class="price" x-text="'R$ ' + (pkg.price_cents / 100).toFixed(2).replace('.', ',')">
                    <div class="dc-clean-script-footer" x-show="!rechargeVisible">
                      <button type="button" class="dc-clean-script-force-btn" @click="cloneConfirmStep === 'avatar' ? backToCloneScriptStep() : closeCloneConfirm()" :disabled="cloneConfirmLoading" x-text="cloneConfirmStep === 'avatar' ? 'Voltar' : 'Cancelar'">
                      <button type="button" class="dc-clean-script-copy-btn" x-show="cloneConfirmStep === 'script'" @click="goToCloneAvatarStep()" :disabled="cloneConfirmScriptLoading || !cloneConfirmScript.trim()">
                        "Continuar"
                      <button type="button" class="dc-clean-script-copy-btn" x-show="cloneConfirmStep === 'avatar'" x-cloak @click="confirmRecordClone()" :disabled="cloneConfirmLoading">
                        <span x-text="cloneConfirmLoading ? 'Gerando...' : 'Gerar vídeo'">
                    <div class="dc-clean-script-footer" x-show="rechargeVisible" x-cloak>
                      <button type="button" class="dc-clean-script-force-btn" @click="closeCloneConfirm()" :disabled="rechargeLoading">
                        "Cancelar"
                      <button type="button" class="dc-clean-script-copy-btn" x-show="rechargeHasCard" @click="confirmRecharge()" :disabled="rechargeLoading || !rechargeSelectedId">
                        <span x-text="rechargeLoading ? 'Recarregando...' : 'Recarregar agora'">
              <script https://cdn.jsdelivr.net/npm/marked/marked.min.js>
              <script inline>
              <script https://cdn.jsdelivr.net/npm/marked/marked.min.js>
