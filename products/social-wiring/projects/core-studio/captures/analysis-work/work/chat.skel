                        <button @click="mentionOpen = false" style="background:none;border:none;color:#8b949e;cursor:pointer;padding:4px;">
                      <div class="dc-mention-tabs">
                        <button class="dc-mention-tab" :class="{ 'active': mentionActiveTab === 'references' }" @click="switchMentionTab('references')" type="button">
