    <div class="modal fade" id="modal-first-access-tutorial" aria-labelledby="modalFirstAccessLabel" data-bs-backdrop="static">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content" style="background: #0D0C12; border: 1px solid rgba(225, 200, 255, 0.15); border-radius: 20px; ove">
          <div style="height: 4px; background: linear-gradient(90deg, #9945FF, #6e2fe0);">
          <div class="modal-body p-4 p-md-5">
            <div class="text-center mb-4">
              <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 6">
            <h2 class="text-white text-center mb-3" style="font-size: 1.4rem; font-weight: 700; line-height: 1.3;">
              "Bem-vindo ao Core Studio!"
