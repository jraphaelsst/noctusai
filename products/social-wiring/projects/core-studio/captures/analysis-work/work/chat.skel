            <div class="d-flex flex-column gap-2">
              <a id="btn-first-access-trainings" href="https://corestudio.ai/dashboard/user/trainings" class="btn w-100" style="background: #9945FF; color: #fff; border: none; border-radius: 50px; padding: 12px 24px; f">
                "Assistir aos treinamentos agora"
              <button type="button" id="btn-first-access-skip" data-bs-dismiss="modal" class="btn w-100" style="background: transparent; color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,">
                "Pular por agora"
