                  <button class="dc-send-btn" @click="askViaSSE()" :disabled="streaming || !$wire.get('selectedAgentId')">
                    <span x-show="streaming" class="spinner-border spinner-border-sm" role="status">
                  <div class="dc-streaming-bar" x-show="streaming" x-transition.opacity>
                <template x-teleport="body">
                  <div x-show="mentionOpen" x-transition.opacity class="dc-mention-overlay" @click="mentionOpen = false">
