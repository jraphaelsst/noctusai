                            <div x-show="stepsOpen" x-transition class="dc-steps-body">
                              <template x-for="(step, i) in steps" :key="i">
                                <div class="dc-step-item">
                                  <div class="dc-step-icon">
                                    <span x-show="step.status === 'start'" class="spinner-border spinner-border-sm" style="width:.6rem;height:.6rem;border-width:1.5px;color:#d29922;">
                                  <div class="dc-step-info">
                                    <span class="fw-semibold" style="color:#c9d1d9;" x-text="step.label">
                                    <span x-show="step.kind === 'review' && step.data?.reviewer_description" style="color:#6e7681;" x-text="' — ' + step.data?.reviewer_description">
                                    <span x-show="step.data?.query" style="color:#6e7681;" x-text="': ' + step.data?.query">
                                    <template x-if="step.status === 'done' && (step.data?.count !== undefined || step.data?.approved !== undefined) && step.kind !== 'review'">
                                      <span class="dc-badge-result" x-text="(step.data.approved !== undefined ? step.data.approved + ' aprovados' : step.data.count + ' resultados')">
                                    <template x-if="(step.status === 'rejected' || step.status === 'warn') && step.data?.feedback">
                                      <div style="color:#d29922; font-size:.7rem; margin-top:3px; line-height:1.45;" x-text="step.data.feedback">
                                    <template x-if="step.kind === 'review_retry' && step.data?.reason">
                                      <div style="color:#8b949e; font-size:.7rem; margin-top:3px; line-height:1.45;" x-text="step.data.reason">
                                    <template x-if="step.status === 'done' && step.data?.sources?.length">
                                      <div class="mt-1 d-flex flex-wrap gap-1">
                                        <template x-for="src in step.data.sources" :key="src">
                                          <span class="dc-badge-source" x-text="src">
                                    <template x-if="step.status === 'done' && step.data?.items?.length">
                                      <details class="mt-1" style="font-size:.75rem;">
                                        <summary style="cursor:pointer; color:#58a6ff; user-select:none;">
                                          "Ver"
                                          <span x-text="step.data.items.length">
                                          "itens selecionados"
