# P Studio — frontend (copie para .env)
# Definição das vars: seed/lib/frontend/src/env.ts (fonte única).
# Os valores abaixo são os de DEV NATIVO; as portas vêm do registry
# `PRODUCTS` em start.sh (`p-studio:P Studio:8014:8180`), que é a única
# fonte de verdade para porta de produto.

# Supabase da plataforma NoctusAI. A chave é publicável: quem manda é a RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend FastAPI do P Studio. Todo dado passa por aqui — o SPA nunca
# consulta o Postgres direto (foi o que o protótipo fazia).
VITE_BACKEND_API_URL=http://localhost:8014

# Frontend do core (redirect de SSO, navegação entre produtos).
VITE_CORE_URL=http://localhost:5173

# Backend do core (troca de token no SSO). SEM esta var o `SSOCallback` do
# seed cai no default `http://localhost:8000` e o login falha com "Failed to
# fetch" fora da máquina de dev — o motivo de ela estar aqui explicitamente
# em vez de "quem precisa que descubra".
VITE_CORE_API_URL=http://localhost:8000
