# knowledge-extractor — environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored; this template is the contract, not the data.
# (Mirrors noc's .env.example convention — see ../noctusai/.env.example)

# ─── OpenAI (transcription + summarization) ──────────────────────────
# Required. Used by app/integrations/llm/*. Without it, only `--fake`
# runs (everything else surfaces a clear "OPENAI_API_KEY missing" error).
OPENAI_API_KEY=

# Transcription model. Default is OpenAI's current speech-to-text model.
# Fallback if your account lacks access: whisper-1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Summarization (chat) model.
SUMMARY_MODEL=gpt-4o

# Source language hint for transcription (ISO-639-1). The course is pt-BR.
TRANSCRIBE_LANGUAGE=pt

# ─── Google Drive ────────────────────────────────────────────────────
# Backend: auto | oauth | api | gdown
#   auto  → OAuth if configured, else API key, else gdown (default)
#   oauth → Drive v3 as YOU (required for folders shared privately with you,
#           e.g. a course folder from someone else's Drive shared to your email)
#   api   → Drive v3 via API key (only reaches "anyone-with-link" public files)
#   gdown → public-link download (no key)
DRIVE_BACKEND=auto

# API key — only works for "anyone with the link" files. A folder shared
# specifically with your account returns 404 to an API key; use oauth instead.
GOOGLE_API_KEY=

# OAuth (for private / third-party shares — REQUIRED for a folder shared to your
# email). Reuse noc's working Google OAuth client (same account): copy these from
# ../noctusai/.env. First run opens a browser for one-time consent; the token is
# cached at GOOGLE_OAUTH_TOKEN_FILE and refreshed automatically afterward.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8140/oauth/google/callback
GOOGLE_OAUTH_TOKEN_FILE=secrets/drive_token.json

# Alternative to the client_id/secret above: a downloaded "Desktop app" JSON.
# (Used only if GOOGLE_OAUTH_CLIENT_ID/SECRET are unset.)
GOOGLE_OAUTH_CLIENT_SECRET_FILE=secrets/client_secret.json

# ─── Pipeline tuning ─────────────────────────────────────────────────
# Audio is split into chunks of this many seconds before transcription
# (OpenAI's 25MB/upload limit). 600 = 10 min chunks.
CHUNK_SECONDS=600

# Where downloads / audio / transcripts / summaries are written
# (relative to the repo root).
DATA_DIR=data
