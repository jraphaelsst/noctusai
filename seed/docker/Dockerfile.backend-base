# syntax=docker/dockerfile:1.7
# noctus-seed-backend-base — the SHARED backend spine image.
#
# Project: containerization-single-container. This is the Docker-native
# analog of `create_product_app()`: every product's backend image does
# `FROM noctus-seed-backend-base` and adds ONLY its own specificities
# (product deps, product code, port, extras). The common heavy layers —
# system deps, the venv, the seed editable installs, the runtime libs,
# the non-root convention — live HERE, in ONE place, changed ONCE.
#
# `FROM noctus-seed-backend-base` IS the named seam (inherit-and-extend,
# never fork — same rule as the seed factory).
#
# Build context: repo root. Build via scripts/infra/build-base-images.sh
# (start.sh orders it before product images; the layer is cached once
# instead of rebuilt per product).
#
# Ships a RUNTIME-shaped image (no build-essential / *-dev headers / git)
# carrying: /opt/venv (seed lib + framework editable-installed) + /app/seed
# (the source tree the egg-links point at) + runtime shared objects + curl.

ARG GIT_SHA=dev

# ── builder: compile wheels + seed editable installs into /opt/venv ──────
FROM python:3.11-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential libffi-dev libpq-dev git pkg-config \
        libcairo2-dev libgirepository1.0-dev libpango1.0-dev \
        libgdk-pixbuf-2.0-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" VIRTUAL_ENV="/opt/venv"
WORKDIR /app
# Seed packages — the common spine. Product deps are added later by the
# product image (FROM this base) so this layer caches across all products.
COPY seed/lib/backend ./seed/lib/backend
COPY seed/framework/backend ./seed/framework/backend
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e ./seed/lib/backend -e ./seed/framework/backend

# ── runtime: prebuilt venv + minimal shared objects ─────────────────────
FROM python:3.11-slim AS runtime
ARG GIT_SHA
LABEL org.opencontainers.image.source="https://github.com/jraphaelsst/noctusai" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.title="noctus-seed-backend-base"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV="/opt/venv" \
    GIT_SHA="${GIT_SHA}"
# ↑ GIT_SHA promoted ARG→ENV so it's readable at RUNTIME (the /_version
#   deploy-provenance endpoint reads os.environ["GIT_SHA"]). Without this it's
#   build-only (label) and build_sha reports None.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libffi8 libpq5 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 libgirepository-1.0-1 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Editable installs egg-link to /app/seed — keep the source tree present.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/seed /app/seed
# NOTE: no USER here — product images add their deps (pip), product code,
# then create the non-root user + chown as their LAST layers (so the venv
# stays writable for the product's `pip install`).
