{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "vite/client"],
    "paths": {
      "@noctusai/seed/infra": ["../../framework/frontend/src/infra.tsx"],
      "@noctusai/lib": ["./src/index.ts"],
      "@noctusai/lib/*": ["./src/*.ts", "./src/*/index.ts", "./src/*.tsx"]
    }
  },
  "include": ["src"]
}
